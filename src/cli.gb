module gebweb.cli;

/**
 * Standard server entrypoint for Gebweb applications. `cli.serve(app)`
 * gives every app (run via the interpreter or as a built binary) the
 * same operational surface: port flags, TLS on/off, LetsEncrypt
 * autocert, a self-signed mode for local HTTPS, an informative
 * "listening on ... Ctrl+C to stop" banner, and graceful SIGINT /
 * SIGTERM handling.
 *
 * Precedence: command-line flags > environment variables > `opts`
 * defaults. Values may be given as `--port 8082` or `--port=8082`. Flags:
 *
 *   --port N          plain-HTTP port           (GEBWEB_PORT, or GEBWEB_HTTP_PORT)
 *   --tls-port N      TLS port                  (GEBWEB_TLS_PORT)
 *   --host ADDR       bind address              (GEBWEB_HOST)
 *   --domain HOST     LetsEncrypt autocert host (GEBWEB_DOMAIN)
 *   --self-signed     local HTTPS, generated cert (GEBWEB_SELF_SIGNED=1)
 *   --no-tls          force plain HTTP          (GEBWEB_NO_TLS=1)
 *   --acme-email A    ACME contact              (GEBWEB_ACME_EMAIL)
 *   --acme-cache DIR  certificate cache dir     (GEBWEB_ACME_CACHE)
 *   --trusted-proxies LIST  comma-separated proxy IPs/CIDRs whose
 *                     X-Forwarded-* headers are honoured (GEBWEB_TRUSTED_PROXIES)
 *   --help            print this option list and exit
 *   --version         print the application, runtime and package versions
 *   --dev             development mode          (GEBWEB_ENV=dev or development)
 *
 * `opts["server"]` is a dict of `http.listen` options (trustedProxies,
 * maxConns, maxBodyBytes, ...) applied to every listener cli starts;
 * the trusted-proxies flag/env replaces its trustedProxies entry.
 */

import async;
import io;
import sys;
import http;
import gebweb.app as appmod;
import gebweb.config as configmod;

func envOr(string name, string fallback): string {
    let v = sys.getenv(name);
    if (v == null || (v as string).isEmpty()) {
        return fallback;
    }
    return v as string;
}

func envFlag(string name): bool {
    let v = envOr(name, "");
    return v == "1" || v.lower() == "true" || v.lower() == "yes";
}

func optString(dict<string, any> opts, string key, string fallback): string {
    if (opts.contains(key)) {
        let v = opts[key];
        if (v instanceof int) { return (v as int) as string; }
        return v as string;
    }
    return fallback;
}

/**
 * Resolves the effective server configuration from flags, environment,
 * and option defaults. Pure given its inputs, so it is directly
 * testable. Returns: {help, version, dev, host, httpPort, tlsPort, domain,
 * selfSigned, noTls, acmeEmail, acmeCache, httpMode, certOut, server, errors}.
 */
export func resolveConfig(list<string> args, dict<string, any> opts): dict<string, any> {
    dict<string, any> cfg = {
        "help": false,
        "version": false,
        "dev": configmod.isDevEnv(),
        "host": envOr("GEBWEB_HOST", optString(opts, "host", "")),
        "httpPort": envOr("GEBWEB_PORT", envOr("GEBWEB_HTTP_PORT", optString(opts, "port", "8080"))),
        "tlsPort": envOr("GEBWEB_TLS_PORT", optString(opts, "tlsPort", "443")),
        "domain": envOr("GEBWEB_DOMAIN", optString(opts, "domain", "")),
        "selfSigned": envFlag("GEBWEB_SELF_SIGNED") || (opts.contains("selfSigned") && (opts["selfSigned"] as bool)),
        "noTls": envFlag("GEBWEB_NO_TLS") || (opts.contains("noTls") && (opts["noTls"] as bool)),
        "acmeEmail": envOr("GEBWEB_ACME_EMAIL", optString(opts, "acmeEmail", "")),
        "acmeCache": envOr("GEBWEB_ACME_CACHE", optString(opts, "acmeCache", "")),
        "httpMode": envOr("GEBWEB_HTTP", optString(opts, "http", "")),
        "certOut": envOr("GEBWEB_CERT_OUT", optString(opts, "certOut", "")),
        "server": {},
        "errors": [],
    };
    let problems = cfg["errors"] as list<any>;
    dict<string, any> server = {};
    if (opts.contains("server")) {
        if (opts["server"] instanceof dict) {
            for (k, v in opts["server"] as dict<string, any>) {
                server[k as string] = v;
            }
        } else {
            problems.push("opts.server must be a dict of http.listen options");
        }
    }
    string proxies = envOr("GEBWEB_TRUSTED_PROXIES", "");
    int i = 0;
    while (i < args.length()) {
        string arg = args[i];
        ?string inline = null;
        let eq = arg.indexOf("=");
        if (arg.startsWith("--") && eq > 2) {
            inline = arg.slice(eq + 1, arg.length());
            arg = arg.slice(0, eq);
        }
        bool wantsValue = arg == "--port" || arg == "--tls-port" || arg == "--host"
            || arg == "--domain" || arg == "--acme-email" || arg == "--acme-cache"
            || arg == "--http" || arg == "--cert-out" || arg == "--trusted-proxies";
        string value = "";
        if (inline != null) {
            if (!wantsValue) {
                problems.push(arg + " does not take a value");
                break;
            }
            value = inline as string;
            i += 1;
        } else if (wantsValue) {
            if (i + 1 >= args.length()) {
                problems.push("missing value for " + arg);
                break;
            }
            value = args[i + 1];
            i += 2;
        } else {
            i += 1;
        }
        if (arg == "--port")            { cfg["httpPort"] = value; }
        else if (arg == "--tls-port")   { cfg["tlsPort"] = value; }
        else if (arg == "--host")       { cfg["host"] = value; }
        else if (arg == "--domain")     { cfg["domain"] = value; }
        else if (arg == "--acme-email") { cfg["acmeEmail"] = value; }
        else if (arg == "--acme-cache") { cfg["acmeCache"] = value; }
        else if (arg == "--http")       { cfg["httpMode"] = value; }
        else if (arg == "--cert-out")   { cfg["certOut"] = value; }
        else if (arg == "--trusted-proxies") { proxies = value; }
        else if (arg == "--self-signed") { cfg["selfSigned"] = true; }
        else if (arg == "--no-tls")      { cfg["noTls"] = true; }
        else if (arg == "--help" || arg == "-h") { cfg["help"] = true; }
        else if (arg == "--version")     { cfg["version"] = true; }
        else if (arg == "--dev")         { cfg["dev"] = true; }
        else { problems.push("unknown option " + arg); }
    }
    string mode = cfg["httpMode"] as string;
    if (mode != "" && mode != "off" && mode != "redirect" && mode != "serve") {
        problems.push("--http must be off, redirect, or serve (got " + mode + ")");
    }
    if (!proxies.isEmpty()) {
        list<string> trusted = [];
        for (p in proxies.split(",")) {
            if (!p.trim().isEmpty()) {
                trusted.push(p.trim());
            }
        }
        server["trustedProxies"] = trusted;
    }
    cfg["server"] = server;
    return cfg;
}

/* The listener options for one listener: the configured server options plus `extra` (e.g. tls). */
func listenOpts(dict<string, any> cfg, dict<string, any> extra = {}): dict<string, any> {
    dict<string, any> out = {};
    for (k, v in cfg["server"] as dict<string, any>) {
        out[k as string] = v;
    }
    for (k, v in extra) {
        out[k as string] = v;
    }
    return out;
}

/**
 * The 301 response a plain-HTTP sidecar listener answers when TLS is
 * active. `domain` pins the target host (autocert); otherwise the
 * request's own Host header is reused with the TLS port.
 */
export func redirectResponse(dict<string, any> request, string domain, string tlsPort): dict<string, any> {
    string host = domain;
    if (host == "") {
        host = (request["host"] ?? "localhost") as string;
        if (host.startsWith("[")) {
            int closing = host.indexOf("]");
            if (closing >= 0) {
                host = host.substring(0, closing + 1);
            }
        } else {
            int colon = host.lastIndexOf(":");
            if (colon >= 0) {
                host = host.substring(0, colon);
            }
        }
    }
    string target = "https://" + host;
    if (tlsPort != "443") {
        target = target + ":" + tlsPort;
    }
    target = target + ((request["path"] ?? "/") as string);
    string query = (request["query"] ?? "") as string;
    if (!query.isEmpty()) {
        target = target + "?" + query;
    }
    return {"status": 301, "headers": {"Location": target}, "body": ""};
}

/**
 * Write the listener's certificate PEM (self-signed servers generate
 * one at startup) to `path` so it can be added to a local trust
 * store. Returns false when the server has no exportable certificate.
 */
export func writeCertFile(int handle, string path): bool {
    let pemValue = http.serverCert(handle);
    if (pemValue == null || (pemValue as string).isEmpty()) {
        return false;
    }
    io.writeText(path, pemValue as string);
    return true;
}

/* Start the plain-HTTP sidecar next to a TLS listener and track it
 * for graceful drain. */
func startHttpSidecar(appmod.GebwebApp app, dict<string, any> cfg, string mode, string host, string httpPort, string tlsPort, string domain): string {
    if (mode == "redirect") {
        int handle = http.listen(host + ":" + httpPort, func(dict<string, any> request): dict<string, any> {
            return redirectResponse(request, domain, tlsPort);
        }, listenOpts(cfg));
        appmod.trackServerHandle(app, handle);
        return "HTTP redirect on :" + httpPort;
    }
    if (mode == "serve") {
        appmod.listen(app, host + ":" + httpPort, listenOpts(cfg));
        return "HTTP on :" + httpPort;
    }
    return "";
}

export func helpText(string appName): string {
    return appName + " server options (flags > env > defaults):\n" +
        "  --port N          plain-HTTP port           (GEBWEB_PORT, or GEBWEB_HTTP_PORT)\n" +
        "  --tls-port N      TLS port                  (GEBWEB_TLS_PORT)\n" +
        "  --host ADDR       bind address              (GEBWEB_HOST)\n" +
        "  --domain HOST     LetsEncrypt autocert host (GEBWEB_DOMAIN)\n" +
        "  --self-signed     local HTTPS with a generated certificate\n" +
        "  --no-tls          force plain HTTP even when TLS is configured\n" +
        "  --acme-email A    ACME contact address      (GEBWEB_ACME_EMAIL)\n" +
        "  --acme-cache DIR  certificate cache dir     (GEBWEB_ACME_CACHE)\n" +
        "  --http MODE       plain-HTTP port when TLS is active:\n" +
        "                    off | redirect | serve    (GEBWEB_HTTP)\n" +
        "  --cert-out FILE   write the server certificate PEM to FILE\n" +
        "                    (self-signed: add it to your trust store)\n" +
        "  --trusted-proxies LIST  comma-separated proxy IPs/CIDRs whose\n" +
        "                    X-Forwarded-* headers are trusted (GEBWEB_TRUSTED_PROXIES)\n" +
        "  --dev             development mode          (GEBWEB_ENV=dev)\n" +
        "  --version         show the application, runtime and package versions\n" +
        "  --help            show these options\n" +
        "\nBuilt binaries also answer --geblang-version and --geblang-notices as the first argument.\n";
}

/* Same layout as a built binary's --geblang-version. */
export func versionText(string appName): string {
    let info = sys.appInfo();
    string name = (info["name"] as string).isEmpty() ? appName : info["name"] as string;
    string out = (name + " " + (info["version"] as string)).trim() + "\n  geblang " + (info["runtime"] as string) + "\n";
    for (p in info["packages"] as list<any>) {
        let pkg = p as dict<string, any>;
        out = out + "  " + ((pkg["name"] as string) + " " + (pkg["version"] as string)).trim() + "\n";
    }
    return out;
}

/**
 * Resolves the configuration from `args`, answering --help and --version
 * (exit 0) and reporting invalid options with the help text (exit 2).
 * Call it before setup that needs secrets or resources.
 */
export func checkArgs(list<string> args, dict<string, any> opts = {}): dict<string, any> {
    string appName = optString(opts, "name", "gebweb");
    let cfg = resolveConfig(args, opts);
    let problems = cfg["errors"] as list<any>;
    if (!problems.isEmpty()) {
        for (e in problems) {
            io.stderrPrintln(appName + ": " + (e as string));
        }
        io.stderrPrintln(helpText(appName));
        sys.exit(2);
    }
    if (cfg["help"] as bool) {
        io.println(helpText(appName));
        sys.exit(0);
    }
    /* Everything that reads the environment after this point sees dev mode. */
    if ((cfg["dev"] as bool) && !configmod.isDevEnv()) {
        sys.setenv("GEBWEB_ENV", "dev");
    }
    if (cfg["version"] as bool) {
        io.print(versionText(appName));
        sys.exit(0);
    }
    return cfg;
}

func displayHost(string host): string {
    if (host == "" || host == "0.0.0.0" || host == "::") {
        return "localhost";
    }
    return host;
}

func installShutdownSignals(appmod.GebwebApp app): void {
    let stop = func(string name): void {
        if (!app.opsStore.compareAndSet("signalShutdown", null, true)) {
            appmod.logAt(app, "warn", "received " + name + " again, exiting immediately", {"signal": name});
            sys.exit(130);
        }
        /* Handlers run one at a time, so return at once and let a second signal force the exit. */
        async.run(func(): void {
            try {
                appmod.shutdown(app, {"timeoutMs": 10000, "reason": "received " + name});
            } catch (Error error) {
                /* Nothing awaits this task, so an escaping error would vanish and leave the process waiting. */
                io.stderrPrintln("shutdown failed: " + error.message);
                app.opsStore.set("shutdownClean", false);
                app.opsStore.set("shutdownComplete", true);
            }
        });
    };
    sys.onSignal("SIGINT", stop);
    sys.onSignal("SIGTERM", stop);
}

/**
 * Serves `app` with the standard flag/env surface. `opts` provides the
 * defaults (`port`, `tlsPort`, `host`, `domain`, `selfSigned`,
 * `noTls`, `acmeEmail`, `acmeCache`, `name`, `server`) that flags and
 * environment variables override. Blocks until the server stops or a
 * termination signal arrives.
 */
export func serve(appmod.GebwebApp app, dict<string, any> opts = {}): void {
    string appName = optString(opts, "name", "gebweb");
    let cfg = checkArgs(sys.args(), opts);

    appmod.setAppName(app, appName);
    installShutdownSignals(app);
    string bannerTail = (cfg["dev"] as bool ? " (development mode)" : "") + " - Ctrl+C to stop";

    string host = cfg["host"] as string;
    string httpPort = cfg["httpPort"] as string;
    string tlsPort = cfg["tlsPort"] as string;
    string domain = cfg["domain"] as string;
    bool noTls = cfg["noTls"] as bool;
    bool selfSigned = (cfg["selfSigned"] as bool) && !noTls;
    bool autoCert = domain != "" && !noTls;
    string shown = displayHost(host);

    string httpMode = cfg["httpMode"] as string;
    if (autoCert) {
        dict<string, any> tls = {"autoCert": domain};
        if ((cfg["acmeEmail"] as string) != "") {
            tls["autoCertEmail"] = cfg["acmeEmail"];
        }
        if ((cfg["acmeCache"] as string) != "") {
            tls["autoCertCacheDir"] = cfg["acmeCache"];
        }
        string sidecar = startHttpSidecar(app, cfg, httpMode == "" ? "redirect" : httpMode, host, httpPort, tlsPort, domain);
        string extra = sidecar == "" ? "" : "; " + sidecar;
        int handle = appmod.listen(app, host + ":" + tlsPort, listenOpts(cfg, {"tls": tls}));
        appmod.logAt(app, "info", "serving https://" + domain + ":" + tlsPort + " (LetsEncrypt" + extra + ")" + bannerTail);
        waitUntilStopped(app, handle);
        return;
    }
    if (selfSigned) {
        string sidecar = startHttpSidecar(app, cfg, httpMode, host, httpPort, tlsPort, "");
        string extra = sidecar == "" ? "" : "; " + sidecar;
        int handle = appmod.listen(app, host + ":" + tlsPort, listenOpts(cfg, {"tls": {"selfSigned": true}}));
        string certOut = cfg["certOut"] as string;
        if (!certOut.isEmpty()) {
            if (writeCertFile(handle, certOut)) {
                extra = extra + "; certificate written to " + certOut;
            } else {
                appmod.logAt(app, "warn", "no certificate available to export", {});
            }
        }
        appmod.logAt(app, "info", "serving https://" + shown + ":" + tlsPort + " (self-signed certificate" + extra + ")" + bannerTail);
        waitUntilStopped(app, handle);
        return;
    }
    int handle = appmod.listen(app, host + ":" + httpPort, listenOpts(cfg));
    appmod.logAt(app, "info", "serving http://" + shown + ":" + httpPort + bannerTail);
    waitUntilStopped(app, handle);
}

/* The banner follows the bind so it never announces a server that is not yet listening. */
func waitUntilStopped(appmod.GebwebApp app, int handle): void {
    http.wait(handle);
    appmod.awaitShutdown(app);
    if (app.opsStore.get("signalShutdown") == true) {
        sys.exit((app.opsStore.get("shutdownClean") ?? true) as bool ? 0 : 1);
    }
}
