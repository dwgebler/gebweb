module gebweb.di;

/**
 * A minimal constructor-injection DI container. Services are
 * registered against a class reference (used as the lookup key);
 * resolving a class walks its constructor parameter list, recursively
 * resolves each parameter by its declared type, and caches the
 * instance for re-use.
 *
 * Quick example:
 *
 *   class DbConn { ... }
 *   class UserRepo {
 *       DbConn conn;
 *       func UserRepo(DbConn conn) { this.conn = conn; }
 *   }
 *
 *   let c = di.newContainer();
 *   di.register(c, DbConn, func(): DbConn { return DbConn(); });
 *   let repo = di.resolve(c, UserRepo) as UserRepo;
 *
 * Registration is optional for classes that have no constructor
 * parameters or whose parameters are all themselves resolvable.
 * Factory functions take no arguments and return the service value;
 * for services that need configuration, capture the config in the
 * closure at registration time.
 */

import reflect;
import sys;
import async.sync as sync;

/**
 * Container holds the bindings (factory callables) and the singleton
 * cache. The `resolving` list tracks the in-progress dependency
 * stack so cycles surface as a clear error rather than as stack
 * exhaustion.
 *
 * `factories` and `cache` are keyed by class value - class refs are
 * hashable in Geblang and equal-by-identity, so two literal `Foo`
 * references in different files all hit the same slot.
 */
export class Container {
    dict<any, callable> factories;
    dict<any, any> cache;
    /* The container is a shared singleton hit by every request goroutine
     * concurrently, so the lazily-mutated maps (singleton cache, and the
     * per-goroutine resolving stack / request-scope cache below) are guarded
     * by _lock; expensive construction always runs outside the lock. */
    sync.Mutex _lock;
    /* Cycle-detection stack and per-request cache are per-goroutine, keyed by
     * sys.goroutineId(): one goroutine handles one request, so each gets its
     * own isolated entry. Entries are cleared when the goroutine's work ends
     * (so a later goroutine reusing the id starts clean). */
    dict<int, any> resolvingByGid;
    /* Classes registered via registerPerRequest. When the goroutine is inside
     * a request scope (set up by the framework for each incoming HTTP
     * request), resolves for these classes use the goroutine's scope cache so
     * the instance is shared across the request but discarded afterwards.
     * Outside a request scope, per-request classes behave as transient. */
    dict<any, callable> perRequestFactories;
    dict<int, bool> scopeActiveByGid;
    dict<int, any> scopeCacheByGid;
    /* Interface-keyed registrations. The bytecode VM does not
     * expose an interface declaration as a first-class value, so
     * `di.registerInstance(c, llm.Client, ...)` fails to compile.
     * This map sidesteps the limitation: the key is the
     * interface's declared name (e.g. "llm.Client") and the value
     * is the instance to inject when a constructor parameter is
     * typed with that interface. */
    dict<string, any> interfaceInstances;
    /* String-keyed service registry. Populated by the @Service
     * discovery sweep and by YAML services entries. The key is
     * the service id (custom string from @Service("id") or the
     * class name); the value is the class reference. Resolving
     * by id goes through the normal autowire path. */
    dict<string, any> serviceIds;
    /* YAML services-section state, all keyed by canonical id.
     * `serviceFactories[id]` is non-empty when the YAML entry
     * supplies constructor arg overrides; resolveService runs
     * it instead of autowiring. `serviceTags[id]` collects the
     * tags: list. `serviceShared[id]` is false for transient
     * scope (default true). `serviceCache[id]` is the shared
     * instance once first resolved. */
    dict<string, callable> serviceFactories;
    dict<string, list<string>> serviceTags;
    dict<string, bool> serviceShared;
    /* Alias-id -> canonical-id mapping. resolveService follows
     * the chain; cycles throw at resolve time. */
    dict<string, string> aliases;
    /* Iface name -> service id. resolveDependency consults this
     * when a constructor param's type matches a bound interface,
     * lazily resolving the chosen service. Populated from YAML
     * bindings: entries. */
    dict<string, string> interfaceBindings;

    func Container() {
        this.factories = {};
        this.cache = {};
        this._lock = sync.Mutex();
        this.resolvingByGid = {};
        this.perRequestFactories = {};
        this.scopeActiveByGid = {};
        this.scopeCacheByGid = {};
        this.interfaceInstances = {};
        this.serviceIds = {};
        this.serviceFactories = {};
        this.serviceTags = {};
        this.serviceShared = {};
        this.aliases = {};
        this.interfaceBindings = {};
    }
}

/** Build a new empty container. */
export func newContainer(): Container {
    return Container();
}

/**
 * Returns the class's own name for use in DI error messages.
 * Falls back to the meta-type label when given a value that isn't
 * a class (defensive; shouldn't happen on this code path).
 */
func classDisplayName(any classRef): string {
    let name = reflect.className(classRef);
    if (name != null) {
        return name as string;
    }
    return reflect.typeOf(classRef) as string;
}

func stripNullable(string t): string {
    if (t.startsWith("?")) {
        return t.substring(1, t.length());
    }
    return t;
}

func popLast(list<string> xs): list<string> {
    if (xs.length() == 0) {
        return xs;
    }
    return xs.slice(0, xs.length() - 1);
}

/* Falls back to a name-based search over registered bindings when
 * reflect.class can't resolve a module-qualified type string (the
 * bytecode compiler rejects alias-prefixed names like `bcast.Hub`).
 * Matches the bare class name, after stripping any module prefix. */
func findRegisteredByTypeName(Container c, string ptype): any {
    let dot = ptype.lastIndexOf(".");
    string bareName = dot < 0 ? ptype : ptype.substring(dot + 1, ptype.length());
    for (k in diCacheKeys(c)) {
        let candidate = reflect.className(k);
        if (candidate != null && (candidate as string) == bareName) {
            return k;
        }
    }
    for (k in c.factories.keys()) {
        let candidate = reflect.className(k);
        if (candidate != null && (candidate as string) == bareName) {
            return k;
        }
    }
    for (k in c.perRequestFactories.keys()) {
        let candidate = reflect.className(k);
        if (candidate != null && (candidate as string) == bareName) {
            return k;
        }
    }
    for (id in c.serviceIds.keys()) {
        let classRef = c.serviceIds[id];
        let candidate = reflect.className(classRef);
        if (candidate != null && (candidate as string) == bareName) {
            return classRef;
        }
    }
    return null;
}

func joinList(list<string> xs, string sep): string {
    string out = "";
    for (i in 0..<xs.length()) {
        if (i > 0) {
            out = out + sep;
        }
        out = out + xs[i];
    }
    return out;
}

/**
 * Register a factory for a class. When the container is asked to
 * resolve `classRef`, it calls `factory()` (a no-arg callable that
 * returns a value of the right type) once, caches the result, and
 * hands the same value back on every subsequent resolve.
 *
 * Use a factory when the construction has side effects, depends on
 * runtime configuration, or produces a value that can't be assembled
 * by reflection (e.g. opening a database connection).
 */
export func register(Container c, any classRef, callable factory): Container {
    c.factories[classRef] = factory;
    return c;
}

/**
 * Register a per-request factory. While a request is in flight,
 * the framework's request handler wraps resolution in a request
 * scope; resolves for this class share one instance across the
 * request and are discarded afterwards. Outside a request scope
 * (e.g. during startup or in tests not using TestClient), each
 * resolve calls the factory fresh and does not cache.
 *
 * Useful for per-request state holders: a `RequestContext` that
 * holds the current user + tenant + correlation id, a
 * `TransactionManager` scoped to a single HTTP request, etc.
 */
export func registerPerRequest(Container c, any classRef, callable factory): Container {
    c.perRequestFactories[classRef] = factory;
    return c;
}

/**
 * Run `fn()` inside a request scope and return whatever `fn`
 * produced. Per-request classes resolved during `fn` are cached
 * for the scope's lifetime and discarded when `fn` returns.
 * Called by the framework's request handler; user code shouldn't
 * need to invoke this directly.
 *
 * The return is typed `any` rather than generic because Geblang
 * doesn't bind a free generic on the function from a callable's
 * return type alone (and the explicit call-site binding doesn't
 * thread through to the `as T` cast cleanly). Callers cast the
 * result at the boundary.
 */
export func withRequestScope(Container c, callable fn): any {
    int gid = sys.goroutineId();
    c._lock.lock();
    bool priorActive = c.scopeActiveByGid.contains(gid) && (c.scopeActiveByGid[gid] as bool);
    any priorCache = c.scopeCacheByGid.contains(gid) ? c.scopeCacheByGid[gid] : null;
    c.scopeActiveByGid[gid] = true;
    c.scopeCacheByGid[gid] = ({} as dict<any, any>);
    c._lock.unlock();
    try {
        return fn();
    } finally {
        c._lock.lock();
        if (priorActive) {
            c.scopeActiveByGid[gid] = priorActive;
            c.scopeCacheByGid[gid] = priorCache;
        } else {
            c.scopeActiveByGid.delete(gid);
            c.scopeCacheByGid.delete(gid);
        }
        c._lock.unlock();
    }
}

/* ---- concurrency-safe DI internals (guarded by Container._lock) ---- */

func diScopeCache(Container c, int gid): any {
    c._lock.lock();
    any r = c.scopeCacheByGid.contains(gid) ? c.scopeCacheByGid[gid] : null;
    c._lock.unlock();
    return r;
}

func diResolvingSnapshot(Container c, int gid): list<string> {
    c._lock.lock();
    list<string> r = [];
    if (c.resolvingByGid.contains(gid)) {
        r = c.resolvingByGid[gid] as list<string>;
    }
    c._lock.unlock();
    return r;
}

func diResolvingPush(Container c, int gid, string name): void {
    c._lock.lock();
    list<string> stack = [];
    if (c.resolvingByGid.contains(gid)) {
        stack = c.resolvingByGid[gid] as list<string>;
    }
    c.resolvingByGid[gid] = stack.push(name);
    c._lock.unlock();
}

func diResolvingPop(Container c, int gid): void {
    c._lock.lock();
    if (c.resolvingByGid.contains(gid)) {
        list<string> next = popLast(c.resolvingByGid[gid] as list<string>);
        if (next.isEmpty()) {
            c.resolvingByGid.delete(gid);
        } else {
            c.resolvingByGid[gid] = next;
        }
    }
    c._lock.unlock();
}

func diCacheGet(Container c, any classRef): any {
    c._lock.lock();
    any r = c.cache.contains(classRef) ? c.cache[classRef] : null;
    c._lock.unlock();
    return r;
}

func diCachePut(Container c, any classRef, any instance): any {
    c._lock.lock();
    any winner = instance;
    if (c.cache.contains(classRef)) {
        winner = c.cache[classRef];
    } else {
        c.cache[classRef] = instance;
    }
    c._lock.unlock();
    return winner;
}

func diCacheKeys(Container c): list<any> {
    c._lock.lock();
    list<any> out = [];
    for (k in c.cache.keys()) {
        out = out.push(k);
    }
    c._lock.unlock();
    return out;
}

/**
 * Register an explicit instance as the container's value for a class.
 * Useful for stubbing in tests:
 *
 *   di.registerInstance(c, DbConn, fakeConn);
 */
export func registerInstance(Container c, any classRef, any instance): Container {
    c._lock.lock();
    c.cache[classRef] = instance;
    c._lock.unlock();
    return c;
}

/**
 * Register an instance to satisfy constructor parameters typed
 * with an interface. `ifaceTypeName` is the interface's declared
 * name as it appears in source (module-qualified for cross-
 * module interfaces, e.g. "llm.Client"). The lookup is exact-
 * string match, so the registered name must match the parameter
 * type annotation verbatim.
 *
 * Use this for any interface-typed dependency the framework wires
 * up; constructor walks during `resolve` / `resolveWith` consult
 * `interfaceInstances` before falling through to class-based
 * resolution.
 */
export func registerInterfaceInstance(Container c, string ifaceTypeName, any instance): Container {
    c.interfaceInstances[ifaceTypeName] = instance;
    return c;
}

/**
 * Register a class under a string id. Used by the @Service discovery
 * sweep and the YAML services loader. Throws if `id` is already
 * bound to a different class so duplicate ids surface at warm-up
 * rather than as silent shadowing at first resolve.
 */
export func registerService(Container c, string id, any classRef): Container {
    if (c.serviceIds.contains(id)) {
        let prior = c.serviceIds[id];
        if (prior != classRef) {
            throw RuntimeError("DI: service id '" + id + "' is already registered to a different class");
        }
        return c;
    }
    c.serviceIds[id] = classRef;
    return c;
}

/**
 * Resolve a service by its registered string id (from @Service or
 * a YAML services entry). Throws if no service is registered under
 * that id. Resolution otherwise follows the normal autowire path.
 */
export func resolveService(Container c, string id, callable parameterResolver): any {
    string canonical = canonicalServiceId(c, id);
    if (!c.serviceIds.contains(canonical)) {
        throw RuntimeError("DI: no service registered with id '" + id + "'");
    }
    bool shared = !c.serviceShared.contains(canonical) || (c.serviceShared[canonical] as bool);
    if (!shared) {
        if (c.serviceFactories.contains(canonical)) {
            let factory = c.serviceFactories[canonical];
            return factory();
        }
        return buildInstanceFresh(c, c.serviceIds[canonical], parameterResolver);
    }
    return resolveWith(c, c.serviceIds[canonical], parameterResolver);
}

/* Autowire a fresh instance without touching the class-keyed cache.
 * Dependencies resolve through resolveWith so their own scope policy
 * holds. Used for transient YAML services with no custom factory. */
func buildInstanceFresh(Container c, any classRef, callable parameterResolver): any {
    return buildByAutowire(c, classRef, parameterResolver);
}

/** True when an id is registered, following aliases. */
export func hasService(Container c, string id): bool {
    string canonical = canonicalServiceId(c, id);
    return c.serviceIds.contains(canonical);
}

/** Lists all registered service ids in insertion order. Aliases are
 *  not included; use `aliases(c)` for those. */
export func serviceIds(Container c): list<string> {
    return c.serviceIds.keys();
}

/**
 * Register a custom factory for a service id, with optional tags and
 * shared flag. Used by the YAML services-section loader when the
 * entry supplies constructor arg overrides. Pass a no-arg `factory`
 * callable that returns the built instance.
 */
export func registerServiceFactory(Container c, string id, any classRef, callable factory, list<string> tags, bool shared): Container {
    registerService(c, id, classRef);
    c.serviceFactories[id] = factory;
    c.serviceTags[id] = tags;
    c.serviceShared[id] = shared;
    if (shared && !c.factories.contains(classRef)) {
        c.factories[classRef] = factory;
    }
    return c;
}

/** Attach a tag to an already-registered service id. */
export func tagService(Container c, string id, string tag): Container {
    if (!c.serviceTags.contains(id)) {
        c.serviceTags[id] = [];
    }
    let existing = c.serviceTags[id] as list<string>;
    if (!existing.contains(tag)) {
        c.serviceTags[id] = existing.push(tag);
    }
    return c;
}

/** Tags attached to a service id, in insertion order. */
export func tagsForService(Container c, string id): list<string> {
    string canonical = canonicalServiceId(c, id);
    if (!c.serviceTags.contains(canonical)) { return []; }
    return c.serviceTags[canonical] as list<string>;
}

/** Service ids carrying `tag`, in service-registration order. */
export func taggedServiceIds(Container c, string tag): list<string> {
    list<string> out = [];
    for (id in c.serviceIds.keys()) {
        if (!c.serviceTags.contains(id)) { continue; }
        if ((c.serviceTags[id] as list<string>).contains(tag)) {
            out = out.push(id);
        }
    }
    return out;
}

/**
 * Register an alias mapping. Resolving the alias id goes through the
 * normal resolveService path under the target id. Throws if `alias`
 * is already registered as a real service or as a different alias.
 */
export func registerAlias(Container c, string alias, string target): Container {
    if (c.serviceIds.contains(alias)) {
        throw RuntimeError("DI: alias '" + alias + "' shadows an existing service id");
    }
    if (c.aliases.contains(alias) && (c.aliases[alias] as string) != target) {
        throw RuntimeError("DI: alias '" + alias + "' is already mapped to a different target");
    }
    c.aliases[alias] = target;
    return c;
}

/** All registered aliases as `{alias: target}`. */
export func aliases(Container c): dict<string, string> {
    return c.aliases;
}

/* Resolve any alias chain to the canonical service id. Throws on
 * cycles so misconfiguration surfaces at resolve time. */
export func canonicalServiceId(Container c, string id): string {
    string current = id;
    list<string> seen = [];
    while (c.aliases.contains(current)) {
        if (seen.contains(current)) {
            throw RuntimeError("DI: alias cycle at '" + id + "'");
        }
        seen = seen.push(current);
        current = c.aliases[current] as string;
    }
    return current;
}

/**
 * Resolve a class: return the cached instance if present; otherwise
 * call the registered factory if one is registered; otherwise build
 * the instance via constructor autowiring by recursively resolving
 * each constructor parameter's declared type.
 *
 * Classes with no explicit constructor (data classes) are
 * instantiated via the bare `classRef()` call. Cycles raise a
 * `RuntimeError`. An unresolvable parameter type (no factory, no
 * class found, can't be auto-built) raises a `RuntimeError`
 * naming the offending parameter so the user can register the
 * missing binding.
 */
export func resolve(Container c, any classRef): any {
    return resolveWith(c, classRef, func(string k): any {
        throw RuntimeError("DI: parameter '" + k + "' requested via @Param "
            + "but no parameter resolver is configured (use gebweb.parameter "
            + "to register one, or call resolveWith with a custom resolver)");
    });
}

/**
 * Like `resolve` but lets the caller plug in a resolver for
 * parameters annotated with `@Param("key")`. The framework wires
 * this up so primitive config (db URLs, secrets, feature flags
 * registered via gebweb.parameter) can be injected into controllers
 * and services alongside class dependencies.
 *
 * `parameterResolver` is called as `parameterResolver(key)` for
 * each `@Param(key)` constructor parameter and should return the
 * value to inject (typically a string / int / bool).
 */
export func resolveWith(Container c, any classRef, callable parameterResolver): any {
    /* Per-request bindings get their own cache layer that lives
     * for one HTTP request; outside a scope they're transient. */
    if (c.perRequestFactories.contains(classRef)) {
        int sgid = sys.goroutineId();
        any scopeCache = diScopeCache(c, sgid);
        if (scopeCache != null) {
            let sc = scopeCache as dict<any, any>;
            if (sc.contains(classRef)) {
                return sc[classRef];
            }
            let instance = (c.perRequestFactories[classRef])();
            /* sc is this goroutine's own scope dict; no other goroutine
             * touches it, so the in-place write needs no lock. */
            sc[classRef] = instance;
            return instance;
        }
        return (c.perRequestFactories[classRef])();
    }
    let cached = diCacheGet(c, classRef);
    if (cached != null) {
        return cached;
    }
    int gid = sys.goroutineId();
    string className = classDisplayName(classRef);
    for (n in diResolvingSnapshot(c, gid)) {
        if (n == className) {
            throw RuntimeError("DI cycle detected resolving " + className
                + " (stack: " + joinList(diResolvingSnapshot(c, gid), " -> ") + ")");
        }
    }
    diResolvingPush(c, gid, className);

    let instance;
    if (c.factories.contains(classRef)) {
        let factory = c.factories[classRef];
        instance = factory();
    } else {
        instance = buildByAutowire(c, classRef, parameterResolver);
    }

    diResolvingPop(c, gid);
    return diCachePut(c, classRef, instance);
}

/**
 * Resolve a single constructor parameter by its declared type:
 * @Param("key") -> parameterResolver(key); interface match ->
 * registered instance; otherwise reflect.class + fallback to
 * findRegisteredByTypeName, then recursively resolveWith. `parentName`
 * is folded into the error message so the user sees which class's
 * autowire failed.
 */
export func resolveDependency(Container c, dict<string, any> param, callable parameterResolver, string parentName = ""): any {
    string pname = param["name"] as string;
    string ptype = stripNullable(param["type"] as string);
    let paramKey = paramDecoratorKey(param);
    if (paramKey != null) {
        return parameterResolver(paramKey as string);
    }
    let dot = ptype.lastIndexOf(".");
    string bareType = dot < 0 ? ptype : ptype.substring(dot + 1, ptype.length());
    if (c.interfaceInstances.contains(ptype)) { return c.interfaceInstances[ptype]; }
    if (c.interfaceInstances.contains(bareType)) { return c.interfaceInstances[bareType]; }
    if (c.interfaceBindings.contains(ptype)) {
        return resolveService(c, c.interfaceBindings[ptype] as string, parameterResolver);
    }
    if (c.interfaceBindings.contains(bareType)) {
        return resolveService(c, c.interfaceBindings[bareType] as string, parameterResolver);
    }
    let autoId = singleImplFor(c, bareType);
    if (autoId != null) {
        c.interfaceBindings[bareType] = autoId as string;
        return resolveService(c, autoId as string, parameterResolver);
    }
    let depClass = reflect.class(ptype);
    if (depClass == null) {
        depClass = findRegisteredByTypeName(c, ptype);
    }
    if (depClass == null) {
        string prefix = parentName.isEmpty() ? "cannot resolve" : "cannot resolve " + parentName + ":";
        throw RuntimeError(prefix + " parameter '" + pname
            + "' of type '" + ptype + "' is not a known class (register a factory for it)");
    }
    return resolveWith(c, depClass, parameterResolver);
}

/**
 * Bind an interface name to a registered service id. resolveDependency
 * uses the binding to resolve constructor params typed with the
 * interface. Throws if the interface is already bound to a different
 * id (idempotent for the same target).
 */
export func bindInterface(Container c, string ifaceName, string serviceId): Container {
    if (c.interfaceBindings.contains(ifaceName)) {
        let prior = c.interfaceBindings[ifaceName] as string;
        if (prior != serviceId) {
            throw RuntimeError("DI: interface '" + ifaceName + "' is already bound to '" + prior + "'");
        }
        return c;
    }
    c.interfaceBindings[ifaceName] = serviceId;
    return c;
}

/** All registered interface bindings as `{interface: service-id}`. */
export func interfaceBindings(Container c): dict<string, string> {
    return c.interfaceBindings;
}

/**
 * Walk every registered service and throw when an interface has
 * multiple implementations and no explicit binding (or eager
 * instance). Single-impl auto-binding is deferred to first resolve
 * so the binding reflects the final service set, not the partial
 * picture seen at the time detect runs. Idempotent.
 */
export func detectInterfaceConflicts(Container c): void {
    let implsByIface = implementorsByInterface(c);
    for (iface in implsByIface.keys()) {
        let impls = implsByIface[iface] as list<string>;
        if (impls.length() <= 1) { continue; }
        if (c.interfaceBindings.contains(iface)) { continue; }
        if (c.interfaceInstances.contains(iface)) { continue; }
        throw RuntimeError("DI: interface '" + iface + "' has " + (impls.length() as string)
            + " implementations (" + joinList(impls, ", ")
            + ") but no binding; bind it via services.yaml `bindings:` or di.bindInterface");
    }
}

/* Returns the sole service id implementing `ifaceName`, or null
 * when zero or more than one impl is registered. Used by
 * resolveDependency for lazy single-impl auto-binding. */
func singleImplFor(Container c, string ifaceName): ?any {
    ?string found = null;
    for (id in c.serviceIds.keys()) {
        if (collectInheritedInterfaces(c.serviceIds[id]).contains(ifaceName)) {
            if (found != null) { return null; }
            found = id;
        }
    }
    return found;
}

/* Build the iface name -> list-of-service-ids multimap by walking
 * each registered class and its parent chain. Used by detect and
 * by resolveDependency's lazy single-impl auto-bind. */
func implementorsByInterface(Container c): dict<string, list<string>> {
    dict<string, list<string>> implsByIface = {};
    for (id in c.serviceIds.keys()) {
        for (iface in collectInheritedInterfaces(c.serviceIds[id])) {
            if (!implsByIface.contains(iface)) { implsByIface[iface] = []; }
            implsByIface[iface] = (implsByIface[iface] as list<string>).push(id);
        }
    }
    return implsByIface;
}

/* All interface names declared by classRef or any class up its
 * `extends` chain, deduped. reflect.interfaces returns only the
 * direct `implements` clause, so an inheriting subclass needs the
 * walk to honour interfaces declared on its parent. */
export func collectInheritedInterfaces(any classRef): list<string> {
    list<string> out = [];
    let current = classRef;
    while (current != null) {
        for (raw in reflect.interfaces(current)) {
            string iface = raw as string;
            if (!out.contains(iface)) { out = out.push(iface); }
        }
        let parentName = reflect.parent(current);
        if (parentName == null) { break; }
        current = reflect.class(parentName as string);
    }
    return out;
}

/* Walk the class's constructor params and assemble the arg list. */
func buildByAutowire(Container c, any classRef, callable parameterResolver): any {
    let ctors = reflect.constructors(classRef);
    if (ctors.length() == 0) { return classRef(); }
    list<any> params = ctors[0] as list<any>;
    if (params.length() == 0) { return classRef(); }
    string parentName = classDisplayName(classRef);
    list<any> ctorArgs = [];
    for (paramAny in params) {
        ctorArgs = ctorArgs.push(resolveDependency(c, paramAny as dict<string, any>, parameterResolver, parentName));
    }
    return classRef(...ctorArgs);
}

/* Returns the key string from the first `@Param("key")` decorator
 * attached to a constructor parameter, or null if the parameter
 * has no @Param. Other parameter decorators are ignored here -
 * routing decorators (@PathParam etc.) are honoured by the request
 * dispatcher, not the DI container. */
func paramDecoratorKey(dict<string, any> param): ?any {
    if (!param.contains("decorators")) { return null; }
    let decs = param["decorators"] as list<any>;
    for (d in decs) {
        let dd = d as dict<string, any>;
        if ((dd["name"] as string) != "Param") { continue; }
        let args = dd["args"] as list<any>;
        if (args.length() == 0) { return null; }
        return args[0];
    }
    return null;
}

