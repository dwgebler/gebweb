module gebweb.waf;

/**
 * @title gebweb.waf
 * @summary Web Application Firewall middleware: content-signature rules,
 * IP allow/deny with CIDR, user-agent filtering, request constraints,
 * block/log modes, and optional ban escalation. Sibling to abuseGuard.
 */

import http;
import io;
import json;
import net;
import re;
import store;
import time;
import url;

func hexDigit(string ch): int {
    return "0123456789abcdef".indexOf(ch);
}

func parseHex16(string g): ?int {
    if (g.isEmpty() || g.length() > 4) {
        return null;
    }
    int v = 0;
    for (ch in g.lower().chars()) {
        int d = hexDigit(ch as string);
        if (d < 0) {
            return null;
        }
        v = v * 16 + d;
    }
    return v;
}

func ipv4ToInt(string ip): ?dict<string, any> {
    let parts = ip.split(".");
    if (parts.length() != 4) {
        return null;
    }
    int value = 0;
    for (p in parts) {
        string ps = p as string;
        if (!ps.isInt()) {
            return null;
        }
        int n = ps.toInt();
        if (n < 0 || n > 255) {
            return null;
        }
        value = value * 256 + n;
    }
    return {"value": value, "bits": 32};
}

func ipv6ToInt(string ip): ?dict<string, any> {
    string head = ip;
    string tail = "";
    let dc = ip.indexOf("::");
    bool hasDouble = dc >= 0;
    if (hasDouble) {
        head = ip.substring(0, dc);
        tail = ip.substring(dc + 2, ip.length());
        if (tail.indexOf("::") >= 0) {
            return null;
        }
    }
    list<string> headGroups = head.isEmpty() ? [] : head.split(":");
    list<string> tailGroups = tail.isEmpty() ? [] : tail.split(":");
    int present = headGroups.length() + tailGroups.length();
    if (present > 8 || (!hasDouble && present != 8)) {
        return null;
    }
    list<int> groups = [];
    for (g in headGroups) {
        let v = parseHex16(g as string);
        if (v == null) {
            return null;
        }
        groups.push(v as int);
    }
    int fill = 8 - present;
    for (i in zrange(0, fill)) {
        groups.push(0);
    }
    for (g in tailGroups) {
        let v = parseHex16(g as string);
        if (v == null) {
            return null;
        }
        groups.push(v as int);
    }
    if (groups.length() != 8) {
        return null;
    }
    int value = 0;
    for (g in groups) {
        value = value * 65536 + (g as int);
    }
    return {"value": value, "bits": 128};
}

func ipToInt(string ip): ?dict<string, any> {
    if (ip.indexOf(":") >= 0) {
        return ipv6ToInt(ip);
    }
    return ipv4ToInt(ip);
}

func pow2(int k): int {
    int v = 1;
    for (i in zrange(0, k)) {
        v = v * 2;
    }
    return v;
}

export func ipInCidr(string ip, string cidr): bool {
    let slash = cidr.indexOf("/");
    let ipParsed = ipToInt(ip);
    if (ipParsed == null) {
        return false;
    }
    let ipd = ipParsed as dict<string, any>;
    if (slash < 0) {
        let base = ipToInt(cidr);
        if (base == null) {
            return false;
        }
        let bd = base as dict<string, any>;
        return (bd["bits"] as int) == (ipd["bits"] as int) && (bd["value"] as int) == (ipd["value"] as int);
    }
    string baseStr = cidr.substring(0, slash);
    string prefixStr = cidr.substring(slash + 1, cidr.length());
    if (!prefixStr.isInt()) {
        return false;
    }
    int prefix = prefixStr.toInt();
    let base = ipToInt(baseStr);
    if (base == null) {
        return false;
    }
    let bd = base as dict<string, any>;
    int bits = bd["bits"] as int;
    if ((ipd["bits"] as int) != bits || prefix < 0 || prefix > bits) {
        return false;
    }
    int blockSize = pow2(bits - prefix);
    return ((ipd["value"] as int) // blockSize) == ((bd["value"] as int) // blockSize);
}

export func ipMatchesAny(string ip, list<string> patterns): bool {
    for (pat in patterns) {
        if (ipInCidr(ip, pat as string)) {
            return true;
        }
    }
    return false;
}

func wafRuleSets(): dict<string, list<string>> {
    return {
        "sqli": [
            "(?i)\\bunion\\b\\s+\\bselect\\b",
            "(?i)\\bor\\b\\s+1\\s*=\\s*1",
            "(?i)';\\s*--",
            "(?i)\\bsleep\\s*\\(",
            "(?i)\\bxp_cmdshell\\b",
            "(?i)\\bdrop\\b\\s+\\btable\\b",
            "(?i);\\s*(drop|union|select|insert|update|delete)\\b",
        ],
        "xss": [
            "(?i)<script\\b",
            "(?i)javascript:",
            "(?i)\\bon(error|load|click|mouseover|focus)\\s*=",
            "(?i)<iframe\\b",
            "(?i)<svg[^>]*\\bon\\w+\\s*=",
            "(?i)document\\.cookie",
        ],
        "rce": [
            "(?i);\\s*(cat|ls|wget|curl|bash|sh|nc|ncat|chmod)\\b",
            "\\$\\([^)]*\\)",
            "(?i)\\|\\s*(sh|bash)\\b",
            "(?i)/bin/(sh|bash)\\b",
            "(?i)\\b(system|exec|passthru|popen)\\s*\\(",
        ],
        "traversal": [
            "\\.\\./",
            "\\.\\.\\\\",
            "(?i)%2e%2e",
            "(?i)/etc/passwd",
            "(?i)/proc/self",
            "(?i)file://",
        ],
    };
}

func wafForbidden(string message): http.Response {
    return http.jsonResponse({
        "type": "about:blank",
        "title": "Forbidden",
        "status": 403,
        "detail": message,
    }, 403).withHeader("Content-Type", "application/problem+json");
}

func bodyText(any request): string {
    let b = request["body"] ?? "";
    if (b instanceof string) {
        return b as string;
    }
    if (b instanceof dict || b instanceof list) {
        return json.stringify(b);
    }
    return "";
}

/* A stray % would make url.decode fail; escape it so a malformed sequence cannot hide the rest. */
func decodeLayer(string value): string {
    return url.decode(re.replace("%([0-9A-Fa-f]?[^0-9A-Fa-f]|[0-9A-Fa-f]?$)", "%25$1", value));
}

/* scan value against all active sets; returns the first hit with that set's name */
/* Clients percent-encode queries and form bodies, so the raw text and each decoding layer (bounded, to catch double encoding) are scanned. */
func scanDecoded(string value, string target, dict<string, any> scanner): ?dict<string, any> {
    string current = value;
    for (let int layer = 0; layer < 4; layer++) {
        let hit = scanValue(current, target, scanner);
        if (hit != null) {
            return hit;
        }
        if (!current.contains("%") && !current.contains("+")) {
            return null;
        }
        string decoded = decodeLayer(current);
        if (decoded == current) {
            return null;
        }
        current = decoded;
    }
    return null;
}

/* One combined set scans each value once; ruleNames maps a pattern index back to its rule set. */
func scanValue(string value, string target, dict<string, any> scanner): ?dict<string, any> {
    int hit = (scanner["set"] as re.RegexSet).match(value);
    if (hit < 0) {
        return null;
    }
    string snippet = value.length() > 200 ? value.substring(0, 200) : value;
    return {"rule": (scanner["ruleNames"] as list<string>)[hit], "target": target, "value": snippet};
}

func wafEvaluate(any request, string ip, net.IpSet denyIps, list<string> blockUa, list<string> allowedMethods, list<string> blockedHeaders, int maxBody, WafScanners scanners, list<WafExclusion> exclusions): ?dict<string, any> {
    /* deny IP */
    if (!ip.isEmpty() && denyIps.contains(ip)) {
        return {"rule": "denyIp", "target": "ip", "value": ip};
    }
    /* method constraint */
    if (!allowedMethods.isEmpty()) {
        string m = (request.method() ?? "GET").upper();
        bool allowed = false;
        for (am in allowedMethods) {
            if (m == am) {
                allowed = true;
                break;
            }
        }
        if (!allowed) {
            return {"rule": "method", "target": "method", "value": m};
        }
    }
    /* blocked header presence */
    for (bh in blockedHeaders) {
        let hval = request.header(bh as string);
        if (hval != null) {
            return {"rule": "blockedHeader", "target": "header", "value": bh as string};
        }
    }
    /* body text computed once for size check and signature scan */
    string body = bodyText(request);
    /* body size */
    if (maxBody > 0) {
        let rawBody = request["body"];
        int bodyBytes = rawBody instanceof bytes ? (rawBody as bytes).length() : (body as bytes).length();
        if (bodyBytes > maxBody) {
            return {"rule": "bodySize", "target": "body", "value": "${bodyBytes}"};
        }
    }
    /* user-agent */
    if (!blockUa.isEmpty()) {
        let ua = (request.header("User-Agent") ?? "") as string;
        string ual = ua.lower();
        for (sub in blockUa) {
            if (ual.contains(sub as string)) {
                return {"rule": "userAgent", "target": "userAgent", "value": ua};
            }
        }
    }
    return scanContent(request, body, scanners, exclusions);
}

/* Content signatures: query first, then body, then headers. Exclusions that apply to this path switch scanning to per-field. */
func scanContent(any request, string body, WafScanners scanners, list<WafExclusion> exclusions): ?dict<string, any> {
    let view = exclusions.isEmpty() ? null : exclusionView(exclusions, request.path());
    list<string> whole = view == null ? [] : (view as ExclusionView).whole;
    let base = view == null ? scanners.full : scanners.without(whole);
    if (base == null) {
        return null;
    }
    dict<string, list<string>> fields = view == null ? {} : (view as ExclusionView).fields;
    dict<string, list<string>> headerRules = view == null ? {} : (view as ExclusionView).headers;
    string q = request.rawQuery();
    if (!q.isEmpty()) {
        let hit = fields.isEmpty() ? scanDecoded(q, "query", base as dict<string, any>) : scanPairs(q, "query", whole, fields, scanners);
        if (hit != null) {
            return hit;
        }
    }
    if (!body.isEmpty()) {
        string contentType = ((request.header("Content-Type") ?? "") as string).lower();
        ?dict<string, any> hit = null;
        if (contentType.contains("application/x-www-form-urlencoded")) {
            hit = fields.isEmpty() ? scanDecoded(body, "body", base as dict<string, any>) : scanPairs(body, "body", whole, fields, scanners);
        } else if (!fields.isEmpty() && contentType.contains("json")) {
            hit = scanJsonBody(request, body, whole, fields, scanners);
        } else {
            hit = scanValue(body, "body", base as dict<string, any>);
        }
        if (hit != null) {
            return hit;
        }
    }
    let raw = request.toDict()["headers"] ?? {};
    if (raw instanceof dict) {
        let h = raw as dict<string, any>;
        for (k in h.keys()) {
            let v = h[k as string];
            if (!(v instanceof string)) {
                continue;
            }
            string name = (k as string).lower();
            let sc = headerRules.contains(name) ? scanners.without(unionRules(whole, headerRules[name])) : base;
            if (sc == null) {
                continue;
            }
            let hit = scanValue(v as string, "header", sc as dict<string, any>);
            if (hit != null) {
                return hit;
            }
        }
    }
    return null;
}

/* Scans each name=value pair of a query or form body; an excluded field's value uses the scanner without its rules. */
func scanPairs(string raw, string target, list<string> whole, dict<string, list<string>> fields, WafScanners scanners): ?dict<string, any> {
    let base = scanners.without(whole) as dict<string, any>;
    for (pair in raw.split("&")) {
        string p = pair as string;
        int eq = p.indexOf("=");
        string rawName = eq >= 0 ? p.substring(0, eq) : p;
        let nameHit = scanDecoded(rawName, target, base);
        if (nameHit != null) {
            return nameHit;
        }
        if (eq < 0) {
            continue;
        }
        string name = decodeLayer(rawName.replace("+", " "));
        let sc = fields.contains(name) ? scanners.without(unionRules(whole, fields[name])) : base;
        if (sc == null) {
            continue;
        }
        let hit = scanDecoded(p.substring(eq + 1, p.length()), target, sc as dict<string, any>);
        if (hit != null) {
            return hit;
        }
    }
    return null;
}

func scanJsonBody(any request, string body, list<string> whole, dict<string, list<string>> fields, WafScanners scanners): ?dict<string, any> {
    let parsed = request["body"];
    if (parsed instanceof string) {
        try {
            parsed = json.parse(parsed as string);
        } catch (Error e) {
            return scanValue(body, "body", scanners.without(whole) as dict<string, any>);
        }
    }
    return scanJsonValue(parsed, whole, fields, scanners);
}

/* Walks a JSON value; keys are always scanned, and an excluded key's value (at any depth) drops its rules for everything under it. */
func scanJsonValue(any value, list<string> excluded, dict<string, list<string>> fields, WafScanners scanners): ?dict<string, any> {
    let sc = scanners.without(excluded);
    if (sc == null) {
        return null;
    }
    if (value instanceof string) {
        return scanValue(value as string, "body", sc as dict<string, any>);
    }
    if (value instanceof list) {
        for (item in value as list<any>) {
            let hit = scanJsonValue(item, excluded, fields, scanners);
            if (hit != null) {
                return hit;
            }
        }
        return null;
    }
    if (value instanceof dict) {
        let d = value as dict<string, any>;
        for (k in d.keys()) {
            string key = k as string;
            let keyHit = scanValue(key, "body", sc as dict<string, any>);
            if (keyHit != null) {
                return keyHit;
            }
            list<string> next = fields.contains(key) ? unionRules(excluded, fields[key]) : excluded;
            let hit = scanJsonValue(d[key], next, fields, scanners);
            if (hit != null) {
                return hit;
            }
        }
    }
    return null;
}

func wafLog(any logger, any request, string ip, dict<string, any> hit): void {
    string line = "[waf] rule="
        + (hit["rule"] as string)
        + " target="
        + (hit["target"] as string)
        + " ip="
        + ip
        + " method="
        + request.method()
        + " path="
        + request.path();
    if (logger != null) {
        (logger as callable)(line);
    } else {
        io.println(line);
    }
}

func sweepExpiredBans(store.Store banState, int now): void {
    for (k in banState.keys()) {
        let s = banState.get(k);
        if (s != null && ((s as dict<string, any>)["banUntil"] as int) <= now) {
            banState.delete(k);
        }
    }
}

/** Records an offence and returns the ban expiry (Unix ms), or 0 when the client is not banned. */
func wafRecordBan(store.Store banState, store.Store sweepCounter, string ip, dict<string, any> ban): int {
    int threshold = ban["threshold"] as int;
    int banSeconds = ban["banSeconds"] as int;
    int now = time.now();
    int sweepEvery = 1024;
    if (sweepCounter.incr("n") % sweepEvery == 0) {
        sweepExpiredBans(banState, now);
    }
    let updated = banState.update(ip, func(any old): any {
        dict<string, any> s = (old == null) ? {"score": 0, "banUntil": 0} : (old as dict<string, any>);
        int score = (s["score"] as int) + 1;
        int banUntil = s["banUntil"] as int;
        if (score >= threshold) {
            banUntil = now + banSeconds * 1000;
        }
        return {"score": score, "banUntil": banUntil};
    }) as dict<string, any>;
    int until = updated["banUntil"] as int;
    return until > now ? until : 0;
}

/** The default limiter and ban key: the client IP, or its /64 network for IPv6, since one host usually controls a whole /64. */
export func networkKey(string ip): string {
    if (ip.isEmpty()) {
        return "anon";
    }
    /* A link-local zone (fe80::1%eth0) names the interface, not the client, and parseCidr rejects it. */
    string addr = ip;
    int zone = addr.indexOf("%");
    if (zone > 0) {
        addr = addr.substring(0, zone);
    }
    if (net.isIpv6(addr)) {
        return (net.parseCidr(addr + "/64")["network"] as string) + "/64";
    }
    return ip;
}

/** Adds a banned client to a connection-level blocklist; keys that are not IPs (custom keyFn) are skipped. */
export func blockClient(?net.IpSet blocklist, string key, int seconds): void {
    if (blocklist == null) {
        return;
    }
    try {
        (blocklist as net.IpSet).add(key, seconds);
    } catch (ValueError e) {}
}

func ipSetFrom(list<string> entries): net.IpSet {
    let set = net.ipSet();
    for (entry in entries) {
        try {
            set.add(entry as string);
        } catch (ValueError e) {}
    }
    return set;
}

func validateIpList(list<string> entries, string listName, any logger): void {
    for (entry in entries) {
        string e = entry as string;
        let slash = e.indexOf("/");
        if (slash >= 0) {
            string baseStr = e.substring(0, slash);
            string prefixStr = e.substring(slash + 1, e.length());
            let parsed = ipToInt(baseStr);
            bool prefixOk = prefixStr.isInt();
            int maxBits = 32;
            if (parsed != null) {
                maxBits = (parsed as dict<string, any>)["bits"] as int;
            }
            int prefixVal = prefixOk ? prefixStr.toInt() : -1;
            if (parsed == null || !prefixOk || prefixVal < 0 || prefixVal > maxBits) {
                string msg = "[waf] malformed entry in " + listName + ": " + e;
                if (logger != null) {
                    (logger as callable)(msg);
                } else {
                    io.println(msg);
                }
            }
        } else {
            if (ipToInt(e) == null) {
                string msg = "[waf] malformed entry in " + listName + ": " + e;
                if (logger != null) {
                    (logger as callable)(msg);
                } else {
                    io.println(msg);
                }
            }
        }
    }
}

/** One `exclusions` entry: which paths it covers, and which fields, headers and rule sets it exempts. */
class WafExclusion {
    list<string> paths;
    list<string> fields;
    list<string> headers;
    list<string> rules;

    func WafExclusion(list<string> paths, list<string> fields, list<string> headers, list<string> rules) {
        this.paths = paths;
        this.fields = fields;
        this.headers = headers;
        this.rules = rules;
    }

    func covers(string path): bool {
        if (this.paths.isEmpty()) {
            return true;
        }
        for (p in this.paths) {
            string prefix = p as string;
            if (prefix == "/" || path == prefix || path.startsWith(prefix + "/")) {
                return true;
            }
        }
        return false;
    }
}

/** The rules each request part is exempt from on one path; whole applies to every value. */
class ExclusionView {
    list<string> whole;
    dict<string, list<string>> fields;
    dict<string, list<string>> headers;

    func ExclusionView() {
        this.whole = [];
        this.fields = {};
        this.headers = {};
    }
}

/** Combined pattern sets keyed by the rule sets they leave out, built once so each value is still scanned in one pass. */
class WafScanners {
    list<string> active;
    dict<string, dict<string, any>> byExcluded;
    ?dict<string, any> full;

    func WafScanners(dict<string, list<string>> sets, list<string> active, list<WafExclusion> exclusions) {
        this.active = active;
        this.byExcluded = {};
        list<string> named = [];
        for (e in exclusions) {
            named = unionRules(named, (e as WafExclusion).rules);
        }
        for (subset in ruleSubsets(named)) {
            list<string> keep = active.filter(
                func(string r): bool { return !(subset as list<string>).contains(r); }
            );
            if (keep.isEmpty()) {
                continue;
            }
            list<string> patterns = [];
            list<string> ruleNames = [];
            for (name in keep) {
                if (sets.contains(name as string)) {
                    for (p in sets[name as string]) {
                        patterns.push(p as string);
                        ruleNames.push(name as string);
                    }
                }
            }
            this.byExcluded[(subset as list<string>).join(",")] = {
                "set": re.set(patterns),
                "ruleNames": ruleNames,
            };
        }
        this.full = this.byExcluded.get("") as ?dict<string, any>;
    }

    /** The scanner for the active rules minus excluded, or null when nothing is left to scan. */
    func without(list<string> excluded): ?dict<string, any> {
        list<string> key = excluded.filter(func(string r): bool { return this.active.contains(r); }).sorted();
        return this.byExcluded.get(key.join(",")) as ?dict<string, any>;
    }
}

func ruleSubsets(list<string> names): list<list<string>> {
    list<list<string>> out = [[]];
    for (name in names.sorted()) {
        list<list<string>> grown = [];
        for (s in out) {
            grown.push(s as list<string>);
            list<string> withName = (s as list<string>).copy();
            withName.push(name as string);
            grown.push(withName);
        }
        out = grown;
    }
    return out;
}

func unionRules(list<string> a, list<string> b): list<string> {
    list<string> out = a.copy();
    for (r in b) {
        if (!out.contains(r as string)) {
            out.push(r as string);
        }
    }
    return out.sorted();
}

func exclusionStrings(dict<string, any> entry, string key): list<string> {
    if (!entry.contains(key)) {
        return [];
    }
    if (!(entry[key] instanceof list)) {
        throw ValueError("waf: exclusions ${key} must be a list of strings");
    }
    list<string> out = [];
    for (v in entry[key] as list<any>) {
        if (!(v instanceof string)) {
            throw ValueError("waf: exclusions ${key} must be a list of strings");
        }
        out.push(v as string);
    }
    return out;
}

func compileExclusions(list<any> raw, dict<string, list<string>> sets, list<string> active): list<WafExclusion> {
    list<WafExclusion> out = [];
    for (item in raw) {
        if (!(item instanceof dict)) {
            throw ValueError("waf: each exclusions entry must be a dict");
        }
        let entry = item as dict<string, any>;
        for (k in entry.keys()) {
            if (!["paths", "fields", "headers", "rules"].contains(k as string)) {
                throw ValueError("waf: unknown exclusions key \"${k}\"");
            }
        }
        list<string> paths = [];
        for (p in exclusionStrings(entry, "paths")) {
            string path = p as string;
            if (!path.startsWith("/")) {
                throw ValueError("waf: exclusions path \"${path}\" must start with /");
            }
            while (path.length() > 1 && path.endsWith("/")) {
                path = path.substring(0, path.length() - 1);
            }
            paths.push(path);
        }
        list<string> fields = exclusionStrings(entry, "fields");
        list<string> headers = exclusionStrings(entry, "headers").map(
            func(string h): string { return h.lower(); }
        );
        list<string> rules = exclusionStrings(entry, "rules");
        for (r in rules) {
            if (!sets.contains(r as string)) {
                throw ValueError("waf: unknown exclusions rule set \"${r}\"");
            }
        }
        if (paths.isEmpty() && fields.isEmpty() && headers.isEmpty()) {
            throw ValueError("waf: an exclusions entry needs paths, fields or headers");
        }
        out.push(
            WafExclusion(paths, fields, headers, rules.isEmpty() ? active : unionRules([], rules))
        );
    }
    return out;
}

func exclusionView(list<WafExclusion> exclusions, string path): ?ExclusionView {
    if (exclusions.isEmpty()) {
        return null;
    }
    ?ExclusionView view = null;
    for (e in exclusions) {
        if (!e.covers(path)) {
            continue;
        }
        if (view == null) {
            view = ExclusionView();
        }
        let v = view as ExclusionView;
        if (e.fields.isEmpty() && e.headers.isEmpty()) {
            v.whole = unionRules(v.whole, e.rules);
        }
        for (f in e.fields) {
            v.fields[f as string] = unionRules(
                v.fields.get(f as string) as ?list<string> ?? [],
                e.rules
            );
        }
        for (h in e.headers) {
            v.headers[h as string] = unionRules(
                v.headers.get(h as string) as ?list<string> ?? [],
                e.rules
            );
        }
    }
    return view;
}

export func waf(dict<string, any> opts): callable {
    any logger = opts.contains("logger") ? opts["logger"] : null;

    let sets = wafRuleSets();
    list<string> active = opts.contains("rules") ? (opts["rules"] as list<any>).map(func(any r): string { return r as string; }) : ["sqli", "xss", "rce", "traversal"];
    list<WafExclusion> exclusions = opts.contains("exclusions") ? compileExclusions(opts["exclusions"] as list<any>, sets, active) : [];
    let scanners = WafScanners(sets, active, exclusions);
    list<string> allowIps = opts.contains("allowIps") ? (opts["allowIps"] as list<any>).map(func(any v): string { return v as string; }) : [];
    list<string> denyIps = opts.contains("denyIps") ? (opts["denyIps"] as list<any>).map(func(any v): string { return v as string; }) : [];
    list<string> blockUa = opts.contains("blockUserAgents") ? (opts["blockUserAgents"] as list<any>).map(func(any v): string { return (v as string).lower(); }) : [];
    list<string> allowedMethods = opts.contains("allowedMethods") ? (opts["allowedMethods"] as list<any>).map(func(any v): string { return (v as string).upper(); }) : [];
    list<string> blockedHeaders = opts.contains("blockedHeaders") ? (opts["blockedHeaders"] as list<any>).map(func(any v): string { return (v as string).lower(); }) : [];
    int maxBody = opts.contains("maxBodyBytes") ? (opts["maxBodyBytes"] as int) : 0;
    string mode = opts.contains("mode") ? (opts["mode"] as string) : "block";
    string message = opts.contains("message") ? (opts["message"] as string) : "forbidden";
    any onBlock = opts.contains("onBlock") ? opts["onBlock"] : null;
    any banOpt = opts.contains("ban") ? opts["ban"] : null;
    callable keyFn = func(any req): string { return req.clientIp(); };
    bool customKey = opts.contains("keyFn");
    if (customKey) {
        keyFn = opts["keyFn"] as callable;
    }

    /* validate IP lists once at construction */
    validateIpList(allowIps, "allowIps", logger);
    validateIpList(denyIps, "denyIps", logger);
    let allowSet = ipSetFrom(allowIps);
    let denySet = ipSetFrom(denyIps);
    ?net.IpSet blocklist = opts.contains("blocklist") ? (opts["blocklist"] as net.IpSet) : null;

    let banState = store.Store();
    let sweepCounter = store.Store();

    return func(any request): ?http.Response {
        string ip = keyFn(request);
        string banKey = (banOpt == null || customKey || ip.isEmpty()) ? ip : networkKey(ip);

        /* allowlist bypasses all checks */
        if (!ip.isEmpty() && allowSet.contains(ip)) {
            return null;
        }

        /* ban check */
        if (banOpt != null && !banKey.isEmpty()) {
            int now = time.now();
            let cur = banState.get(banKey);
            if (cur != null && ((cur as dict<string, any>)["banUntil"] as int) > now) {
                return wafForbidden(message);
            }
        }

        let hit = wafEvaluate(
            request,
            ip,
            denySet,
            blockUa,
            allowedMethods,
            blockedHeaders,
            maxBody,
            scanners,
            exclusions
        );
        if (hit == null) {
            return null;
        }
        dict<string, any> ruleHit = hit as dict<string, any>;

        if (onBlock != null) {
            (onBlock as callable)(request, ruleHit);
        }
        wafLog(logger, request, ip, ruleHit);

        if (mode == "log") {
            return null;
        }

        if (banOpt != null && !banKey.isEmpty()) {
            int bannedUntil = wafRecordBan(
                banState,
                sweepCounter,
                banKey,
                banOpt as dict<string, any>
            );
            if (bannedUntil > 0) {
                blockClient(blocklist, banKey, (banOpt as dict<string, any>)["banSeconds"] as int);
            }
        }
        return wafForbidden(message);
    };
}
