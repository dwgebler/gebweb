module gebweb.messaging;

/**
 * Message-broker integration for Gebweb. Connects the in-process
 * application to one or more named broker handles (queues from
 * `messaging.connect()` or topics from `messaging.topic()`),
 * routes incoming messages to handler classes annotated with
 * `@OnMessage("handle-name")`, and provides a worker entry point
 * that drives one consume / subscribe loop per registered handle.
 *
 * Wiring:
 *
 *     import gebweb;
 *     import messaging;
 *
 *     let orders = messaging.connect({
 *         "driver":   "rabbitmq",
 *         "url":      "amqp://localhost/",
 *         "queue":    "orders"
 *     });
 *     gebweb.useMessageQueue(app, "orders", orders);
 *     gebweb.registerMessageHandlers(app, [OrderProcessor()]);
 *
 * Handler class:
 *
 *     class OrderProcessor {
 *         @OnMessage("orders")
 *         func handle(any msg): void {
 *             let order = json.parse(msg["body"] as string);
 *             // do work; throw to surface the error in the
 *             // worker log (queue backends will redeliver per
 *             // their visibility-timeout / requeue rules).
 *         }
 *     }
 *
 * Worker entry point - call from a CLI-mode branch of main.gb,
 * usually behind `if (sys.getenv("GEBWEB_RUN") == "messaging")`:
 *
 *     gebweb.runMessageWorker(app);
 *
 * Topics work the same way: register the topic handle under a
 * name and tag the handler method with `@OnMessage("name")`. The
 * worker calls `subscribe()` for topics and `consume()` for
 * queues; both block until the broker handle is closed.
 */

import reflect;
import async;
import store;
import time;
import io;
import messaging.contract as contract;
import gebweb.decorators as gwdec;
import errors;

/** Per-app messaging configuration: a registry of named broker
 *  handles plus the @OnMessage handler registry. */
export class MessagingConfig {
    /* Map from handle name to a record:
     *   {"handle": any, "kind": "queue" | "topic"}.
     * Stored as dict<string, any> to keep things heterogeneous. */
    dict<string, dict<string, any>> handles;
    /* Map from handle name to a list of handler entries:
     *   {"instance": any, "method": callable, "handlerName": string}.
     * One handle can carry multiple handlers; they are invoked in
     * registration order for each delivered message. */
    dict<string, list<dict<string, any>>> handlers;
    bool started;

    func MessagingConfig() {
        this.handles = {};
        this.handlers = {};
        this.started = false;
    }
}

export func newConfig(): MessagingConfig {
    return MessagingConfig();
}

/**
 * Register a named queue handle. The name is what `@OnMessage`
 * decorators refer to; `handle` is the return value of
 * `messaging.connect({...})` (a MessageQueue).
 */
export func useQueue(MessagingConfig config, string name, any handle): void {
    if (config.started) { throw ValueError("gebweb: messaging registration is closed after worker start"); }
    config.handles[name] = {"handle": handle, "kind": "queue"};
}

/**
 * Register a named topic handle. The name is what `@OnMessage`
 * decorators refer to; `handle` is the return value of
 * `messaging.topic({...})` (a MessageTopic).
 */
export func useTopic(MessagingConfig config, string name, any handle): void {
    if (config.started) { throw ValueError("gebweb: messaging registration is closed after worker start"); }
    config.handles[name] = {"handle": handle, "kind": "topic"};
}

/**
 * Walk each instance, find every method decorated with
 * `@OnMessage("handle-name")`, and register it under that
 * handle's name. A single method may handle multiple handles by
 * stacking decorators.
 */
export func registerHandlers(MessagingConfig config, list<any> instances): void {
    if (config.started) { throw ValueError("gebweb: messaging registration is closed after worker start"); }
    for (instance in instances) {
        let cls = reflect.class(instance);
        let className = reflect.typeOf(instance) as string;
        for (name in gwdec.instanceMethodNames(instance)) {
            let methodName = name as string;
            let methodRef = reflect.method(instance, methodName);
            for (handleName in onMessageHandlesOf(methodRef)) {
                let entry = {
                    "instance":    instance,
                    "method":      methodRef,
                    "handlerName": className + "." + methodName
                };
                if (!config.handlers.contains(handleName as string)) {
                    config.handlers[handleName as string] = [];
                }
                config.handlers[handleName as string] = config.handlers[handleName as string].push(entry as dict<string, any>);
            }
        }
    }
}

/** Returns every `@OnMessage("name")` decorator on a method. */
func onMessageHandlesOf(any method): list<string> {
    list<string> out = [];
    for (decoratorValue in gwdec.decoratorsOf(method)) {
        let dec = decoratorValue as dict<string, any>;
        if ((dec["name"] as string) == "OnMessage") {
            let args = dec["args"] as list<any>;
            if (args.length() > 0 && args[0] instanceof string) {
                out = out.push(args[0] as string);
            }
        }
    }
    return out;
}

/** Own one serial managed consumer task per selected handle, joining all tasks on drain. */
export func runWorker(any app, MessagingConfig config, dict<string, any> opts): void {
    ?string filter = opts["handle"] as ?string;
    list<string> selected = (opts["handles"] ?? []) as list<string>;
    let state = store.Store();
    ?callable drain = opts["drainCheck"] as ?callable;
    int timeout = (opts["shutdownTimeoutMs"] ?? 30000) as int;
    if (timeout <= 0) { throw ValueError("gebweb: shutdownTimeoutMs must be positive"); }
    int maxRestarts = (opts["maxRestarts"] ?? 5) as int;
    int restartDelay = (opts["restartDelayMs"] ?? 1000) as int;
    int restartReset = (opts["restartResetMs"] ?? 60000) as int;
    if (maxRestarts < 0 || restartDelay < 1 || restartReset < 1) { throw ValueError("gebweb: invalid broker restart policy"); }
    list<dict<string, any>> tasks = [];
    list<dict<string, any>> prepared = [];
    for (handleName in config.handles.keys()) {
        if (filter != null && handleName != filter) { continue; }
        if (selected.length() > 0 && !selected.contains(handleName)) { continue; }
        if (!config.handlers.contains(handleName)) { continue; }
        let record = config.handles[handleName];
        let handle = record["handle"];
        string kind = record["kind"] as string;
        bool managed = kind == "queue" ? handle instanceof contract.ManagedMessageQueue : handle instanceof contract.ManagedMessageTopic;
        if ((opts["requireManaged"] ?? false) == true && !managed) { throw ValueError("gebweb: broker handle lacks managed consumption: " + handleName); }
        prepared.push({"name": handleName, "handle": handle, "kind": kind});
    }
    config.started = true;
    for (record in prepared) {
        let handle = record["handle"];
        string kind = record["kind"] as string;
        string handleName = record["name"] as string;
        let dispatcher = makeDispatcher(app, handleName, config.handlers[handleName]);
        string name = handleName;
        let task = async.run(func(): void {
            any current = handle;
            int restarts = 0;
            dict<string, any> factories = (opts["factories"] ?? {}) as dict<string, any>;
            try {
                while (true) {
                    int startedAt = time.monotonic();
                    try {
                        let stop = func(): bool { return state.get("stop") == true || (drain != null && ((drain as callable)() as bool)); };
                        if (kind == "queue" && current instanceof contract.ManagedMessageQueue) { current.consumeUntil(dispatcher, stop); }
                        else if (kind == "topic" && current instanceof contract.ManagedMessageTopic) { current.subscribeUntil(dispatcher, stop); }
                        else if (kind == "queue") { current.consume(dispatcher); }
                        else { current.subscribe(dispatcher); }
                        return;
                    } catch (Error e) {
                        if (time.monotonic() - startedAt >= restartReset) { restarts = 0; }
                        if (!factories.contains(name) || restarts >= maxRestarts || state.get("stop") == true) { throw e; }
                        current.close();
                        io.stderrPrintln("gebweb: broker " + name + " failed; reconnecting: " + e.message);
                        restarts += 1;
                        int delay = restartDelay;
                        if (delay < 1) { throw ValueError("gebweb: restartDelayMs must be positive"); }
                        int deadline = time.monotonic() + delay;
                        while (state.get("stop") != true && time.monotonic() < deadline) { async.await(async.sleep(5)); }
                        if (state.get("stop") == true) { return; }
                        let factory = factories[name] as callable;
                        current = factory();
                        if ((opts["requireManaged"] ?? false) == true && !(kind == "queue" ? current instanceof contract.ManagedMessageQueue : current instanceof contract.ManagedMessageTopic)) { throw ValueError("gebweb: reconnect factory returned an unmanaged handle: " + name); }
                    }
                }
            } finally { current.close(); }
        });
        tasks.push({"name": name, "task": task, "done": false});
    }
    int pending = tasks.length();
    int deadline = 0;
    list<string> failures = [];
    bool overdue = false;
    while (pending > 0) {
        if (drain != null && ((drain as callable)() as bool)) { state.set("stop", true); }
        for (record in tasks) {
            if (record["done"] == true || !async.done(record["task"])) { continue; }
            try { async.await(record["task"]); }
            catch (Error e) { failures.push((record["name"] as string) + ": " + e.message); state.set("stop", true); }
            record["done"] = true;
            pending -= 1;
        }
        if (state.get("stop") == true) {
            if (deadline == 0) { deadline = time.monotonic() + timeout; }
            if (pending > 0 && !overdue && time.monotonic() >= deadline) {
                overdue = true;
                failures.push("broker drain deadline exceeded");
                io.stderrPrintln("gebweb: broker drain deadline exceeded; waiting for owned consumers to return");
            }
        }
        if (pending > 0) { async.await(async.sleep(5)); }
    }
    if (failures.length() > 0) { throw RuntimeError("gebweb: broker worker failed: " + failures.join("; ")); }
}

export func workerCapabilities(MessagingConfig config): dict<string, bool> {
    dict<string, bool> result = {};
    for (name, record in config.handles) {
        let handle = record["handle"];
        result[name] = record["kind"] == "queue" ? handle instanceof contract.ManagedMessageQueue : handle instanceof contract.ManagedMessageTopic;
    }
    return result;
}

func containsString(list<string> xs, string needle): bool {
    for (s in xs) {
        if (s == needle) { return true; }
    }
    return false;
}

/**
 * Run the consume / subscribe loop for a single handle name.
 * Blocks until the broker handle is closed or the loop throws.
 * Exposed so callers can spawn one task per handle for
 * concurrent consumption.
 */
export func runHandleLoop(any app, MessagingConfig config, string handleName): void {
    if (!config.handles.contains(handleName)) {
        throw errors.new("RuntimeError",
            "gebweb.messaging: handle '" + handleName + "' is not registered");
    }
    let rec = config.handles[handleName];
    let handle = rec["handle"];
    let kind = rec["kind"] as string;
    let entries = config.handlers.contains(handleName) ? config.handlers[handleName] : [];
    let dispatcher = makeDispatcher(app, handleName, entries);
    if (kind == "topic") {
        handle.subscribe(dispatcher);
    } else {
        handle.consume(dispatcher);
    }
}

/** Build a single callable that fans the message out to every
 *  registered handler for the named handle. Exceptions from one
 *  handler don't stop the rest; they are collected and re-thrown
 *  as one aggregated error so the consume / subscribe loop's
 *  ack/nack semantics still apply. */
func makeDispatcher(any app, string handleName, list<dict<string, any>> entries): callable {
    return func(any msg): void {
        list<string> failures = [];
        for (entry in entries) {
            let e = entry as dict<string, any>;
            let dispatch = e["method"] as callable;
            try {
                dispatch(msg);
            } catch (Error err) {
                failures = failures.push((e["handlerName"] as string) + ": " + err.message);
            }
        }
        if (failures.length() > 0) {
            string joined = "";
            for (let i = 0; i < failures.length(); i = i + 1) {
                if (i > 0) { joined = joined + "; "; }
                joined = joined + failures[i];
            }
            throw errors.new("RuntimeError",
                "gebweb.messaging: " + (failures.length() as string) +
                " handler(s) failed for '" + handleName + "': " + joined);
        }
    };
}

/* --- inspection helpers (tests + ad-hoc dashboards) --- */

/** Number of @OnMessage handlers registered for `handleName`. */
export func handlerCount(MessagingConfig config, string handleName): int {
    if (!config.handlers.contains(handleName)) {
        return 0;
    }
    return config.handlers[handleName].length();
}

/** Returns the registered handle (queue or topic) under `name`,
 *  or null when no such handle exists. */
export func handle(MessagingConfig config, string name): any {
    if (!config.handles.contains(name)) {
        return null;
    }
    return config.handles[name]["handle"];
}
