module gebweb.validation;

/**
 * `@Assert` field validation. After a typed handler body is
 * deserialized (in `binding.gb`) or an `@ApiResource` POST/PUT/PATCH
 * payload is converted to an entity (in `resource.gb`), the framework
 * walks the class's fields, reads each field's `@Assert.*` decorators
 * via reflection, runs the associated validator, and collects the
 * failures.
 *
 * If any validator failed, the framework throws
 * `errors.UnprocessableEntityError(detail, errors)` which renders as
 * an RFC 9457 problem document at status 422 with a structured
 * `errors` list of `{field, code, message}` entries.
 *
 * Built-in assertions:
 *
 *   @Assert.email                    valid email (RFC 5322 lite)
 *   @Assert.url                      valid http(s) URL
 *   @Assert.regex(pattern)           must match pattern
 *   @Assert.minLength(n)             string length >= n
 *   @Assert.maxLength(n)             string length <= n
 *   @Assert.range(min, max)          int in [min, max]
 *   @Assert.in(list)                 value is one of list
 *   @Assert.notBlank                 non-null, non-empty after trim
 *   @Assert.uuid                     RFC 4122 UUID
 *
 * Custom assertions:
 *
 *   gebweb.registerAssertion("strongPassword",
 *       func(any value, list<any> args, dict<string, any> named): ?string {
 *           if (value as string).length() < 12 { return "must be 12+ chars"; }
 *           return null;
 *       });
 *
 * The validator returns `null` on success or an error-message string
 * on failure.
 */

import re;
import reflect;
import datetime;
import json;

let emailPattern  = "^[A-Za-z0-9._%+-]+@[A-Za-z0-9.-]+\\.[A-Za-z]{2,}$";
let urlPattern    = "^https?://[^\\s]+$";
let uuidPattern   = "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$";
let datePattern   = "^\\d{4}-\\d{2}-\\d{2}$";
let timePattern   = "^\\d{2}:\\d{2}:\\d{2}$";
let ipv6Pattern   = "^(([0-9a-fA-F]{1,4}:){7}[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,7}:|([0-9a-fA-F]{1,4}:){1,6}:[0-9a-fA-F]{1,4}|([0-9a-fA-F]{1,4}:){1,5}(:[0-9a-fA-F]{1,4}){1,2}|([0-9a-fA-F]{1,4}:){1,4}(:[0-9a-fA-F]{1,4}){1,3}|([0-9a-fA-F]{1,4}:){1,3}(:[0-9a-fA-F]{1,4}){1,4}|([0-9a-fA-F]{1,4}:){1,2}(:[0-9a-fA-F]{1,4}){1,5}|[0-9a-fA-F]{1,4}:((:[0-9a-fA-F]{1,4}){1,6})|:((:[0-9a-fA-F]{1,4}){1,7}|:)|fe80:(:[0-9a-fA-F]{0,4}){0,4}%[0-9a-zA-Z]{1,}|::(ffff(:0{1,4}){0,1}:){0,1}((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])|([0-9a-fA-F]{1,4}:){1,4}:((25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9])\\.){3,3}(25[0-5]|(2[0-4]|1{0,1}[0-9]){0,1}[0-9]))$";

/**
 * One assertion failure. The framework throws
 * `UnprocessableEntityError(detail, [list of these])` and the error
 * renderer surfaces them as the `errors` array of the RFC 9457
 * problem document.
 */
export class ValidationError {
    string field;
    string code;
    string message;
    dict<string, any> params;

    func ValidationError(string field, string code, string message, dict<string, any> params = {}) {
        this.field = field;
        this.code = code;
        this.message = message;
        this.params = params;
    }
}

/**
 * The registry of assertion handlers. Built-ins are seeded by
 * `builtinAssertions()`; user code adds to it via
 * `gebweb.registerAssertion`. The key is the unqualified rule name
 * (e.g. "email" for `@Assert.email`).
 */
export class AssertionRegistry {
    dict<string, callable> assertions;

    func AssertionRegistry() {
        this.assertions = builtinAssertions();
    }
}

/** Returns a fresh registry seeded with the built-in assertions. */
export func newRegistry(): AssertionRegistry {
    return AssertionRegistry();
}

/** Register a custom assertion under `@Assert.<name>`. */
export func register(AssertionRegistry registry, string name, callable validator): AssertionRegistry {
    registry.assertions[name] = validator;
    return registry;
}

func toDictArg(any value): dict<string, any> {
    if (value instanceof dict) {
        return value as dict<string, any>;
    }
    return {};
}

func toListArg(any value): list<any> {
    if (value instanceof list) {
        return value as list<any>;
    }
    return [];
}

/* for sign/magnitude checks */
func numericValue(any value): ?float {
    if (value instanceof int) { return (value as int) as float; }
    if (value instanceof float) { return value as float; }
    if (value instanceof decimal) { return (value as decimal) as float; }
    return null;
}

func isIpv4(string s): bool {
    let parts = s.split(".");
    if (parts.length() != 4) { return false; }
    for (p in parts) {
        if (p.isEmpty() || !re.test("^\\d{1,3}$", p)) { return false; }
        int n = p as int;
        if (n < 0 || n > 255) { return false; }
    }
    return true;
}

func isIpv6(string s): bool {
    return re.test(ipv6Pattern, s);
}

/**
 * Build the default assertion registry. Each validator takes
 * (value, positional args, named args) and returns null on success
 * or an error-message string on failure.
 */
export func builtinAssertions(): dict<string, callable> {
    dict<string, callable> out = {};

    out["email"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (re.test(emailPattern, value as string)) { return null; }
        return "must be a valid email address";
    };

    out["url"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (re.test(urlPattern, value as string)) { return null; }
        return "must be a valid http(s) URL";
    };

    out["uuid"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (re.test(uuidPattern, value as string)) { return null; }
        return "must be a valid UUID";
    };

    out["regex"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (args.length() == 0) { return null; }
        string pattern = args[0] as string;
        if (re.test(pattern, value as string)) { return null; }
        return {"message": "must match pattern " + pattern, "params": {"pattern": pattern}};
    };

    out["minLength"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (args.length() == 0) { return null; }
        int n = args[0] as int;
        if ((value as string).length() >= n) { return null; }
        return {"message": "must be at least " + (n as string) + " characters", "params": {"min": n}};
    };

    out["maxLength"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (args.length() == 0) { return null; }
        int n = args[0] as int;
        if ((value as string).length() <= n) { return null; }
        return {"message": "must be at most " + (n as string) + " characters", "params": {"max": n}};
    };

    out["range"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (!(value instanceof int)) { return "expected an int"; }
        if (args.length() < 2) { return null; }
        int lo = args[0] as int;
        int hi = args[1] as int;
        int v = value as int;
        if (v >= lo && v <= hi) { return null; }
        return {"message": "must be in range [" + (lo as string) + ", " + (hi as string) + "]", "params": {"min": lo, "max": hi}};
    };

    out["in"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        list<any> candidates = args;
        /* Allow `@Assert.in(["a", "b", "c"])` (a single list arg) AND
         * `@Assert.in("a", "b", "c")` (varargs). */
        if (args.length() == 1 && args[0] instanceof list) {
            candidates = args[0] as list<any>;
        }
        for (c in candidates) {
            if (c == value) { return null; }
        }
        return "must be one of the allowed values";
    };

    out["choice"] = out["in"];

    out["notBlank"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return "must not be blank"; }
        if (!(value instanceof string)) { return null; }
        string s = value as string;
        if (s.trim().isEmpty()) { return "must not be blank"; }
        return null;
    };

    out["notNull"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return "must not be null"; }
        return null;
    };

    out["isNull"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value != null) { return "must be null"; }
        return null;
    };

    out["blank"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (value instanceof string && (value as string).trim().isEmpty()) { return null; }
        return "must be blank";
    };

    out["isTrue"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (value instanceof bool && (value as bool) == true) { return null; }
        return "must be true";
    };

    out["isFalse"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (value instanceof bool && (value as bool) == false) { return null; }
        return "must be false";
    };

    out["type"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        string want = args[0] as string;
        let accepted = ["int", "float", "string", "bool", "list", "dict"];
        if (!accepted.contains(want)) {
            return {"message": "unknown type name '" + want + "' in @Assert.type", "params": {"type": want}};
        }
        if (typeof(value) == want) { return null; }
        return {"message": "must be of type " + want, "params": {"type": want}};
    };

    out["positive"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        let n = numericValue(value);
        if (n != null && (n as float) > 0.0f) { return null; }
        return "must be a positive number";
    };

    out["negative"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        let n = numericValue(value);
        if (n != null && (n as float) < 0.0f) { return null; }
        return "must be a negative number";
    };

    out["positiveOrZero"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        let n = numericValue(value);
        if (n != null && (n as float) >= 0.0f) { return null; }
        return "must be zero or positive";
    };

    out["negativeOrZero"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        let n = numericValue(value);
        if (n != null && (n as float) <= 0.0f) { return null; }
        return "must be zero or negative";
    };

    out["greaterThan"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        let n = numericValue(value);
        float bound = argFloat(args[0]);
        if (n != null && (n as float) > bound) { return null; }
        if (n == null) { return "must be a number"; }
        return {"message": "must be greater than " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["greaterThanOrEqual"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        let n = numericValue(value);
        float bound = argFloat(args[0]);
        if (n != null && (n as float) >= bound) { return null; }
        if (n == null) { return "must be a number"; }
        return {"message": "must be greater than or equal to " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["lessThan"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        let n = numericValue(value);
        float bound = argFloat(args[0]);
        if (n != null && (n as float) < bound) { return null; }
        if (n == null) { return "must be a number"; }
        return {"message": "must be less than " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["lessThanOrEqual"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        let n = numericValue(value);
        float bound = argFloat(args[0]);
        if (n != null && (n as float) <= bound) { return null; }
        if (n == null) { return "must be a number"; }
        return {"message": "must be less than or equal to " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["equalTo"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        if (value == args[0]) { return null; }
        return {"message": "must equal " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["notEqualTo"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() == 0) { return null; }
        if (value != args[0]) { return null; }
        return {"message": "must not equal " + (args[0] as string), "params": {"value": args[0]}};
    };

    out["count"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (args.length() < 2) { return null; }
        int lo = args[0] as int;
        int hi = args[1] as int;
        int size = -1;
        if (value instanceof list) { size = (value as list<any>).length(); }
        else if (value instanceof dict) { size = (value as dict<string, any>).keys().length(); }
        else { return "must be a collection"; }
        if (size >= lo && size <= hi) { return null; }
        return {"message": "must contain between " + (lo as string) + " and " + (hi as string) + " items", "params": {"min": lo, "max": hi}};
    };

    out["length"] = func(any value, list<any> args, dict<string, any> named): any {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        if (args.length() < 2) { return null; }
        int lo = args[0] as int;
        int hi = args[1] as int;
        int len = (value as string).length();
        if (len >= lo && len <= hi) { return null; }
        return {"message": "must be between " + (lo as string) + " and " + (hi as string) + " characters", "params": {"min": lo, "max": hi}};
    };

    out["date"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        string s = value as string;
        if (!re.test(datePattern, s)) { return "must be a valid date (YYYY-MM-DD)"; }
        try { datetime.parse(s, "date"); return null; } catch (Error e) { return "must be a valid date (YYYY-MM-DD)"; }
    };

    out["datetime"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        string s = value as string;
        try { datetime.parse(s, "iso"); return null; } catch (Error e) {}
        try { datetime.parse(s, "datetime"); return null; } catch (Error e) {}
        return "must be a valid ISO 8601 datetime";
    };

    out["time"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        string s = value as string;
        if (!re.test(timePattern, s)) { return "must be a valid time (HH:MM:SS)"; }
        list<string> parts = s.split(":");
        int h = parts[0] as int;
        int m = parts[1] as int;
        int sec = parts[2] as int;
        if (h < 0 || h > 23 || m < 0 || m > 59 || sec < 0 || sec > 59) {
            return "must be a valid time (HH:MM:SS)";
        }
        return null;
    };

    out["ip"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        string s = value as string;
        if (isIpv4(s) || isIpv6(s)) { return null; }
        return "must be a valid IP address";
    };

    out["json"] = func(any value, list<any> args, dict<string, any> named): ?string {
        if (value == null) { return null; }
        if (!(value instanceof string)) { return "expected a string"; }
        try { json.parse(value as string); return null; } catch (Error e) { return "must be valid JSON"; }
    };

    return out;
}

/* coerce int or float arg to float for numeric bound comparisons */
func argFloat(any a): float {
    if (a instanceof float) { return a as float; }
    return (a as int) as float;
}

/* Cap @Valid recursion; guards against a pathological cyclic object graph. */
let maxValidationDepth = 32;

/* typeof() names @Valid must not recurse into (reflect.fields would error). */
let nonInstanceTypes = ["string", "int", "float", "decimal", "bool", "bytes", "set", "range", "function", "callable"];

/**
 * Walk the instance's class fields, run any `@Assert.*` decorators
 * against the corresponding field value, and return the list of
 * failures. A field marked `@Valid` cascades into its nested value
 * (a DTO, a `list<DTO>`, or a `dict<string, DTO>`); nested failures
 * carry a dotted / indexed / keyed field path. An empty list means the
 * instance passed validation.
 */
export func validate(AssertionRegistry registry, any instance): list<ValidationError> {
    /* `errors` would shadow the built-in `errors` module name in
     * Geblang's identifier resolution, so the failures list is
     * named `failures` here. Same pattern downstream. */
    list<ValidationError> failures = [];
    validateInto(registry, instance, "", failures, 0);
    return failures;
}

func validateInto(AssertionRegistry registry, any instance, string prefix, list<ValidationError> failures, int depth): void {
    if (depth > maxValidationDepth || !isClassInstance(instance)) {
        return;
    }
    for (entry in reflect.fields(instance)) {
        let field = entry as dict<string, any>;
        if (!field.contains("decorators")) {
            continue;
        }
        string fieldName = field["name"] as string;
        let value = readField(instance, fieldName);
        string path = prefix.isEmpty() ? fieldName : "${prefix}.${fieldName}";
        bool cascade = false;
        for (decValue in field["decorators"] as list<any>) {
            let dec = decValue as dict<string, any>;
            string name = dec["name"] as string;
            if (name == "Valid") {
                cascade = true;
                continue;
            }
            /* @Assert.<rule> only; ignore other annotation families. */
            if (!name.startsWith("Assert.")) {
                continue;
            }
            string rule = name.substring(7, name.length());
            if (!registry.assertions.contains(rule)) {
                continue;
            }
            let validator = registry.assertions[rule];
            let result = validator(value, toListArg(dec["args"]), toDictArg(dec["namedArgs"]));
            if (result != null) {
                appendFailure(failures, path, rule, result);
            }
        }
        if (cascade) {
            cascadeValid(registry, value, path, failures, depth);
        }
    }
}

/* list -> each element (indexed path), dict -> each value (keyed path),
 * anything else -> a single nested DTO. */
func cascadeValid(AssertionRegistry registry, any value, string path, list<ValidationError> failures, int depth): void {
    if (value == null) {
        return;
    }
    if (value instanceof list) {
        int i = 0;
        for (el in value as list<any>) {
            validateInto(registry, el, "${path}[${i}]", failures, depth + 1);
            i = i + 1;
        }
    } else if (value instanceof dict) {
        let m = value as dict<string, any>;
        for (k in m.keys()) {
            validateInto(registry, m[k as string], "${path}[${k}]", failures, depth + 1);
        }
    } else {
        validateInto(registry, value, path, failures, depth + 1);
    }
}

func appendFailure(list<ValidationError> failures, string field, string rule, any result): void {
    if (result instanceof dict) {
        let r = result as dict<string, any>;
        failures.push(ValidationError(field, rule, r["message"] as string, toDictArg(r["params"])));
    } else {
        failures.push(ValidationError(field, rule, result as string));
    }
}

func isClassInstance(any value): bool {
    if (value == null || value instanceof list || value instanceof dict) {
        return false;
    }
    string t = typeof(value);
    for (n in nonInstanceTypes) {
        if (t == n) {
            return false;
        }
    }
    return true;
}

/**
 * Localise validation failures using a translator. Looks up
 * `validation.<code>` in the catalog; on hit, interpolates the
 * field name and the failure's params into the result. On miss,
 * the original (English) message is preserved.
 */
export func localize(any translator, string locale, list<ValidationError> failures): list<ValidationError> {
    list<ValidationError> out = [];
    for (f in failures) {
        let v = f.message;
        if (translator != null) {
            dict<string, any> args = {"field": f.field};
            for (k in f.params.keys()) {
                args[k as string] = f.params[k as string];
            }
            let translated = translator.translate(locale, "validation." + f.code, args);
            if (translated != "validation." + f.code) {
                v = translated;
            }
        }
        out = out.push(ValidationError(f.field, f.code, v, f.params));
    }
    return out;
}

/**
 * Reads a field value off an instance by name. Uses the native
 * `reflect.getField` primitive - direct field map lookup, no
 * serialisation round-trip.
 */
func readField(any instance, string name): any {
    return reflect.getField(instance, name);
}
