module gebweb.cache;

/**
 * Response caching for Gebweb routes. The app holds at most one
 * cache store (registered via `gebweb.useCacheStore(app, store)`);
 * any handler carrying `@Cache(ttl: N)` (or just `@Cache`) opts the
 * route in. The framework checks the cache before binding/calling
 * the handler and writes the response back on a miss.
 *
 *   import gebweb;
 *   import web.cache as cachemod;
 *
 *   let store = cachemod.fileCacheStore("/tmp/app-cache", 3600);
 *   gebweb.useCacheStore(app, store);
 *
 *   class FeedController {
 *       @Get("/feed")
 *       @Cache(ttl: 60)
 *       func feed(): dict<string, any> {
 *           return {"items": expensiveLookup()};
 *       }
 *   }
 *
 * Key shape: `METHOD path key1=v1;key2=v2` where `key=v` entries
 * cover any header listed in `@Cache(vary: ["Authorization"])`.
 * Cached responses are stored as a JSON envelope so per-route TTLs
 * can override the store's coarser TTL.
 */

import datetime;
import gebweb.decorators as gwdec;
import store as storemod;

/** Holds the cache store registered with `useCacheStore` plus a thread-safe per-app tag index. */
export class CacheConfig {
    any store;
    storemod.Store tagIndex;

    func CacheConfig(any store) {
        this.store = store;
        this.tagIndex = storemod.Store();
    }
}

/**
 * Returns the `@Cache` decorator dict on the handler (or its
 * controller class) or null when the route is not cached. A
 * handler-level decorator wins over a class-level one.
 */
export func findCacheDecorator(?any controllerClass, any handler): ?dict<string, any> {
    let onHandler = decoratorNamed(handler, "Cache");
    if (onHandler != null) {
        return onHandler;
    }
    if (controllerClass != null) {
        return decoratorNamed(controllerClass, "Cache");
    }
    return null;
}

func decoratorNamed(any target, string name): ?dict<string, any> {
    if (target == null) {
        return null;
    }
    for (decoratorValue in gwdec.decoratorsOf(target)) {
        let decorator = decoratorValue as dict<string, any>;
        if ((decorator["name"] as string) == name) {
            return decorator;
        }
    }
    return null;
}

/**
 * Returns the per-route TTL in seconds. Reads `@Cache(ttl: N)` or
 * `@Cache(N)` positional. Returns 0 when no TTL is set, meaning
 * "let the store's own TTL apply".
 */
export func ttlFromDecorator(dict<string, any> decorator): int {
    dict<string, any> named = decorator["namedArgs"] as dict<string, any>;
    if (named.contains("ttl")) {
        let v = named["ttl"];
        if (v instanceof int) {
            return v as int;
        }
    }
    list<any> args = decorator["args"] as list<any>;
    if (args.length() > 0 && args[0] instanceof int) {
        return args[0] as int;
    }
    return 0;
}

/**
 * Returns the Vary header names declared on the decorator. Reads
 * the `vary` named arg as either a single string or a list of
 * strings. Empty list means the response varies only by method+path.
 */
export func varyFromDecorator(dict<string, any> decorator): list<string> {
    dict<string, any> named = decorator["namedArgs"] as dict<string, any>;
    if (!named.contains("vary")) {
        return [];
    }
    let v = named["vary"];
    if (v instanceof string) {
        return [v as string];
    }
    if (v instanceof list) {
        list<string> out = [];
        for (item in v as list<any>) {
            if (item instanceof string) {
                out = out.push(item as string);
            }
        }
        return out;
    }
    return [];
}

/**
 * Builds a cache key from the request method+path and the values
 * of the listed Vary headers. Vary keys are sorted for determinism
 * regardless of decorator argument order.
 */
/** `tags` named arg of @Cache as a list (single string accepted). */
export func tagsFromDecorator(dict<string, any> decorator): list<string> {
    let named = decorator["namedArgs"] as dict<string, any>;
    if (!named.contains("tags")) {
        return [];
    }
    let v = named["tags"];
    if (v instanceof string) {
        return [v as string];
    }
    list<string> out = [];
    for (t in v as list<any>) {
        if (t instanceof string) {
            out = out.push(t as string);
        }
    }
    return out;
}

/** Substitute `{name}` placeholders from the request's path params:
 *  `user:{id}` on `/users/42` resolves to `user:42`. */
export func resolveTags(list<string> tags, dict<string, any> request): list<string> {
    let params = (request["params"] ?? {}) as dict<string, any>;
    list<string> out = [];
    for (tag in tags) {
        string resolved = tag as string;
        for (k in params.keys()) {
            resolved = resolved.replace("{" + (k as string) + "}", params[k as string] as string);
        }
        out = out.push(resolved);
    }
    return out;
}

/** Record `key` under each tag's index entry so invalidation can find every response cached with that tag. */
export func indexTags(CacheConfig cfg, list<string> tags, string key): void {
    for (tag in tags) {
        string indexKey = "gebweb-tag|" + (tag as string);
        /* Pure set-add: this callback can rerun on a failed CAS, so it performs no remote store reads. */
        cfg.tagIndex.update(indexKey, func(any old): any {
            list<any> keys = (old != null && old instanceof list) ? (old as list<any>) : [];
            let next = [];
            bool present = false;
            for (k in keys) {
                next.push(k);
                if ((k as string) == key) {
                    present = true;
                }
            }
            if (!present) {
                next.push(key);
            }
            return next;
        });
        pruneTagIndex(cfg, indexKey);
    }
}

/** Drop index keys whose store entry has been evicted, bounding a never-invalidated high-cardinality tag. The store.has scan runs once outside the set-add CAS (never repeating on a CAS retry) and only when the index is large; the swap-back is best-effort, so a lost race is reclaimed by the next publication. */
func pruneTagIndex(CacheConfig cfg, string indexKey): void {
    let existing = cfg.tagIndex.get(indexKey);
    list<any> keys = (existing != null && existing instanceof list) ? (existing as list<any>) : [];
    if (keys.length() <= 512) {
        return;
    }
    let live = [];
    for (k in keys) {
        if (cfg.store.has(k as string)) {
            live.push(k);
        }
    }
    cfg.tagIndex.compareAndSet(indexKey, existing, live);
}

/** Delete every cached response recorded under `tag`, then the index. */
export func invalidateTag(CacheConfig cfg, string tag): int {
    string indexKey = "gebweb-tag|" + tag;
    /* Advance the tag generation first (unconditionally, even when the index is empty): a response computed against the old generation - including one whose key was stored but not yet indexed - is then detected as stale on read, closing the store-before-index publication race. */
    cfg.tagIndex.incr("gebweb-taggen|" + tag, 1);
    /* Atomically swap the index to empty so a concurrent indexTags either has its key captured here, or re-creates the index after the swap - never orphaning an entry in the store. */
    while (true) {
        let existing = cfg.tagIndex.get(indexKey);
        list<any> keys = (existing != null && existing instanceof list) ? (existing as list<any>) : [];
        if (keys.length() == 0) {
            return 0;
        }
        if (cfg.tagIndex.compareAndSet(indexKey, existing, [])) {
            int dropped = 0;
            for (k in keys) {
                cfg.store.delete(k as string);
                dropped = dropped + 1;
            }
            return dropped;
        }
    }
    return 0;
}

export func cacheKey(dict<string, any> request, list<string> varyHeaders): string {
    string method = (request["method"] ?? "GET") as string;
    string path = (request["path"] ?? "") as string;
    string key = method + " " + path;
    if (varyHeaders.length() == 0) {
        return key;
    }
    let headers = (request["headers"] ?? {}) as dict<string, any>;
    list<string> sorted = sortedCopy(varyHeaders);
    string suffix = "";
    for (name in sorted) {
        string value = headerValueLower(headers, name as string);
        suffix = suffix + (name as string) + "=" + value + ";";
    }
    return key + " " + suffix;
}

func sortedCopy(list<string> xs): list<string> {
    list<string> out = [];
    for (item in xs) {
        out = out.push(item);
    }
    return out.sort();
}

func headerValueLower(dict<string, any> headers, string name): string {
    if (headers.contains(name)) {
        return (headers[name] as string);
    }
    string target = name.lower();
    for (k, v in headers.items()) {
        if ((k as string).lower() == target) {
            return v as string;
        }
    }
    return "";
}

/**
 * Wraps a response in a TTL envelope so per-route TTLs can be
 * shorter than the store's own TTL. The envelope encodes the
 * absolute Unix-epoch expiry; the store's lower-level TTL governs
 * eventual eviction.
 */
export func envelope(dict<string, any> response, int ttl, dict<string, any> tagGens = {}): dict<string, any> {
    int expiresAt = 0;
    if (ttl > 0) {
        expiresAt = datetime.nowUnix() + ttl;
    }
    return {"response": response, "expiresAt": expiresAt, "tagGens": tagGens};
}

/* Records each tag's current generation before a response is computed, so a generation advance during compute or before the store-then-index publish is detectable on read. */
export func captureTagGenerations(CacheConfig cfg, list<string> tags): dict<string, any> {
    let gens = {};
    for (t in tags) {
        let g = cfg.tagIndex.get("gebweb-taggen|" + (t as string));
        gens[t as string] = (g != null) ? (g as int) : 0;
    }
    return gens;
}

/**
 * Unwraps the envelope. Returns the cached response, or null when
 * the envelope is expired or malformed.
 */
export func openEnvelope(any raw, ?CacheConfig cfg = null): ?dict<string, any> {
    if (raw == null) {
        return null;
    }
    if (!(raw instanceof dict)) {
        return null;
    }
    let env = raw as dict<string, any>;
    if (!env.contains("response")) {
        return null;
    }
    if (env.contains("expiresAt")) {
        int expiresAt = env["expiresAt"] as int;
        if (expiresAt > 0 && expiresAt <= datetime.nowUnix()) {
            return null;
        }
    }
    /* An entry whose stamped tag generation was advanced by an invalidation is stale and must not be served, even while still present in the store. */
    if (cfg != null && env.contains("tagGens")) {
        let stamped = env["tagGens"] as dict<string, any>;
        for (tag in stamped.keys()) {
            let cur = (cfg as CacheConfig).tagIndex.get("gebweb-taggen|" + (tag as string));
            int curGen = (cur != null) ? (cur as int) : 0;
            if (curGen != (stamped[tag] as int)) {
                return null;
            }
        }
    }
    return env["response"] as dict<string, any>;
}
