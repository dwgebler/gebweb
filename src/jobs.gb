module gebweb.jobs;

/**
 * Background jobs for Gebweb. Producers enqueue named jobs with a
 * JSON payload; one or more `gebweb worker` processes poll a
 * shared SQLite / Postgres / MySQL table and run the registered
 * handler. Retries on exception with exponential backoff.
 *
 * Wiring on the app:
 *
 *     import gebweb;
 *     import db;
 *
 *     let conn = db.connect("sqlite", "./app.db");
 *     gebweb.useJobs(app, conn);
 *     gebweb.registerJobHandlers(app, [WelcomeMailer()]);
 *
 * Producer (enqueue from a controller):
 *
 *     gebweb.enqueue(app, "welcome-email", {"to": user.email});
 *
 * Handler class:
 *
 *     class WelcomeMailer {
 *         @Job("welcome-email")
 *         func send(gebweb.Job job): void {
 *             let to = job.payload["to"] as string;
 *             // do work; throw to trigger retry.
 *         }
 *     }
 *
 * Worker entry point - call this from a CLI-mode branch of your
 * main.gb (the `gebweb worker` subcommand sets `GEBWEB_RUN=worker`
 * in the environment so you can detect it):
 *
 *     if (sys.getenv("GEBWEB_RUN") == "worker") {
 *         gebweb.runWorker(app);
 *     } else {
 *         gebweb.serve(app, "0.0.0.0:3000");
 *     }
 *
 * Schema:
 *
 *     gebweb_jobs(id TEXT PK, name TEXT, payload_json TEXT,
 *                 run_at TEXT, attempts INTEGER, status TEXT,
 *                 locked_at TEXT, locked_by TEXT, created_at TEXT,
 *                 last_error TEXT)
 *
 * `useJobs` creates the table on first use if it doesn't exist.
 * Status values: pending, running, completed, failed.
 */

import db;
import async;
import gebweb.decorators as gwdec;
import json;
import reflect;
import datetime;
import time;
import sys;
import secrets;

/** Per-app jobs configuration: the DB connection, poll interval,
 *  retry policy, and the registry of name -> {handler, instance}
 *  pairs populated by registerJobHandlers. */
export class JobConfig {
    db.Connection conn;
    int pollIntervalMs;
    int maxAttempts;
    list<int> backoffMs;
    /* Handler registry keyed by job name. Each entry is a dict
     * {"instance": any, "method": callable}. */
    dict<string, dict<string, any>> handlers;

    func JobConfig(db.Connection conn) {
        this.conn = conn;
        this.pollIntervalMs = 1000;
        this.maxAttempts = 5;
        this.backoffMs = [1000, 5000, 30000, 120000, 600000];
        this.handlers = {};
    }
}

/** A Job context passed to a handler. Carries the row's id, name,
 *  payload, the attempt count (1-based for the current attempt),
 *  and a back-reference to the GebwebApp so handlers can resolve
 *  DI bindings via `gebweb.resolve(job.app, SomeService)`. */
export class Job {
    string id;
    string name;
    dict<string, any> payload;
    int attempts;
    any app;

    func Job(string id, string name, dict<string, any> payload, int attempts, any app) {
        this.id = id;
        this.name = name;
        this.payload = payload;
        this.attempts = attempts;
        this.app = app;
    }
}

/**
 * Build a job queue config backed by `conn`. Auto-creates the
 * `gebweb_jobs` table if it doesn't exist. Options:
 *   - pollIntervalMs (default 1000): worker sleep between polls
 *   - maxAttempts (default 5): retry ceiling per job
 *   - backoffMs (default [1s, 5s, 30s, 2m, 10m]): per-retry delay
 *
 * Most users go through the facade helper `gebweb.useJobs(app,
 * conn, opts)` which attaches the resulting config to the app.
 */
export func newConfig(db.Connection conn, dict<string, any> opts): JobConfig {
    let cfg = JobConfig(conn);
    if (opts.contains("pollIntervalMs")) {
        cfg.pollIntervalMs = opts["pollIntervalMs"] as int;
    }
    if (opts.contains("maxAttempts")) {
        cfg.maxAttempts = opts["maxAttempts"] as int;
    }
    if (opts.contains("backoffMs")) {
        cfg.backoffMs = opts["backoffMs"] as list<int>;
    }
    ensureSchema(conn);
    return cfg;
}

/**
 * Walk each provided handler instance, find every method decorated
 * with `@Job("name")`, and register it. Multiple classes may
 * supply handlers - they are merged into a single registry.
 */
export func registerHandlers(JobConfig config, list<any> instances): void {
    for (instance in instances) {
        let cls = reflect.class(instance);
        for (name in reflect.methods(cls)) {
            let methodRef = reflect.method(instance, name as string);
            let meta = jobMetaOf(methodRef);
            if (meta == null) {
                continue;
            }
            let m = meta as dict<string, any>;
            let named = m["named"] as dict<string, any>;
            config.handlers[m["name"] as string] = {
                "instance": instance,
                "method": methodRef,
                "priority": named.contains("priority") ? named["priority"] : "default",
                "unique": named.contains("unique") ? named["unique"] : null,
                "retry": named.contains("retry") ? named["retry"] : null,
                "timeoutMs": named.contains("timeoutMs") ? (named["timeoutMs"] as int) : 0
            };
        }
    }
}

/** Read the `@Job("name", ...named)` decorator from a method as
 *  {name, named}, or null when the method isn't a job handler. */
func jobMetaOf(any method): ?dict<string, any> {
    for (decoratorValue in gwdec.decoratorsOf(method)) {
        let dec = decoratorValue as dict<string, any>;
        if ((dec["name"] as string) == "Job") {
            let args = dec["args"] as list<any>;
            if (args.length() > 0 && args[0] instanceof string) {
                let named = dec.contains("namedArgs") ? (dec["namedArgs"] as dict<string, any>) : {};
                return {"name": args[0] as string, "named": named};
            }
        }
    }
    return null;
}

/**
 * Insert a job row. `runAt` (optional unix seconds) lets the
 * caller schedule the job for the future; default is "now".
 * Returns the new job id.
 */
export func enqueue(JobConfig config, string name, dict<string, any> payload, dict<string, any> opts): string {
    string id = secrets.randomHex(16);
    int runAt = opts.contains("runAt") ? (opts["runAt"] as int) : datetime.nowUnix();
    string payloadJson = json.stringify(payload);
    string now = nowString();
    string priority = opts.contains("priority") ? (opts["priority"] as string) : handlerPriority(config, name);
    ?string dedupeKey = computeDedupeKey(config, name, payload, opts);
    if (dedupeKey != null) {
        ?string existing = activeDedupeId(config, name, dedupeKey as string);
        if (existing != null) {
            return existing as string;
        }
    }
    try {
        config.conn.exec(
            "INSERT INTO gebweb_jobs (id, name, payload_json, run_at, attempts, status, priority, dedupe_key, created_at) VALUES (?, ?, ?, ?, 0, 'pending', ?, ?, ?)",
            id, name, payloadJson, unixToString(runAt), priority, dedupeKey, now
        );
    } catch (Error e) {
        /* A concurrent enqueue won the dedupe race (the partial unique index
         * rejected this insert); return the row it created. */
        if (dedupeKey != null) {
            ?string existing = activeDedupeId(config, name, dedupeKey as string);
            if (existing != null) {
                return existing as string;
            }
        }
        throw e;
    }
    return id;
}

/** Resolve the dedupe key for an enqueue: `opts.unique` overrides the
 *  handler's `@Job(unique:)`. A "$payload.field" spec reads that field
 *  from the payload (null when absent, so no dedupe); any other value is
 *  a literal key. Returns null when no uniqueness is declared. */
func computeDedupeKey(JobConfig config, string name, dict<string, any> payload, dict<string, any> opts): ?string {
    any spec = null;
    if (opts.contains("unique")) {
        spec = opts["unique"];
    } else if (config.handlers.contains(name)) {
        let h = config.handlers[name] as dict<string, any>;
        if (h.contains("unique") && h["unique"] != null) {
            spec = h["unique"];
        }
    }
    if (spec == null) {
        return null;
    }
    string s = spec as string;
    if (s.startsWith("$payload.")) {
        string field = s.removePrefix("$payload.");
        return payload.contains(field) ? "${payload[field]}" : null;
    }
    return s;
}

/** The id of an active (pending or running) job with this name and dedupe
 *  key, or null. A completed/failed job does not block re-enqueue. */
func activeDedupeId(JobConfig config, string name, string dedupeKey): ?string {
    let rows = config.conn.query(
        "SELECT id FROM gebweb_jobs WHERE name = ? AND dedupe_key = ? AND status IN ('pending', 'running') LIMIT 1",
        name, dedupeKey
    ).all();
    if (rows.length() == 0) {
        return null;
    }
    return (rows[0] as dict<string, any>)["id"] as string;
}

/** The priority declared by the @Job handler for `name`, or "default"
 *  when no handler is registered in this config. Producers can override
 *  it with `opts.priority` at enqueue time. */
func handlerPriority(JobConfig config, string name): string {
    if (config.handlers.contains(name)) {
        let h = config.handlers[name] as dict<string, any>;
        if (h.contains("priority")) {
            return h["priority"] as string;
        }
    }
    return "default";
}

/**
 * Run the worker loop. Blocks until the process is killed (or until
 * `opts.maxJobs` jobs have been processed - useful for tests). Each
 * iteration claims one pending job whose `run_at <= now`, executes
 * its handler, and writes the outcome back.
 *
 * Options:
 *   - maxJobs (default -1, run forever): stop after N completed/failed jobs
 *   - workerId (default "<hostname>:<pid>"): tag for locked_by
 */
export func runWorker(any app, JobConfig config, dict<string, any> opts): void {
    /* Two modes:
     *   - Production (default): block forever, sleep between polls.
     *   - Drain mode: process every pending job (including chains
     *     enqueued by other handlers during the drain) then return.
     *     Triggered by `opts.drainOnce: true` or by setting
     *     `opts.maxJobs` (a safety cap on the number of jobs
     *     processed; mostly relevant if a handler keeps re-
     *     enqueueing itself). Stop only when the queue is empty
     *     OR the cap is hit. */
    bool drainOnce = opts.contains("drainOnce") ? (opts["drainOnce"] as bool) : opts.contains("maxJobs");
    int maxJobs = opts.contains("maxJobs") ? (opts["maxJobs"] as int) : -1;
    string workerId = opts.contains("workerId") ? (opts["workerId"] as string) : (sys.hostname() + ":" + (sys.pid() as string));
    /* schedulerTick: optional callback invoked between job polls
     * so the scheduler can fire due tasks under leader election.
     * Plumbed in by the facade so jobs.gb doesn't have to import
     * gebweb.scheduler (which would form a cycle once scheduler
     * grows). */
    ?callable schedulerTick = opts.contains("schedulerTick") ? (opts["schedulerTick"] as callable) : null;
    /* Name filter: when set, only jobs whose `name` column appears
     * in the list are claimed. Lets one worker process drain a
     * subset of work so different servers can specialise. */
    list<string> nameFilter = opts.contains("names") ? (opts["names"] as list<string>) : [];
    list<string> queues = opts.contains("queues") ? (opts["queues"] as list<string>) : ["high", "default", "low"];
    int processed = 0;
    while (true) {
        if (schedulerTick != null) {
            (schedulerTick as callable)();
        }
        let job = claimNextJob(config, workerId, nameFilter, queues);
        if (job == null) {
            if (drainOnce) {
                /* Queue is empty AND no handler is still re-
                 * enqueueing - we're done. */
                return;
            }
            time.sleep(config.pollIntervalMs);
            continue;
        }
        executeJob(app, config, job as Job);
        processed = processed + 1;
        if (maxJobs >= 0 && processed >= maxJobs) {
            return;
        }
    }
}

/* Build an IN-clause query for the name-filtered case. SQL drivers
 * handle list-valued parameters inconsistently across backends, so
 * the placeholder string is composed by hand. Values still travel
 * as parameters, never spliced into the SQL. */
/** Claim the next due pending job, draining the `queues` priorities in
 *  order: every job at a higher-priority queue is taken before any lower
 *  one. `nameFilter` (when non-empty) restricts to jobs whose name is in
 *  the list. Returns null when nothing is due right now. */
func claimNextJob(JobConfig config, string workerId, list<string> nameFilter, list<string> queues): ?Job {
    string now = nowString();
    for (priority in queues) {
        let job = claimFromQueue(config, workerId, now, priority as string, nameFilter);
        if (job != null) {
            return job;
        }
    }
    return null;
}

/** Select then conditionally claim one pending job at `priority`. The
 *  conditional UPDATE is the multi-worker safety: if another worker took
 *  the row between SELECT and UPDATE, rowsAffected is 0 and we return null. */
func claimFromQueue(JobConfig config, string workerId, string now, string priority, list<string> nameFilter): ?Job {
    string sql = "SELECT id, name, payload_json, attempts FROM gebweb_jobs "
               + "WHERE status = 'pending' AND run_at <= ? AND priority = ?";
    list<any> params = [now, priority];
    if (nameFilter.length() > 0) {
        string placeholders = "";
        for (i in 0..<nameFilter.length()) {
            if (i > 0) { placeholders = placeholders + ","; }
            placeholders = placeholders + "?";
            params = params.push(nameFilter[i]);
        }
        sql = sql + " AND name IN (" + placeholders + ")";
    }
    sql = sql + " ORDER BY run_at LIMIT 1";
    let rows = config.conn.query(sql, ...params).all();
    if (rows.length() == 0) {
        return null;
    }
    let row = rows[0] as dict<string, any>;
    string id = row["id"] as string;
    let result = config.conn.exec(
        "UPDATE gebweb_jobs SET status = 'running', locked_at = ?, locked_by = ?, attempts = attempts + 1 WHERE id = ? AND status = 'pending'",
        now, workerId, id
    );
    let affected = (result as dict<string, any>)["rowsAffected"];
    if (affected == null || (affected as int) == 0) {
        return null;
    }
    let payload = json.parse(row["payload_json"] as string) as dict<string, any>;
    int newAttempts = (row["attempts"] as int) + 1;
    return Job(id, row["name"] as string, payload, newAttempts, null);
}

/** Invoke the handler for a claimed job. Marks completed on
 *  success; on exception, schedules a retry with exponential
 *  backoff or marks 'failed' once attempts hit maxAttempts. */
func executeJob(any app, JobConfig config, Job job): void {
    job.app = app;
    let entry = config.handlers[job.name];
    if (entry == null) {
        markFailed(config, job, "no handler registered for job '" + job.name + "'");
        return;
    }
    let h = entry as dict<string, any>;
    let dispatch = h["method"] as callable;
    any retryCfg = h.contains("retry") ? h["retry"] : null;
    int timeoutMs = h.contains("timeoutMs") ? (h["timeoutMs"] as int) : 0;
    try {
        runDispatch(dispatch, job, timeoutMs);
        markCompleted(config, job);
    } catch (Error e) {
        string message = e.message;
        if (job.attempts >= retryMaxAttempts(retryCfg, config)) {
            markFailed(config, job, message);
        } else {
            scheduleRetry(config, job, message, retryCfg);
        }
    }
}

/** The attempt ceiling for a handler: `@Job(retry: {maxAttempts})` when set,
 *  else the queue-wide `config.maxAttempts`. */
func retryMaxAttempts(any retryCfg, JobConfig config): int {
    if (retryCfg != null && retryCfg instanceof dict) {
        let r = retryCfg as dict<string, any>;
        if (r.contains("maxAttempts")) {
            return r["maxAttempts"] as int;
        }
    }
    return config.maxAttempts;
}

/** The delay before the next retry, in ms. A callable `retry` is called with
 *  the attempt number; a dict `retry` uses its `backoff` strategy (fixed /
 *  linear / exponential over `baseMs`, default 1000); otherwise the queue-wide
 *  `backoffMs` list applies. */
func retryDelayMs(any retryCfg, JobConfig config, int attempt): int {
    if (retryCfg != null) {
        if (retryCfg instanceof dict) {
            let r = retryCfg as dict<string, any>;
            if (r.contains("backoff")) {
                int base = r.contains("baseMs") ? (r["baseMs"] as int) : 1000;
                string strategy = r["backoff"] as string;
                if (strategy == "fixed") { return base; }
                if (strategy == "linear") { return base * attempt; }
                if (strategy == "exponential") {
                    int mult = 1;
                    for (int i = 1; i < attempt; i++) { mult = mult * 2; }
                    return base * mult;
                }
            }
        } else {
            return (retryCfg as callable)(attempt) as int;
        }
    }
    int idx = attempt - 1;
    if (idx < 0) { idx = 0; }
    if (idx >= config.backoffMs.length()) { idx = config.backoffMs.length() - 1; }
    return config.backoffMs[idx];
}

/** Run a handler, optionally under a cooperative deadline: when timeoutMs > 0
 *  the call is raced against the deadline, and on expiry it throws while the
 *  handler's own work finishes in the background (not forcibly interrupted). */
func runDispatch(callable dispatch, Job job, int timeoutMs): void {
    if (timeoutMs <= 0) {
        dispatch(job);
        return;
    }
    await async.timeout(async.run(func(): any { dispatch(job); return null; }), timeoutMs);
}

func markCompleted(JobConfig config, Job job): void {
    config.conn.exec(
        "UPDATE gebweb_jobs SET status = 'completed', locked_at = NULL, locked_by = NULL, last_error = NULL WHERE id = ?",
        job.id
    );
}

func markFailed(JobConfig config, Job job, string message): void {
    config.conn.exec(
        "UPDATE gebweb_jobs SET status = 'failed', locked_at = NULL, locked_by = NULL, last_error = ? WHERE id = ?",
        message, job.id
    );
}

func scheduleRetry(JobConfig config, Job job, string message, any retryCfg): void {
    int delayMs = retryDelayMs(retryCfg, config, job.attempts);
    int retryAt = datetime.nowUnix() + (delayMs // 1000);
    config.conn.exec(
        "UPDATE gebweb_jobs SET status = 'pending', run_at = ?, locked_at = NULL, locked_by = NULL, last_error = ? WHERE id = ?",
        unixToString(retryAt), message, job.id
    );
}

/* --- schema / state accessors --- */

func ensureSchema(db.Connection conn): void {
    conn.exec(
        "CREATE TABLE IF NOT EXISTS gebweb_jobs (" +
        "id TEXT PRIMARY KEY, " +
        "name TEXT NOT NULL, " +
        "payload_json TEXT NOT NULL, " +
        "run_at TEXT NOT NULL, " +
        "attempts INTEGER NOT NULL DEFAULT 0, " +
        "status TEXT NOT NULL DEFAULT 'pending', " +
        "priority TEXT NOT NULL DEFAULT 'default', " +
        "dedupe_key TEXT, " +
        "locked_at TEXT, " +
        "locked_by TEXT, " +
        "created_at TEXT NOT NULL, " +
        "last_error TEXT" +
        ")"
    );
    addColumnIfMissing(conn, "gebweb_jobs", "priority TEXT NOT NULL DEFAULT 'default'");
    addColumnIfMissing(conn, "gebweb_jobs", "dedupe_key TEXT");
    conn.exec("CREATE INDEX IF NOT EXISTS gebweb_jobs_claim_idx ON gebweb_jobs (status, priority, run_at)");
    /* Race backstop on backends that support partial indexes (sqlite, pg);
     * MySQL has no partial index, so the app-level guard in enqueue is the
     * portable correctness path. */
    try {
        conn.exec("CREATE UNIQUE INDEX IF NOT EXISTS gebweb_jobs_dedupe_idx ON gebweb_jobs (name, dedupe_key) "
            + "WHERE dedupe_key IS NOT NULL AND status IN ('pending', 'running')");
    } catch (Error e) {
    }
}

/* Idempotent ADD COLUMN so a table created by an older version gains new
 * columns; the duplicate-column error when it already has them is expected. */
func addColumnIfMissing(db.Connection conn, string table, string columnDef): void {
    try {
        conn.exec("ALTER TABLE " + table + " ADD COLUMN " + columnDef);
    } catch (Error e) {
    }
}

/* --- time helpers --- */

func nowString(): string {
    return unixToString(datetime.nowUnix());
}

func unixToString(int unix): string {
    return datetime.formatRFC3339(unix);
}

/* --- inspection helpers (used by tests + ad-hoc dashboards) --- */

/** Returns the row for a given job id, or null. */
export func get(JobConfig config, string id): ?dict<string, any> {
    let rows = config.conn.query(
        "SELECT id, name, payload_json, run_at, attempts, status, priority, locked_at, locked_by, created_at, last_error FROM gebweb_jobs WHERE id = ?",
        id
    ).all();
    if (rows.length() == 0) { return null; }
    return rows[0] as dict<string, any>;
}

/** Returns pending+completed+failed counts. Useful for dashboards. */
export func stats(JobConfig config): dict<string, int> {
    let rows = config.conn.query(
        "SELECT status, COUNT(*) AS c FROM gebweb_jobs GROUP BY status"
    ).all();
    dict<string, int> out = {"pending": 0, "completed": 0, "failed": 0, "running": 0};
    for (row in rows) {
        let r = row as dict<string, any>;
        out[r["status"] as string] = r["c"] as int;
    }
    return out;
}
