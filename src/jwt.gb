module gebweb.jwt;
import crypt;
import math;
import time;

func unixSeconds(): int {
    return math.floor(time.now() / 1000) as int;
}

export func issue(any key, dict<string, any> claims, int ttlSeconds, dict<string, any> opts = {}): string {
    int nowSec = unixSeconds();
    dict<string, any> body = {"iat": nowSec};
    if (ttlSeconds > 0) {
        body["exp"] = nowSec + ttlSeconds;
    }
    for (name in claims.keys()) {
        body[name] = claims[name];
    }
    string alg = (opts["alg"] ?? "HS256") as string;
    if (!supportedAlgorithm(alg)) {
        throw ValueError("jwt.issue: unsupported signing algorithm");
    }
    return crypt.jwtSign(body, key, opts);
}

export func verify(any key, string token, dict<string, any> opts = {}): ?dict<string, any> {
    return verifyAt(key, token, unixSeconds(), opts);
}

export func verifyAt(any key, string token, int nowSec, dict<string, any> opts = {}): ?dict<string, any> {
    validateOptions(opts);
    int leeway = (opts["leewaySeconds"] ?? 0) as int;
    let payload = crypt.jwtVerify(token, key, opts);
    if (!(payload instanceof dict)) {
        return null;
    }
    let claims = payload as dict<string, any>;
    for (name in ["sub", "iss", "jti"]) {
        if (claims.contains(name) && (!(claims[name] instanceof string) || (claims[name] as string).isEmpty())) {
            return null;
        }
    }
    for (name in ["exp", "nbf", "iat"]) {
        if (claims.contains(name) && !(claims[name] instanceof int)) {
            return null;
        }
    }
    if (claims.contains("exp") && (claims["exp"] as int) <= nowSec - leeway) {
        return null;
    }
    if (claims.contains("nbf") && (claims["nbf"] as int) > nowSec + leeway) {
        return null;
    }
    for (name in ((opts["requiredClaims"] ?? []) as list<string>)) {
        if (!claims.contains(name) || claims[name] == null) {
            return null;
        }
    }
    if (opts.contains("issuer") && (claims["iss"] ?? null) != opts["issuer"]) {
        return null;
    }
    let aud = claims["aud"] ?? null;
    if (claims.contains("aud")) {
        if (aud instanceof list) {
            if ((aud as list<any>).isEmpty()) {
                return null;
            }
            for (entry in aud as list<any>) {
                if (!(entry instanceof string) || (entry as string).isEmpty()) {
                    return null;
                }
            }
        } else if (!(aud instanceof string) || (aud as string).isEmpty()) {
            return null;
        }
    }
    if (opts.contains("audience")) {
        if (aud instanceof list) {
            if (!(aud as list<any>).contains(opts["audience"])) {
                return null;
            }
        } else if (aud != opts["audience"]) {
            return null;
        }
    }
    if (opts.contains("maxAgeSeconds")) {
        int maxAge = opts["maxAgeSeconds"] as int;
        if (maxAge < 0) {
            throw ValueError("jwt.verify: maxAgeSeconds must be nonnegative");
        }
        if (!claims.contains("iat")
            || (claims["iat"] as int) > nowSec + leeway
            || nowSec - (claims["iat"] as int) >= maxAge + leeway) {
            return null;
        }
    }
    return claims;
}

export func validateOptions(dict<string, any> opts): void {
    int leeway = (opts["leewaySeconds"] ?? 0) as int;
    if (leeway < 0) {
        throw ValueError("jwt.verify: leewaySeconds must be nonnegative");
    }
    if (opts.contains("allowedAlgs")) {
        let algorithms = opts["allowedAlgs"] as list<string>;
        if (algorithms.isEmpty()) {
            throw ValueError("jwt.verify: allowedAlgs must not be empty");
        }
        for (alg in algorithms) {
            if (!supportedAlgorithm(alg)) {
                throw ValueError("jwt.verify: unsupported verification algorithm");
            }
        }
    }
    for (name in ["issuer", "audience"]) {
        if (opts.contains(name) && (!(opts[name] instanceof string) || (opts[name] as string).isEmpty())) {
            throw ValueError("jwt.verify: issuer and audience must be nonempty strings");
        }
    }
    if (opts.contains("maxAgeSeconds") && (opts["maxAgeSeconds"] as int) < 0) {
        throw ValueError("jwt.verify: maxAgeSeconds must be nonnegative");
    }
    for (name in ((opts["requiredClaims"] ?? []) as list<string>)) {
        if (name.isEmpty()) {
            throw ValueError("jwt.verify: required claim names must not be empty");
        }
    }
}

func supportedAlgorithm(string alg): bool {
    return [
        "HS256",
        "HS384",
        "HS512",
        "RS256",
        "RS384",
        "RS512",
        "ES256",
        "ES384",
        "ES512",
        "EdDSA",
    ].contains(alg);
}

/* Decoding alone never establishes an authenticated identity. */
export func decode(string token): ?dict<string, any> {
    try {
        let parts = crypt.jwtDecode(token) as dict<string, any>;
        return parts["payload"] as dict<string, any>;
    } catch (Error e) {
        return null;
    }
}
