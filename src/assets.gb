/**
 * Static-asset pipeline with content-hash fingerprinting and a
 * long-cache route. Two modes:
 *   - prod (default): build the fingerprint map once at startup;
 *     immutable across the process lifetime.
 *   - dev (opts.dev = true): serve plain logical URLs (no hash) that
 *     map straight to the source file, so edits show up live without
 *     a restart or per-request manifest recompute.
 *
 * View helper `{{ asset("foo.css") }}` returns the fingerprinted
 * URL (`/assets/foo-<hash>.css`).
 */
import path;
import io;
import sys;
import crypt;
import web.http as http;
import gebweb.views as viewsmod;

/**
 * Per-app asset config. Holds the source directory, the URL
 * prefix, response cache header, and the cached manifest.
 */
export class AssetConfig {
    string sourceDir;
    string urlPrefix;
    any cacheControl;
    bool precompressed;
    bool fingerprint;
    bool dev;
    bool middleware;
    string realRoot;                   /* sourceDir with symlinks resolved once; "" if unresolved */
    dict<string, string> manifest;     /* logical -> fingerprinted basename */
    dict<string, string> reverseMap;   /* fingerprinted -> source path on disk */

    func AssetConfig(string sourceDir, dict<string, any> opts) {
        /* Built binaries read the embedded copy under the bundle extract dir; dev reads from disk. */
        this.sourceDir = viewsmod.bundledPath(sys.bundleDir(), sourceDir);
        this.urlPrefix = opts.contains("urlPrefix") ? (opts["urlPrefix"] as string) : "/assets";
        this.cacheControl = opts["cacheControl"] ?? "public, max-age=31536000, immutable";
        if (!(this.cacheControl instanceof string) && !(this.cacheControl instanceof callable)) {
            throw ValueError("asset cacheControl must be a string or callable");
        }
        this.precompressed = (opts["precompressed"] ?? false) as bool;
        this.fingerprint = !opts.contains("fingerprint") || (opts["fingerprint"] as bool);
        this.dev = opts.contains("dev") && (opts["dev"] as bool);
        this.middleware = !opts.contains("middleware") || (opts["middleware"] as bool);
        this.realRoot = resolveReal(this.sourceDir);
        this.manifest = {};
        this.reverseMap = {};
    }
}

/* Resolve symlinks once; empty when the path cannot be resolved (missing dir). */
func resolveReal(string p): string {
    try {
        return path.real(p);
    } catch (Error e) {
        return "";
    }
}

export func newConfig(string sourceDir, dict<string, any> opts): AssetConfig {
    let cfg = AssetConfig(sourceDir, opts);
    if (cfg.fingerprint && !cfg.dev) {
        buildManifest(cfg);
    }
    return cfg;
}

/* Prod: fingerprint every file once at setup so manifest/reverseMap are read-only during serving (no lazy per-request write under concurrency). */
func buildManifest(AssetConfig cfg): void {
    if (!io.exists(cfg.sourceDir)) {
        return;
    }
    let prefix = cfg.sourceDir + "/";
    for (entry in io.walkDir(cfg.sourceDir)) {
        let e = entry as dict<string, any>;
        if (e["isDir"] as bool) {
            continue;
        }
        let full = e["path"] as string;
        if (!full.startsWith(prefix)) {
            continue;
        }
        fingerprintOne(cfg, full.substring(prefix.length()));
    }
}

/**
 * Look up a logical name in the setup-time fingerprint manifest.
 * Missing names fall back to the logical URL without changing the manifest.
 */
export func assetUrl(AssetConfig cfg, string logical): string {
    /* Dev returns the logical URL (no fingerprint): assets stay hot-reloadable and no shared manifest/reverseMap is mutated per request (which would race across concurrent renders). */
    if (!cfg.fingerprint || cfg.dev) {
        return cfg.urlPrefix + "/" + logical;
    }
    if (cfg.manifest.contains(logical)) {
        return cfg.urlPrefix + "/" + cfg.manifest[logical];
    }
    return cfg.urlPrefix + "/" + logical;
}

/**
 * Build a request handler for the asset URL prefix. Reads the file
 * from disk, returns it with the configured cache headers. 404 for
 * unknown / unfingerprinted requests in prod mode; dev mode allows
 * raw (non-fingerprinted) names through too.
 */
/* Serve one static asset. Plain function (no per-request closure) so the dispatcher can call it directly. */
export func serveAsset(AssetConfig cfg, dict<string, any> request): dict<string, any> {
    let method = (request["method"] ?? "GET") as string;
    if (method != "GET" && method != "HEAD") {
        return {"status": 405, "headers": {"Allow": "GET, HEAD"}, "body": ""};
    }
    string fullPath = request["path"] as string;
    if (!fullPath.startsWith(cfg.urlPrefix + "/")) {
        return notFound();
    }
    string rest = fullPath.substring(cfg.urlPrefix.length() + 1);
    string sourceFile = resolveSourceFile(cfg, rest);
    string contentType = guessMimeType(sourceFile);
    string packedCandidate = sourceFile + ".gz";
    sourceFile = containedPath(cfg, sourceFile);
    if (sourceFile.isEmpty() || !(io.stat(sourceFile)["isFile"] as bool)) {
        return notFound();
    }
    let policy = cfg.cacheControl;
    let cacheControl = policy instanceof callable ? policy(rest) as string : policy as string;
    dict<string, any> headers = {
        "Content-Type": contentType,
        "Cache-Control": cacheControl,
    };
    if (cfg.precompressed) {
        headers["Vary"] = "Accept-Encoding";
        let packed = containedPath(cfg, packedCandidate);
        if (!packed.isEmpty() && (io.stat(packed)["isFile"] as bool) && freshSidecar(sourceFile, packed)
                && acceptsGzip(request)) {
            headers["Content-Encoding"] = "gzip";
            return http.serveFile(packed, {"headers": headers});
        }
    }
    return http.serveFile(sourceFile, {"headers": headers});
}

/* Bundle extraction times describe extraction order, not source freshness. */
func freshSidecar(string source, string packed): bool {
    let bundled = sys.bundleDir();
    if (!bundled.isEmpty() && source.startsWith(bundled + "/")) { return true; }
    return (io.stat(packed)["modUnixNano"] as int) >= (io.stat(source)["modUnixNano"] as int);
}

/* An explicit gzip;q=0 overrides a wildcard acceptance. */
func acceptsGzip(dict<string, any> request): bool {
    string accept = "";
    for (name, value in (request["headers"] ?? {}) as dict<string, any>) {
        if (name.lower() == "accept-encoding") { accept = "${value}"; }
    }
    decimal wildcard = 0;
    ?decimal gzip = null;
    for (item in accept.lower().split(",")) {
        let parts = item.split(";");
        let coding = parts[0].trim();
        decimal quality = 1;
        for (parameter in parts.slice(1)) {
            let pair = parameter.trim().split("=");
            if (pair.length() == 2 && pair[0].trim() == "q") {
                quality = pair[1].trim().toDecimalOrNull() ?? 0;
                if (quality < 0 || quality > 1) { quality = 0; }
            }
        }
        if (coding == "gzip") { gzip = quality; }
        if (coding == "*") { wildcard = quality; }
    }
    return (gzip ?? wildcard) > 0;
}

export func makeAssetHandler(AssetConfig cfg): callable {
    return func(dict<string, any> request): dict<string, any> {
        return serveAsset(cfg, request);
    };
}

func fingerprintOne(AssetConfig cfg, string logical): string {
    let sourceFile = cfg.sourceDir + "/" + logical;
    let checkedFile = containedPath(cfg, sourceFile);
    if (checkedFile.isEmpty() || !(io.stat(checkedFile)["isFile"] as bool)) {
        return "";
    }
    let content = io.readBytes(checkedFile);
    let digest = crypt.sha256(content);
    let shortHash = digest.substring(0, 8);
    /* foo/bar.css -> foo/bar-<hash>.css */
    let basename = path.base(logical);
    let dirname = path.dir(logical);
    let dot = basename.lastIndexOf(".");
    string fingerprintedBasename = "";
    if (dot >= 0) {
        fingerprintedBasename = basename.substring(0, dot) + "-" + shortHash + basename.substring(dot);
    } else {
        fingerprintedBasename = basename + "-" + shortHash;
    }
    string fingerprinted = dirname == "." || dirname.isEmpty() ? fingerprintedBasename : dirname + "/" + fingerprintedBasename;
    cfg.manifest[logical] = fingerprinted;
    cfg.reverseMap[fingerprinted] = sourceFile;
    return fingerprinted;
}

func resolveSourceFile(AssetConfig cfg, string requestedPath): string {
    if (cfg.reverseMap.contains(requestedPath)) {
        return cfg.reverseMap[requestedPath];
    }
    if (cfg.dev || !cfg.fingerprint) {
        /* Dev and unfingerprinted prod serve logical names directly from sourceDir. */
        let raw = cfg.sourceDir + "/" + requestedPath;
        if (io.exists(raw)) {
            return raw;
        }
    }
    return "";
}

/* Keep the checked canonical path so later callbacks cannot redirect a symlink. */
func containedPath(AssetConfig cfg, string target): string {
    if (cfg.realRoot.isEmpty() || target.isEmpty()) {
        return "";
    }
    let realTarget = resolveReal(target);
    if (!realTarget.isEmpty() && (realTarget == cfg.realRoot || realTarget.startsWith(cfg.realRoot + "/"))) {
        return realTarget;
    }
    return "";
}

func notFound(): dict<string, any> {
    return {"status": 404, "body": "not found", "headers": {"Content-Type": "text/plain"}};
}

func guessMimeType(string path): string {
    let lower = path.lower();
    if (lower.endsWith(".css")) { return "text/css"; }
    if (lower.endsWith(".js")) { return "application/javascript"; }
    if (lower.endsWith(".png")) { return "image/png"; }
    if (lower.endsWith(".jpg") || lower.endsWith(".jpeg")) { return "image/jpeg"; }
    if (lower.endsWith(".gif")) { return "image/gif"; }
    if (lower.endsWith(".svg")) { return "image/svg+xml"; }
    if (lower.endsWith(".webp")) { return "image/webp"; }
    if (lower.endsWith(".ico")) { return "image/x-icon"; }
    if (lower.endsWith(".woff")) { return "font/woff"; }
    if (lower.endsWith(".woff2")) { return "font/woff2"; }
    if (lower.endsWith(".ttf")) { return "font/ttf"; }
    if (lower.endsWith(".txt")) { return "text/plain"; }
    if (lower.endsWith(".html")) { return "text/html"; }
    if (lower.endsWith(".json")) { return "application/json"; }
    return "application/octet-stream";
}
