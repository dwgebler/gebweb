/**
 * @title gebweb secret store: pluggable SecretsProvider interface
 * plus an encrypted-file built-in implementation.
 *
 * `gebweb.useSecrets(app, provider)` wires a provider onto the app
 * so `%secret(...)%` markers in YAML parameters resolve. Users can
 * supply their own implementation (AWS Secrets Manager, Vault, etc.)
 * or use the bundled `EncryptedFileSecretsProvider`, which reads a
 * PEM-style file written by `gebweb secrets edit` and decrypts it
 * with AES-256-GCM. File name is `secretstore.gb` (not `secrets.gb`)
 * to avoid shadowing the stdlib `secrets` module from inside gebweb.
 */
module gebweb.secretstore;

import bytes;
import json;
import crypt;
import io;
import sys;

let BEGIN_MARKER = "-----BEGIN GEBWEB SECRETS-----";
let END_MARKER = "-----END GEBWEB SECRETS-----";
let CHUNK_WIDTH = 80;
let NONCE_SIZE = 12;
let ENV_VAR = "GEBWEB_SECRETS_KEY";
let DEFAULT_KEY_PATH = "config/secrets.key";

/**
 * Contract a secrets provider must implement. `getSecret` returns
 * the value or throws RuntimeError if the name is unknown.
 * `hasSecret` is a non-throwing existence probe.
 */
export interface SecretsProvider {
    func getSecret(string name): string;
    func hasSecret(string name): bool;
}

/**
 * Built-in provider that decrypts a single PEM-style file on first
 * use. Wire format: AES-256-GCM over the JSON-encoded `{name: value}`
 * dict, output as `nonce || ciphertext`, base64-encoded, chunked at
 * 80 chars, wrapped in `-----BEGIN GEBWEB SECRETS-----` / END marker.
 * The key is 32 raw bytes (typically base64-decoded from
 * `config/secrets.key` or the `GEBWEB_SECRETS_KEY` env var).
 */
export class EncryptedFileSecretsProvider implements SecretsProvider {
    string filePath;
    bytes key;
    ?dict<string, any> cache;

    func EncryptedFileSecretsProvider(string filePath, bytes key) {
        validateKey(key);
        this.filePath = filePath;
        this.key = key;
        this.cache = null;
    }

    func getSecret(string name): string {
        let secrets = this.loadIfNeeded();
        if (!secrets.contains(name)) {
            throw RuntimeError("gebweb secrets: unknown secret '" + name + "'");
        }
        return secrets[name] as string;
    }

    func hasSecret(string name): bool {
        return this.loadIfNeeded().contains(name);
    }

    func loadIfNeeded(): dict<string, any> {
        if (this.cache != null) { return this.cache as dict<string, any>; }
        if (!io.exists(this.filePath)) {
            throw RuntimeError("gebweb secrets: secrets file not found at " + this.filePath);
        }
        let text = io.readText(this.filePath);
        let plaintext = decryptFile(text, this.key);
        let parsed = json.parse(plaintext) as dict<string, any>;
        this.cache = parsed;
        return parsed;
    }
}

/**
 * Convenience factory. Reads the key via `loadKey()`:
 * GEBWEB_SECRETS_KEY env var always wins when set; otherwise the
 * default key path. Throws if neither source is available.
 */
export func encryptedFileSecrets(string filePath = "config/secrets.enc"): EncryptedFileSecretsProvider {
    /* `""` picks the default key path; Geblang default-arg dispatch
     * can't be elided in a positional call expression. */
    return EncryptedFileSecretsProvider(filePath, loadKey(""));
}

/**
 * Resolves the AES-256 key. Precedence: `GEBWEB_SECRETS_KEY` env
 * var (base64) wins when set, even if `keyPath` is supplied; this
 * lets prod deployments override file-shipped defaults. Falls back
 * to `keyPath` (or `config/secrets.key`) read as base64. Pass `""`
 * for `keyPath` to use the default.
 */
export func loadKey(string keyPath = ""): bytes {
    let envKey = sys.getenv(ENV_VAR);
    if (envKey != null && !(envKey as string).isEmpty()) {
        return bytes.fromBase64(envKey as string);
    }
    string p = keyPath.isEmpty() ? DEFAULT_KEY_PATH : keyPath;
    if (!io.exists(p)) {
        throw RuntimeError("gebweb secrets: no key available (set " + ENV_VAR + " or create " + p + ")");
    }
    return bytes.fromBase64(io.readText(p).trim());
}

/**
 * Encrypts the JSON dict of secrets into the PEM-style file body
 * the runtime provider expects. Called by `gebweb secrets edit` /
 * `gebweb secrets set`.
 */
export func encryptSecrets(dict<string, any> secrets, bytes key): string {
    validateKey(key);
    let plaintext = json.stringify(secrets);
    let result = crypt.aesEncrypt(key, plaintext);
    let payload = bytes.concat(result["nonce"] as bytes, result["ciphertext"] as bytes);
    let encoded = bytes.toBase64(payload);
    return BEGIN_MARKER + "\n" + chunkLines(encoded, CHUNK_WIDTH) + "\n" + END_MARKER + "\n";
}

/** Decrypts the PEM-style file body, returning the JSON dict text. */
func decryptFile(string text, bytes key): string {
    let stripped = stripPem(text);
    let payload = bytes.fromBase64(stripped);
    if (payload.length() < NONCE_SIZE) {
        throw RuntimeError("gebweb secrets: ciphertext shorter than nonce");
    }
    let nonce = payload.slice(0, NONCE_SIZE);
    let cipher = payload.slice(NONCE_SIZE, payload.length());
    let plain = crypt.aesDecrypt(key, nonce, cipher);
    return bytes.toString(plain);
}

func validateKey(bytes key): void {
    if (key.length() != 32) {
        throw RuntimeError("gebweb secrets: AES-256 key must be 32 bytes (got " + (key.length() as string) + ")");
    }
}

func stripPem(string text): string {
    int beginIdx = text.indexOf(BEGIN_MARKER);
    int endIdx = text.indexOf(END_MARKER);
    if (beginIdx < 0 || endIdx < 0 || endIdx <= beginIdx) {
        throw RuntimeError("gebweb secrets: file is missing BEGIN/END markers");
    }
    let body = text.substring(beginIdx + BEGIN_MARKER.length(), endIdx);
    /* Body is base64 lines separated by \n; collapse to a single
     * payload string for bytes.fromBase64. */
    return body.split("\n").join("").trim();
}

func chunkLines(string s, int width): string {
    list<string> chunks = [];
    int len = s.length();
    int i = 0;
    while (i < len) {
        int end = i + width;
        if (end > len) { end = len; }
        chunks = chunks.push(s.substring(i, end));
        i = end;
    }
    return chunks.join("\n");
}
