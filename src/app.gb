module gebweb.app;

/**
 * Gebweb application builder. `gebweb.app([controllerInstances])`
 * walks each controller class via reflection, finds methods carrying
 * `@Get`/`@Post`/etc decorators, registers them against an underlying
 * stdlib/web router with FastAPI-style parameter binding wrapped
 * around each method, and mounts SwaggerUI at /docs plus the spec at
 * /openapi.json.
 *
 * Controllers can be passed as already-constructed instances
 * (e.g. `gebweb.app([HelloController()])`) or as class references
 * (`gebweb.app([HelloController])`); class references are
 * instantiated through the DI container with autowired
 * dependencies.
 */

import async.atomic as atomic;
import db;
import errors;
import http;
import io;
import json;
import sys;
import crypt;
import reflect;
import strbuilder;
import sys;
import web.router as webrouter;
import gebweb.errors as weberrors;
import gebweb.request as reqmod;
import gebweb.auth as authmod;
import gebweb.binding as binding;
import gebweb.cache as cachemod;
import gebweb.config as configmod;
import gebweb.csrf as csrfmod;
import gebweb.flash as flashmod;
import gebweb.metrics as metricsmod;
import gebweb.typedconfig as typedconfigmod;
import store as storemod;
import gebweb.i18n as i18nmod;
import gebweb.tenancy as tenancymod;
import gebweb.health as healthmod;
import gebweb.oidc as oidcmod;
import gebweb.webhooks as webhooksmod;
import gebweb.etag as etagmod;
import gebweb.servertiming as servertimingmod;
import gebweb.forms as formsmod;
import gebweb.assets as assetsmod;
import gebweb.decorators as deco;
import gebweb.di as di;
import gebweb.middleware as mwmod;
import gebweb.openapi as openapi;
import gebweb.plugin as pluginmod;
import gebweb.resource as resource;
import gebweb.authz as authzmod;
import gebweb.events as eventsmod;
import gebweb.jobs as jobsmod;
import gebweb.mailing as mailingmod;
import gebweb.messaging as messagingmod;
import gebweb.scheduler as schedmod;
import gebweb.secretstore as secretsmod;
import gebweb.security as securitymod;
import gebweb.storage as storagemod;
import gebweb.swaggerui as swaggerui;
import gebweb.validation as validation;
import llm as llmmod;
import gebweb.views as viewsmod;

class GebwebApp {
    /* `web.router.newRouter()` returns a {"app": ..., "prefix": ...}
     * dict, not a class. Typed as `dict<string, any>` rather than
     * `any` so accidental misuse is caught at static-analysis time. */
    dict<string, any> router;
    list<dict<string, any>> routeMetadata;
    dict<string, any> info;
    di.Container container;
    validation.AssertionRegistry assertions;
    ?authmod.AuthConfig auth;
    ?cachemod.CacheConfig cache;
    ?any idempotencyStore;
    int maxBodyBytes;
    ?metricsmod.MetricsConfig metricsConfig;
    /* Cross-isolation operational state (drain flag, server handle):
     * a store handle is shared with per-request and signal-handler
     * clones, where plain fields are copies. */
    storemod.Store opsStore;
    /* CSRF config registered via gebweb.useCsrf(app, opts). Null = disabled. */
    ?csrfmod.CsrfConfig csrfConfig;
    /* i18n config registered via gebweb.useI18n(app, opts). Null = disabled. */
    ?i18nmod.I18nConfig i18nConfig;
    /* Tenant resolver config registered via gebweb.useTenant(app, ...). Null = disabled. */
    ?tenancymod.TenantConfig tenantConfig;
    /* Health-check config registered via gebweb.useHealth(app, ...). Null = disabled. */
    ?healthmod.HealthConfig healthConfig;
    /* OIDC config registered via gebweb.useOidc(app, opts). Null = disabled. */
    ?oidcmod.OidcConfig oidcConfig;
    /* Outbound webhook config registered via gebweb.useWebhooks. Null = disabled. */
    ?webhooksmod.WebhookConfig webhookConfig;
    /* Asset pipeline config registered via gebweb.useStaticAssets. */
    ?assetsmod.AssetConfig assetConfig;
    /* Session store registered via gebweb.useSession or useSessionAuth.
     * Required by flash + form-state rehydration. Any duck-typed value
     * with load(request) / save(response, data, opts) methods. */
    ?any sessionStore;
    /* Plugins registered via gebweb.plugin(app, ...). Order of
     * registration is preserved; findPlugin walks linearly. */
    list<pluginmod.PluginContract> plugins;
    /* View engine registered via gebweb.useViews(app, dir). */
    ?viewsmod.ViewEngine viewEngine;
    /* Background-job config registered via gebweb.useJobs(app, conn). */
    ?jobsmod.JobConfig jobConfig;
    /* Scheduler config registered via gebweb.useScheduler(app, ...). */
    ?schedmod.ScheduleConfig schedulerConfig;
    /* Event-bus config registered via gebweb.useEvents(app). */
    ?eventsmod.EventConfig eventConfig;
    /* Mailer transport registered via gebweb.useMailer(app, t). */
    ?mailingmod.MailerContract mailerTransport;
    /* LLM client registered via gebweb.useLlm(app, client). */
    ?llmmod.Client llmClient;
    /* Storage backend registered via gebweb.useStorage(app, s). */
    ?storagemod.StorageContract storage;
    /* Messaging config registered via gebweb.useMessaging(app). */
    ?messagingmod.MessagingConfig messagingConfig;
    /* Registered view-context injectors keyed by name. Each callable
     * takes the request dict and returns the value to inject into a
     * rendered template's context dict. Called from gebweb.view()
     * when a request is threaded through. */
    dict<string, callable> viewContextInjectors;
    /* Optional guard run before /openapi.json and /docs. Registered
     * via gebweb.useDocsAuth. Null = the docs routes are public. */
    ?callable docsGuard;
    /* Parameter store: primitive config (db URLs, secrets, feature
     * flags) registered via gebweb.parameter(app, key, value) or
     * loaded from YAML via gebweb.loadConfig(app). Read back via
     * gebweb.parameter(app, key); string values are scanned for
     * %env(...)% / %secret(...)% / %ref% markers on read. */
    dict<string, any> parameters;
    /* Secrets provider registered via gebweb.useSecrets(app, p).
     * Consulted when %secret(...)% markers resolve in YAML
     * parameters. Null = no provider, marker resolution throws. */
    ?secretsmod.SecretsProvider secretsProvider;

    func GebwebApp() {
        this.router = webrouter.newRouter();
        this.routeMetadata = [];
        this.info = {"title": "Gebweb API", "version": "0.1.0"};
        this.container = di.newContainer();
        this.assertions = validation.newRegistry();
        this.auth = null;
        this.cache = null;
        this.idempotencyStore = null;
        this.maxBodyBytes = 10 * 1024 * 1024;
        this.metricsConfig = null;
        this.opsStore = storemod.Store();
        this.csrfConfig = null;
        this.i18nConfig = null;
        this.tenantConfig = null;
        this.healthConfig = null;
        this.oidcConfig = null;
        this.webhookConfig = null;
        this.assetConfig = null;
        this.sessionStore = null;
        this.docsGuard = null;
        this.plugins = [];
        this.viewEngine = null;
        this.jobConfig = null;
        this.schedulerConfig = null;
        this.eventConfig = null;
        this.mailerTransport = null;
        this.llmClient = null;
        this.storage = null;
        this.messagingConfig = null;
        this.viewContextInjectors = {};
        this.parameters = {};
        this.secretsProvider = null;
    }
}

export func setParameter(GebwebApp app, string key, any value): GebwebApp {
    app.parameters[key] = value;
    return app;
}

export func getParameter(GebwebApp app, string key): any {
    if (!app.parameters.contains(key)) {
        throw RuntimeError("gebweb parameter '" + key + "' is not registered");
    }
    return resolveParamValue(app, app.parameters[key], ([key] as set<string>));
}

export func hasParameter(GebwebApp app, string key): bool {
    return app.parameters.contains(key);
}

export func parameters(GebwebApp app): dict<string, any> {
    return app.parameters;
}

/* Resolver for @Param("key") constructor parameters: looks the
 * key up in the app's parameter store. Threaded into every
 * di.resolveWith call so controllers, repositories and discovered
 * services can pull primitive config alongside class deps. */
func parameterResolverFor(GebwebApp app): callable {
    return func(string key): any {
        if (!app.parameters.contains(key)) {
            throw RuntimeError("gebweb: @Param(\"" + key
                + "\") requested but no parameter is registered "
                + "(call gebweb.parameter(app, \"" + key + "\", ...))");
        }
        return resolveParamValue(app, app.parameters[key], ([key] as set<string>));
    };
}

/* Recursively resolves a parameter value, substituting %env(...)%,
 * %secret(...)%, and %ref% markers in strings, and walking lists /
 * dicts element-wise. `resolving` carries the in-flight parameter
 * key chain for cycle detection. Container values with no marker-
 * bearing leaves are returned by reference (no clone). */
func resolveParamValue(GebwebApp app, any value, set<string> resolving): any {
    if (value instanceof string) {
        return substituteParamString(app, value as string, resolving);
    }
    if (value instanceof list) {
        if (!containsMarkers(value)) { return value; }
        list<any> out = [];
        for (item in value as list<any>) {
            out = out.push(resolveParamValue(app, item, resolving));
        }
        return out;
    }
    if (value instanceof dict) {
        if (!containsMarkers(value)) { return value; }
        dict<string, any> out = {};
        for (k, v in (value as dict<string, any>).items()) {
            out[k] = resolveParamValue(app, v, resolving);
        }
        return out;
    }
    return value;
}

/* True when `value` has any string descendant containing a `%` byte;
 * lets resolveParamValue skip cloning unmarked containers entirely. */
func containsMarkers(any value): bool {
    if (value instanceof string) { return (value as string).indexOf("%") >= 0; }
    if (value instanceof list) {
        for (item in value as list<any>) {
            if (containsMarkers(item)) { return true; }
        }
        return false;
    }
    if (value instanceof dict) {
        for (k, v in (value as dict<string, any>).items()) {
            if (containsMarkers(v)) { return true; }
        }
        return false;
    }
    return false;
}

func substituteParamString(GebwebApp app, string s, set<string> resolving): any {
    int len = s.length();
    if (s.indexOf("%") < 0) { return s; }

    /* Single-token form `%name%` returns the referenced value at
     * its native type, so int / list / dict parameters round-trip
     * without being stringified. */
    if (len >= 3 && s.substring(0, 1) == "%" && s.substring(len - 1, len) == "%") {
        int inner = s.substring(1, len - 1).indexOf("%");
        if (inner < 0) {
            return resolveParamToken(app, s.substring(1, len - 1), resolving);
        }
    }

    /* Jump-based scanner: emit plain runs between markers in one
     * substring each (O(markers) allocs, not O(n)). */
    let sb = strbuilder.new("");
    int i = 0;
    while (i < len) {
        int pct = s.substring(i, len).indexOf("%");
        if (pct < 0) {
            strbuilder.append(sb, s.substring(i, len));
            i = len;
            break;
        }
        int absPct = i + pct;
        if (absPct > i) {
            strbuilder.append(sb, s.substring(i, absPct));
        }
        /* %% escape -> literal % */
        if (absPct + 1 < len && s.substring(absPct + 1, absPct + 2) == "%") {
            strbuilder.append(sb, "%");
            i = absPct + 2;
            continue;
        }
        int rel = s.substring(absPct + 1, len).indexOf("%");
        if (rel < 0) {
            throw RuntimeError("gebweb config: unterminated % in '" + s + "'");
        }
        int absClose = absPct + 1 + rel;
        string token = s.substring(absPct + 1, absClose);
        strbuilder.append(sb, paramValueToString(resolveParamToken(app, token, resolving)));
        i = absClose + 1;
    }
    let out = strbuilder.build(sb);
    strbuilder.dispose(sb);
    return out;
}

func resolveParamToken(GebwebApp app, string token, set<string> resolving): any {
    if (token.startsWith("env(") && token.endsWith(")")) {
        string varName = token.substring(4, token.length() - 1);
        let raw = sys.getenv(varName);
        if (raw == null || (raw as string).isEmpty()) {
            throw RuntimeError("gebweb config: env var '" + varName + "' is not set");
        }
        return raw as string;
    }
    if (token.startsWith("secret(") && token.endsWith(")")) {
        string secretName = token.substring(7, token.length() - 1);
        if (app.secretsProvider == null) {
            throw RuntimeError("gebweb config: %secret(" + secretName + ")% requires a secrets provider (call gebweb.useSecrets(app, ...) first)");
        }
        return app.secretsProvider.getSecret(secretName);
    }
    if (resolving.contains(token)) {
        throw RuntimeError("gebweb config: cyclic parameter reference at '" + token + "'");
    }
    if (!app.parameters.contains(token)) {
        throw RuntimeError("gebweb config: parameter '" + token + "' is not registered");
    }
    return resolveParamValue(app, app.parameters[token], resolving.add(token));
}

/* Converts a resolved token value to its string form for inline
 * concatenation. String concat dispatches through the runtime's
 * value-to-string, which handles int / float / decimal / bool /
 * list / dict uniformly. */
func paramValueToString(any v): string {
    if (v instanceof string) { return v as string; }
    return "" + v;
}

/**
 * Register a view-context injector. The framework wires injectors
 * for csrf / flashes / errors / oldInput / cspNonce / asset map
 * automatically when the relevant `use*` helpers are called; user
 * code can register additional injectors here.
 * Each call to gebweb.view(app, name, ctx, request) merges every
 * registered injector's result into the context (under its name)
 * before rendering. Earlier user-supplied keys win over injectors.
 * The injector callable receives the rich `Request` (1.7.1+).
 */
export func registerViewContext(GebwebApp app, string name, callable fn): GebwebApp {
    app.viewContextInjectors[name] = fn;
    return app;
}

export func viewContextInjectors(GebwebApp app): dict<string, callable> {
    return app.viewContextInjectors;
}

/**
 * Set the OpenAPI `info` object (title, version, description, etc.).
 * Subsequent calls overwrite earlier values for the same keys.
 */
export func setInfo(GebwebApp app, dict<string, any> info): GebwebApp {
    for (key in info.keys()) {
        app.info[key] = info[key];
    }
    return app;
}

/* Promote the closure that returns the app's auth config to a
 * top-level factory so the captured `app` reference survives outside
 * the (looping) caller frame. A closure created inline in
 * `registerControllerRoutes` lost the `app` capture on the second
 * dispatch ("local is undefined" at runtime). */
func makeAuthLookup(GebwebApp app): callable {
    return func(): ?authmod.AuthConfig {
        return app.auth;
    };
}

func makeCacheLookup(GebwebApp app): callable {
    return func(): ?cachemod.CacheConfig {
        return app.cache;
    };
}

func makeIdempotencyLookup(GebwebApp app): callable {
    return func(): ?any {
        return app.idempotencyStore;
    };
}

func makeCsrfLookup(GebwebApp app): callable {
    return func(): ?csrfmod.CsrfConfig {
        return app.csrfConfig;
    };
}

func makeSessionLookup(GebwebApp app): callable {
    return func(): ?any {
        return app.sessionStore;
    };
}

/* Binds the app so the route adapter can enforce @Can without importing app. */
func makeCanEnforcer(GebwebApp app): callable {
    return func(any user, string action, string typeName): void {
        authzmod.enforceCan(app, user, action, typeName);
    };
}

/**
 * Enable CSRF protection app-wide. opts.secret is required;
 * cookieName / cookieOptions are optional. Once enabled, every
 * state-changing method requires a valid token unless the route is
 * `@CsrfExempt`. The token lives in the `geb_csrf` cookie and
 * must be echoed in the `X-CSRF-Token` header or `_csrf` form
 * field on POST/PUT/PATCH/DELETE.
 */
/**
 * Mount the locale negotiator. `opts` accepts:
 *
 *   - `locales`: list of supported BCP-47 tags. Default: `["en"]`.
 *   - `default`: fallback tag. Default: `"en"`.
 *   - `sources`: ordered list of negotiation sources. Default:
 *     `["url", "cookie", "accept-language"]`.
 *   - `cookieName`: name of the sticky-choice cookie. Default:
 *     `"gebweb_locale"`.
 *   - `urlPrefix`: when true, recognise a leading `/<locale>/`
 *     path segment. Default: true.
 *   - `urlStrip`: when true and a URL prefix matched, rewrite
 *     `request["path"]` to drop the prefix so routes stay
 *     locale-agnostic. Default: true.
 *   - `defaultZone`: IANA time-zone name applied to the
 *     resolved Locale when the tag does not carry one.
 *
 * The resolved `Locale` is stored at `request["_locale"]` and
 * is injected into handlers that declare a parameter of type
 * `i18n.Locale`.
 */
export func useI18n(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    let cfg = i18nmod.I18nConfig(opts);
    app.i18nConfig = cfg;
    before(app, i18nmod.i18nBefore(cfg));
    if (cfg.translator != null) {
        let tr = cfg.translator as i18nmod.Translator;
        registerViewContext(app, "t", func(reqmod.Request request): callable {
            let loc = request.contains("_locale") ? (request["_locale"] as i18nmod.Locale).tag : cfg.defaultTag;
            return func(string key, dict<string, any> args = {}): string {
                return tr.translate(loc, key, args);
            };
        });
    }
    return app;
}

/**
 * Mount the tenant resolver. `resolver(request)` returns a
 * `Tenant` value (or null when no tenant could be determined).
 * The resolved tenant lives on `request["_tenant"]` and is
 * injected into handlers that declare a `Tenant` parameter.
 * When `opts.required` is true (the default) a null resolution
 * short-circuits the request with a 400 problem document; set
 * to false to let the request continue without a tenant.
 */
export func useTenant(GebwebApp app, callable resolver, dict<string, any> opts = {}): GebwebApp {
    bool required = opts.contains("required") ? opts["required"] as bool : true;
    let cfg = tenancymod.TenantConfig(resolver, required);
    app.tenantConfig = cfg;
    before(app, tenancymod.tenantBefore(cfg));
    return app;
}

/**
 * Mount liveness + readiness endpoints. Walks `instances` for
 * `@HealthCheck` methods and registers them. The endpoints
 * default to `/healthz` (liveness) and `/readyz` (readiness);
 * override with `opts.livenessPath` / `opts.readinessPath`.
 * Each `/healthz` or `/readyz` hit runs every registered probe of
 * that kind, returning 200 + JSON when all pass, 503 otherwise.
 */

/**
 * Mount one or more OIDC / OAuth2 providers. Each provider gets a
 * callback route at `<callbackPathPrefix>/<provider.name>/callback`
 * (default prefix `/auth`). On a successful callback the framework
 * exchanges the code with PKCE, validates the ID token (or fetches
 * the user profile for GitHub), invokes `opts.userResolver(claims,
 * provider)` to build the session data, saves it via the session
 * store, and redirects to `successRedirect`.
 */
export func useOidc(GebwebApp app, dict<string, any> opts): GebwebApp {
    let cfg = oidcmod.OidcConfig(opts);
    app.oidcConfig = cfg;
    let store = app.sessionStore;
    for (provider in cfg.providers) {
        let p = provider as oidcmod.OidcProvider;
        string callbackPath = cfg.callbackPathPrefix + "/" + p.name + "/callback";
        webrouter.route(app.router, "GET", callbackPath, makeOidcCallback(app, p, cfg, store));
    }
    return app;
}

func makeOidcCallback(GebwebApp app, oidcmod.OidcProvider provider, oidcmod.OidcConfig cfg, any store): callable {
    return func(dict<string, any> request): dict<string, any> {
        let query = parseQuery((request["query"] ?? "") as string);
        if (!query.contains("code") || !query.contains("state")) {
            return {"status": 400, "body": "missing code or state"};
        }
        let cookies = readCookies((request["headers"] ?? {}) as dict<string, any>);
        let stateCookie = cookies.contains("geb_oidc") ? (cookies["geb_oidc"] as string) : "";
        let verifier = oidcmod.verifyState(stateCookie, query["code"] != null ? query["state"] as string : "", cfg.stateSecret);
        if (verifier.isEmpty()) {
            return {"status": 400, "body": "invalid oidc state"};
        }
        string redirectUri = buildSelfUrl(request, cfg.callbackPathPrefix + "/" + provider.name + "/callback");
        let tokens = oidcmod.exchangeCode(provider, query["code"] as string, redirectUri, verifier);
        let claims = oidcmod.resolveClaims(provider, tokens);
        let user = (cfg.userResolver)(claims, provider);
        dict<string, any> response = {
            "status": 302,
            "headers": {"Location": cfg.successRedirect, "Set-Cookie": "geb_oidc=; Max-Age=0; Path=/; HttpOnly"},
            "body": ""
        };
        if (store != null && user != null) {
            response = store.save(response, user as dict<string, any>, {});
        }
        return response;
    };
}

func parseQuery(string raw): dict<string, any> {
    dict<string, any> out = {};
    if (raw.isEmpty()) { return out; }
    for (part in raw.split("&")) {
        let p = part as string;
        let eq = p.indexOf("=");
        if (eq < 0) { out[p] = ""; continue; }
        out[p.substring(0, eq)] = urlDecode(p.substring(eq + 1, p.length()));
    }
    return out;
}

func urlDecode(string s): string {
    string out = "";
    int i = 0;
    while (i < s.length()) {
        string ch = s.substring(i, i + 1);
        if (ch == "+") { out = out + " "; i = i + 1; continue; }
        if (ch == "%" && i + 2 < s.length()) {
            string hh = s.substring(i + 1, i + 3);
            int v = (hexDigit(hh.substring(0, 1)) * 16) + hexDigit(hh.substring(1, 2));
            out = out + bytes.toString(bytes.fromHex(hexByte(v)));
            i = i + 3;
            continue;
        }
        out = out + ch;
        i = i + 1;
    }
    return out;
}

func hexByte(int v): string {
    string digits = "0123456789abcdef";
    int hi = (v // 16) % 16;
    int lo = v % 16;
    return digits.substring(hi, hi + 1) + digits.substring(lo, lo + 1);
}

func hexDigit(string ch): int {
    if (ch == "0") { return 0; } if (ch == "1") { return 1; } if (ch == "2") { return 2; }
    if (ch == "3") { return 3; } if (ch == "4") { return 4; } if (ch == "5") { return 5; }
    if (ch == "6") { return 6; } if (ch == "7") { return 7; } if (ch == "8") { return 8; }
    if (ch == "9") { return 9; }
    let lc = ch.lower();
    if (lc == "a") { return 10; } if (lc == "b") { return 11; } if (lc == "c") { return 12; }
    if (lc == "d") { return 13; } if (lc == "e") { return 14; } if (lc == "f") { return 15; }
    return 0;
}

func readCookies(dict<string, any> headers): dict<string, any> {
    dict<string, any> out = {};
    string header = "";
    for (k in headers.keys()) {
        if ((k as string).lower() == "cookie") {
            header = headers[k as string] as string;
            break;
        }
    }
    if (header.isEmpty()) { return out; }
    for (part in header.split(";")) {
        let p = (part as string).trim();
        let eq = p.indexOf("=");
        if (eq <= 0) { continue; }
        out[p.substring(0, eq)] = p.substring(eq + 1, p.length());
    }
    return out;
}

func buildSelfUrl(any request, string path): string {
    let headers = (request["headers"] ?? {}) as dict<string, any>;
    string host = headers.contains("Host") ? (headers["Host"] as string) : "localhost";
    string scheme = headers.contains("X-Forwarded-Proto") ? (headers["X-Forwarded-Proto"] as string) : "http";
    return scheme + "://" + host + path;
}

/**
 * Build the authorization URL for `providerName`. Returns
 * `{url, stateCookie}`; redirect the browser to `url` and write
 * `stateCookie` as the `geb_oidc` cookie.
 */
export func oidcLoginUrl(GebwebApp app, string providerName, any request): dict<string, any> {
    if (app.oidcConfig == null) {
        throw RuntimeError("oidcLoginUrl: app has no OIDC config; call useOidc first");
    }
    let cfg = app.oidcConfig as oidcmod.OidcConfig;
    for (provider in cfg.providers) {
        let p = provider as oidcmod.OidcProvider;
        if (p.name == providerName) {
            string redirectUri = buildSelfUrl(request, cfg.callbackPathPrefix + "/" + p.name + "/callback");
            return oidcmod.loginUrl(p, redirectUri, cfg.stateSecret);
        }
    }
    throw RuntimeError("oidcLoginUrl: no provider named '" + providerName + "'");
}

/**
 * Mount the outbound webhook dispatcher. Requires `useJobs(app, ...)`
 * (the dispatch path enqueues a job per subscription). Returns
 * the same app so the call chains with other `use*` setup.
 */
export func useWebhooks(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    let cfg = webhooksmod.newConfig(opts);
    app.webhookConfig = cfg;
    if (app.jobConfig != null) {
        jobsmod.registerHandlers(app.jobConfig as jobsmod.JobConfig, [webhooksmod.WebhookJobHandler(cfg)]);
    }
    return app;
}

/**
 * Add a subscription. Returns the new `WebhookSubscription`.
 * `useWebhooks` must have been called first.
 */
export func subscribeWebhook(GebwebApp app, string event, string url, string secret = ""): webhooksmod.WebhookSubscription {
    if (app.webhookConfig == null) {
        throw RuntimeError("subscribeWebhook: app has no webhook config; call useWebhooks first");
    }
    return webhooksmod.subscribe(app.webhookConfig as webhooksmod.WebhookConfig, event, url, secret);
}

export func unsubscribeWebhook(GebwebApp app, string event, string url): bool {
    if (app.webhookConfig == null) { return false; }
    return webhooksmod.unsubscribe(app.webhookConfig as webhooksmod.WebhookConfig, event, url);
}

/**
 * Dispatch `event` to every subscriber. Each delivery is queued
 * as a separate job (see `useJobs`); failures retry with the job
 * queue's configured backoff, and the configured `deadLetter`
 * callback fires after the final attempt.
 */
export func dispatchWebhook(GebwebApp app, string event, dict<string, any> payload): int {
    if (app.webhookConfig == null) { return 0; }
    if (app.jobConfig == null) {
        throw RuntimeError("dispatchWebhook: app has no job queue; call useJobs first");
    }
    let cfg = app.webhookConfig as webhooksmod.WebhookConfig;
    let jobCfg = app.jobConfig as jobsmod.JobConfig;
    int count = 0;
    for (sub in webhooksmod.subscriptionsFor(cfg, event)) {
        jobsmod.enqueue(jobCfg, "gebweb.webhook.send", {
            "event": event,
            "url": sub.url,
            "secret": sub.secret,
            "data": payload
        }, {});
        count = count + 1;
    }
    return count;
}

/**
 * Mount Server-Timing emission. Registers a before-middleware
 * that primes a per-request timing list and an after-middleware
 * that encodes it into the `Server-Timing` response header.
 * Application code adds entries via `gebweb.recordTiming` /
 * `gebweb.measureTiming`.
 */
export func useServerTiming(GebwebApp app): GebwebApp {
    before(app, servertimingmod.beforeMiddleware());
    use(app, servertimingmod.afterMiddleware());
    return app;
}

export func recordTiming(any request, string label, int durationMs): void {
    servertimingmod.record(request, label, durationMs);
}

export func measureTiming(any request, string label, callable fn): any {
    return servertimingmod.measure(request, label, fn);
}

/**
 * Mount the ETag middleware. On every 2xx response with a body
 * within the configured size window, compute a weak SHA-256 ETag
 * and respond 304 when the request's `If-None-Match` matches.
 */
export func useEtag(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    let cfg = etagmod.newConfig(opts);
    use(app, etagmod.etagMiddleware(cfg));
    return app;
}

export func useHealth(GebwebApp app, list<any> instances, dict<string, any> opts = {}): GebwebApp {
    let cfg = healthmod.newConfig(opts);
    healthmod.registerProbes(cfg, instances);
    app.healthConfig = cfg;
    webrouter.route(app.router, "GET", cfg.livenessPath, func(dict<string, any> request): dict<string, any> {
        return healthmod.runProbes(cfg, "liveness");
    });
    webrouter.route(app.router, "GET", cfg.readinessPath, func(dict<string, any> request): dict<string, any> {
        if (isDraining(app)) {
            return {
                "status": 503,
                "headers": {"Content-Type": "application/json"},
                "body": json.stringify({"status": "draining"}),
            };
        }
        return healthmod.runProbes(cfg, "readiness");
    });
    return app;
}

/**
 * Translate `key` for the given `locale` (a tag like `"en"` or a
 * `Locale` instance), substituting `{name}` placeholders from
 * `args`. Falls back to the configured default locale, then to
 * the key itself when no translation is found.
 */
export func t(GebwebApp app, any locale, string key, dict<string, any> args = {}): string {
    if (app.i18nConfig == null) { return key; }
    let cfg = app.i18nConfig as i18nmod.I18nConfig;
    if (cfg.translator == null) { return key; }
    string tag = locale instanceof string ? locale as string : (locale as i18nmod.Locale).tag;
    return (cfg.translator as i18nmod.Translator).translate(tag, key, args);
}

export func useCsrf(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    if (!opts.contains("secret")) {
        throw errors.new("RuntimeError", "gebweb.useCsrf: opts.secret is required");
    }
    app.csrfConfig = csrfmod.newConfig(opts["secret"] as string, opts);
    registerViewContext(app, "csrf", func(reqmod.Request request): any {
        if (request.contains("_csrfToken")) {
            return request["_csrfToken"];
        }
        return "";
    });
    return app;
}

/**
 * Mount browser-security headers. `opts` accepts:
 *
 *   - `csp` - dict of CSP directives in camelCase (defaultSrc,
 *     scriptSrc, ...). Each value is a list of source expressions.
 *     The literal `'nonce'` expands to `'nonce-<value>'` per
 *     request and the nonce is auto-published as `cspNonce` in
 *     the view context.
 *   - `cspReportOnly` - bool. Switches to the report-only header.
 *   - `hsts` - dict with `maxAge`, `includeSubdomains`, `preload`.
 *     Omitted means no HSTS header (correct for dev).
 *   - `frameOptions` - string, defaults to `"DENY"`. Set `""` to
 *     suppress the header.
 *   - `referrerPolicy` - string, defaults to
 *     `"strict-origin-when-cross-origin"`. Set `""` to suppress.
 *   - `contentTypeOptions` - bool, defaults to true. Emits
 *     `X-Content-Type-Options: nosniff`.
 */
export func useSecurity(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    let cfg = securitymod.newConfig(opts);
    before(app, securitymod.nonceBefore(cfg));
    use(app, securitymod.headersAfter(cfg));
    registerViewContext(app, "cspNonce", func(reqmod.Request request): any {
        if (request.contains("_cspNonce")) {
            return request["_cspNonce"];
        }
        return "";
    });
    return app;
}

func registerControllerRoutes(GebwebApp app, any controller): void {
    let cls = reflect.class(controller);
    string className = (reflect.typeOf(controller) as string);
    string prefix = deco.controllerPrefix(cls);

    for (name in reflect.methods(cls)) {
        let handler = reflect.method(controller, name as string);
        for (decoratorValue in deco.decoratorsOf(handler)) {
            let decorator = decoratorValue as dict<string, any>;
            if (!deco.isRouteDecorator(decorator)) {
                continue;
            }
            string method = deco.routeMethod(decorator);
            /* @ApiVersion("v2") prefixes the route with /v2, outermost of the
             * controller prefix and the method path. */
            string version = deco.apiVersionFor(cls, handler);
            string versionPrefix = "";
            if (!version.isEmpty()) {
                string seg = version.startsWith("/") ? version.substring(1, version.length()) : version;
                versionPrefix = "/" + seg;
            }
            string path = versionPrefix + prefix + deco.routePath(decorator);
            string nativePath = binding.nativePathTemplate(path);
            list<string> pathParamNames = deco.pathParameterNames(path);
            let adapter = binding.makeRouteAdapterFull(handler, cls, pathParamNames, app.assertions, makeAuthLookup(app), makeCacheLookup(app), makeIdempotencyLookup(app), formsmod.formRehydration(makeSessionLookup(app)), makeCanEnforcer(app));
            /* Per-route policy decorators wrap the adapter. The
             * order matters: rate-limit first (rejects early before
             * any work), CORS last (so its headers attach to the
             * final response). */
            if (deco.hasDecorator(handler, "MaxBody")) {
                int routeCap = deco.decoratorInt(handler, "MaxBody", 0);
                if (routeCap > 0) {
                    adapter = mwmod.wrapRouteMaxBody(adapter, routeCap);
                }
            }
            if (deco.hasDecorator(handler, "RateLimit")) {
                int perSecond = deco.decoratorInt(handler, "RateLimit", 10);
                int burst = deco.decoratorIntAt(handler, "RateLimit", 1, 0);
                adapter = mwmod.wrapRouteRateLimit(adapter, perSecond, burst);
            }
            if (!deco.hasDecorator(handler, "CsrfExempt") && !deco.hasDecorator(cls, "CsrfExempt")) {
                adapter = csrfmod.wrapRouteCsrf(adapter, makeCsrfLookup(app));
            }
            if (deco.hasDecorator(handler, "Cors")) {
                let corsOpts = deco.decoratorDict(handler, "Cors");
                if (corsOpts != null) {
                    adapter = mwmod.wrapRouteCors(adapter, corsOpts as dict<string, any>);
                }
            }
            bool deprecated = deco.isDeprecated(cls, handler);
            string sunset = deco.deprecationSunset(cls, handler);
            /* Outermost wrap so the Deprecation/Sunset headers attach to the
             * final response, including early rejections like rate-limit 429s. */
            if (deprecated) {
                adapter = mwmod.wrapRouteDeprecation(adapter, sunset);
            }
            /* Outermost of all: metrics observe the final status of
             * every wrap (rate-limit 429s, CSRF 403s, ...). */
            adapter = metricsmod.wrapRouteMetrics(adapter, makeMetricsLookup(app), method, path);
            webrouter.route(app.router, method, nativePath, adapter);
            /* HEAD mirrors GET (same handler); the HTTP layer drops the body. */
            if (method == "GET") {
                webrouter.route(app.router, "HEAD", nativePath, adapter);
            }

            dict<string, any> entry = {
                "method": method,
                "path": path,
                "controller": className,
                "controllerClass": cls,
                "handler": name as string,
                "handlerValue": handler,
                "pathParamNames": pathParamNames,
                "tag": deco.tagFor(cls, handler, className),
                "summary": deco.decoratorString(handler, "Summary"),
                "description": deco.decoratorString(handler, "Description"),
                "operationId": deco.decoratorString(handler, "OperationId"),
                "deprecated": deprecated,
                "sunset": sunset,
                "version": version,
                "apiResponses": deco.apiResponses(handler),
            };
            app.routeMetadata = app.routeMetadata.push(entry);
        }
    }
}

func mountSpecRoute(GebwebApp app): void {
    let specCallable = func(dict<string, any> request): dict<string, any> {
        return {
            "status": 200,
            "headers": {"Content-Type": "application/json"},
            "body": json.stringify(openapi.build(app.info, app.routeMetadata, app.auth)),
        };
    };
    webrouter.route(app.router, "GET", "/openapi.json", maybeProtect(app, specCallable, "openapi"));
}

func mountSwaggerUiRoutes(GebwebApp app): void {
    let bundleDir = sys.bundleDir();
    let embedded = bundleDir != "";
    let docsCallable = func(dict<string, any> request): dict<string, any> {
        return {
            "status": 200,
            "headers": {"Content-Type": "text/html; charset=utf-8"},
            "body": swaggerui.htmlPage("/openapi.json", app.info["title"] as string, embedded),
        };
    };
    webrouter.route(app.router, "GET", "/docs", maybeProtect(app, docsCallable, "docs"));

    /* Built binaries embed the SwaggerUI assets; serve them locally for offline docs. */
    if (embedded) {
        for (assetName in swaggerui.assetNames()) {
            let name = assetName;
            let assetCallable = func(dict<string, any> request): dict<string, any> {
                return swaggerui.serveAsset(bundleDir, name);
            };
            webrouter.route(app.router, "GET", "/docs/" + name, assetCallable);
        }
    }
}

/**
 * If `useDocsAuth(app, guard)` has been called, wrap `handler` so
 * the guard runs first. The guard is a callable that receives the
 * request dict and returns either null (pass-through) or a
 * response dict (short-circuit). Standard auth shapes:
 *
 *   gebweb.useDocsAuth(app, gebweb.basicAuthGuard("admin", "s3cret"));
 *   gebweb.useDocsAuth(app, gebweb.bearerTokenGuard("expected-token"));
 *   gebweb.useDocsAuth(app, gebweb.sessionAuthGuard());
 *
 * Custom guards: pass any callable. `which` is "openapi" or "docs"
 * so a custom guard can return different challenges per route.
 */
func maybeProtect(GebwebApp app, callable handler, string which): callable {
    if (app.docsGuard == null) {
        return handler;
    }
    let guard = app.docsGuard as callable;
    return func(dict<string, any> request): dict<string, any> {
        let denied = guard(reqmod.Request(request));
        if (denied != null) {
            return denied as dict<string, any>;
        }
        return handler(request) as dict<string, any>;
    };
}

/**
 * Build a Gebweb app from a list of entries. Each entry may be one
 * of three things:
 *  - an already-constructed controller instance
 *  - a controller class reference (DI auto-wires it)
 *  - a resource class decorated with `@ApiResource` (the framework
 *    generates the six CRUD endpoints and resolves the repository
 *    via DI from the class's static `repositoryClass()` method)
 *
 * Controllers are processed first so any explicit @Get/@Post on a
 * resource path takes precedence over the auto-generated route.
 * SwaggerUI mounts at /docs and the spec at /openapi.json unless docs
 * are disabled (see `docsEnabled`). Returns the app value to pass into
 * `serve` or the TestClient.
 */
export func app(list<any> controllers = [], ?dict<string, any> opts = null): GebwebApp {
    let result = GebwebApp();
    if (io.exists("config/services.yaml")) {
        loadConfig(result, "config/services.yaml");
    }
    /* Empty list auto-mounts all @Controller; an explicit list is the complete set. */
    if (controllers.length() > 0) {
        result.opsStore.set("hadExplicitControllers", true);
    }
    addControllers(result, controllers);
    if (specEnabled(opts)) {
        mountSpecRoute(result);
    }
    if (uiEnabled(opts)) {
        mountSwaggerUiRoutes(result);
    }
    return result;
}

/* opts[key] wins, then opts["docs"] shorthand, then the environment default. */
func resolveDocsFlag(?dict<string, any> opts, string key): bool {
    if (opts != null) {
        let o = opts as dict<string, any>;
        if (o.contains(key)) {
            return o[key] as bool;
        }
        if (o.contains("docs")) {
            return o["docs"] as bool;
        }
    }
    return docsEnvDefault();
}

/* GEBWEB_DOCS=off/false/no/0 or GEBWEB_ENV=production disable docs, else on. */
func docsEnvDefault(): bool {
    let docs = sys.getenv("GEBWEB_DOCS");
    if (docs != null && !(docs as string).isEmpty()) {
        let v = (docs as string).lower();
        return !(v == "off" || v == "false" || v == "no" || v == "0");
    }
    let env = sys.getenv("GEBWEB_ENV");
    if (env != null && (env as string).lower() == "production") {
        return false;
    }
    return true;
}

func specEnabled(?dict<string, any> opts): bool {
    return resolveDocsFlag(opts, "openapi");
}

/* SwaggerUI fetches the spec at runtime, so it is forced off when the spec is off. */
func uiEnabled(?dict<string, any> opts): bool {
    if (!specEnabled(opts)) {
        return false;
    }
    return resolveDocsFlag(opts, "swaggerUi");
}

/**
 * Loads YAML configuration into the app. Reads parameters,
 * services, and bindings sections from `configPath` (and any
 * imports + per-env overlay) and writes them onto the app.
 * The parameter store is populated immediately; service and
 * binding entries are stashed for the container wiring that
 * runs during controller resolution (steps 5+ of the bundle).
 */
export func loadConfig(GebwebApp app, string configPath = "config/services.yaml"): GebwebApp {
    let cfg = configmod.loadConfigDict(configPath);
    if (cfg.contains("parameters")) {
        let params = cfg["parameters"] as dict<string, any>;
        for (key in params.keys()) {
            app.parameters[key] = params[key];
        }
    }
    if (cfg.contains("services")) {
        applyServicesSection(app, cfg["services"] as dict<string, any>);
    }
    if (cfg.contains("bindings")) {
        applyBindingsSection(app, cfg["bindings"] as dict<string, any>);
    }
    /* Detection runs in discover() too; calling here covers apps
     * that wire only via YAML and never call discover. The check
     * is idempotent and only throws on multi-impl conflicts. */
    di.detectInterfaceConflicts(app.container);
    return app;
}

func applyBindingsSection(GebwebApp app, dict<string, any> bindings): void {
    for (ifaceName, raw in bindings.items()) {
        if (!(raw instanceof string)) {
            throw RuntimeError("gebweb config: bindings entry for '" + ifaceName + "' must be a string of the form '@service-id' or 'service-id'");
        }
        string targetId = stripAtPrefix(raw as string);
        if (!di.hasService(app.container, targetId)) {
            throw RuntimeError("gebweb config: bindings entry for '" + ifaceName + "' references unknown service id '" + targetId + "'");
        }
        let classRef = app.container.serviceIds[di.canonicalServiceId(app.container, targetId)];
        if (!di.collectInheritedInterfaces(classRef).contains(ifaceName)) {
            throw RuntimeError("gebweb config: service '" + targetId + "' does not implement interface '" + ifaceName + "'");
        }
        di.bindInterface(app.container, ifaceName, targetId);
    }
}

/* Strips a leading `@` from a YAML service / binding reference. */
func stripAtPrefix(string s): string {
    return s.startsWith("@") ? s.substring(1, s.length()) : s;
}

func applyServicesSection(GebwebApp app, dict<string, any> services): void {
    for (id, raw in services.items()) {
        if (raw instanceof string) {
            string target = raw as string;
            if (!target.startsWith("@")) {
                throw RuntimeError("gebweb config: services entry '" + id + "' must be a dict or '@target' alias");
            }
            di.registerAlias(app.container, id, stripAtPrefix(target));
            continue;
        }
        if (!(raw instanceof dict)) {
            throw RuntimeError("gebweb config: services entry '" + id + "' must be a dict or '@target' alias");
        }
        applyServiceEntry(app, id, raw as dict<string, any>);
    }
}

func applyServiceEntry(GebwebApp app, string id, dict<string, any> entry): void {
    any classRef = resolveServiceClass(id, entry);
    list<string> tags = stringListField(entry, "tags");
    bool shared = !entry.contains("shared") || (entry["shared"] as bool);

    if (entry.contains("args")) {
        let args = entry["args"] as dict<string, any>;
        let factory = makeServiceFactory(app, classRef, args);
        di.registerServiceFactory(app.container, id, classRef, factory, tags, shared);
    } else {
        di.registerService(app.container, id, classRef);
        for (t in tags) { di.tagService(app.container, id, t); }
        if (!shared) { app.container.serviceShared[id] = false; }
    }
    for (alias in stringListField(entry, "aliases")) {
        di.registerAlias(app.container, alias, id);
    }
}

func resolveServiceClass(string id, dict<string, any> entry): any {
    string className = entry.contains("class") ? (entry["class"] as string) : id;
    let cls = reflect.class(className);
    if (cls == null) {
        throw RuntimeError("gebweb config: services entry '" + id + "' references unknown class '" + className + "'");
    }
    return cls;
}

func stringListField(dict<string, any> entry, string key): list<string> {
    if (!entry.contains(key)) { return []; }
    let raw = entry[key] as list<any>;
    list<string> out = [];
    for (item in raw) { out = out.push(item as string); }
    return out;
}

/* Pre-reflects the ctor signature and binds the parameter resolver
 * so transient services don't pay reflection + resolver-allocation
 * on every resolve. */
func makeServiceFactory(GebwebApp app, any classRef, dict<string, any> argOverrides): callable {
    let resolver = parameterResolverFor(app);
    let ctors = reflect.constructors(classRef);
    list<any> params = ctors.length() == 0 ? [] : (ctors[0] as list<any>);
    return func(): any {
        if (params.length() == 0) { return classRef(); }
        list<any> ctorArgs = [];
        for (paramAny in params) {
            let param = paramAny as dict<string, any>;
            string pname = param["name"] as string;
            if (argOverrides.contains(pname)) {
                ctorArgs = ctorArgs.push(resolveArgValue(app, argOverrides[pname], resolver));
                continue;
            }
            ctorArgs = ctorArgs.push(di.resolveDependency(app.container, param, resolver));
        }
        return classRef(...ctorArgs);
    };
}

func resolveArgValue(GebwebApp app, any value, callable paramResolver): any {
    if (value instanceof string) {
        string s = value as string;
        if (s.startsWith("@")) {
            return di.resolveService(app.container, stripAtPrefix(s), paramResolver);
        }
        return resolveParamValue(app, s, [] as set<string>);
    }
    return resolveParamValue(app, value, [] as set<string>);
}

export func addControllers(GebwebApp app, list<any> controllers): GebwebApp {
    /* Dedup by class name so an explicitly-listed controller and the
     * same class found by auto-discovery mount their routes only once. */
    let registered = registeredControllerSet(app);
    list<any> resources = [];
    for (entry in controllers) {
        string key = controllerKey(entry);
        if (key != "" && registered.contains(key)) {
            continue;
        }
        if (key != "") {
            registered[key] = true;
        }
        if (isResourceEntry(entry)) {
            resources = resources.push(entry);
            continue;
        }
        let controller = resolveController(app, entry);
        registerControllerRoutes(app, controller);
    }
    for (resourceEntry in resources) {
        registerResourceRoutes(app, resourceEntry);
    }
    app.opsStore.set("registeredControllers", registered);
    return app;
}

func registeredControllerSet(GebwebApp app): dict<string, any> {
    let existing = app.opsStore.get("registeredControllers");
    return existing == null ? {} : (existing as dict<string, any>);
}

func controllerKey(any entry): string {
    let n = reflect.className(entry);
    return n == null ? "" : (n as string);
}

/**
 * True if `entry` is a class value carrying an `@ApiResource`
 * decorator. Used by `app(...)` to route the entry through the
 * auto-CRUD generator instead of the controller registrar.
 */
func isResourceEntry(any entry): bool {
    if ((reflect.typeOf(entry) as string) != "class") {
        return false;
    }
    return deco.hasDecorator(entry, "ApiResource");
}

/**
 * Returns the controller instance for an `app([...])` entry. Class
 * refs are resolved through the DI container; anything else is
 * treated as an already-constructed instance and used directly.
 */
func resolveController(GebwebApp app, any entry): any {
    let instance = entry;
    if (reflect.className(entry) != null
            && (reflect.typeOf(entry) as string) == "class") {
        instance = di.resolveWith(app.container, entry, parameterResolverFor(app));
    }
    bindControllerApp(app, instance);
    return instance;
}

/* try / catch instead of an `instanceof` check; importing
 * gebweb.controller here would cycle with controller.gb. */
func bindControllerApp(GebwebApp app, any instance): void {
    try {
        instance.bindApp(app);
    } catch (RuntimeError e) {}
}

/**
 * Generate the @ApiResource auto-CRUD routes for a resource class
 * and register the ones that aren't already in the route table.
 * The repository is resolved through the app's DI container so
 * tests can stub it via `gebweb.registerInstance`.
 */
func registerResourceRoutes(GebwebApp app, any resourceClass): void {
    let info = resource.scan(resourceClass);
    if (info == null) {
        return;
    }
    /* Resolve the repo lazily so tests can `registerInstance`
     * AFTER `gebweb.app([Resource])` and still see their stub. */
    let repoLookup = func(): any {
        return di.resolveWith(app.container, info.repoClass, parameterResolverFor(app));
    };
    let routes = resource.buildRoutes(app, info, repoLookup, app.assertions, app.routeMetadata);
    for (r in routes) {
        let route = r as dict<string, any>;
        webrouter.route(app.router, route["method"] as string,
            route["nativePath"] as string, route["handler"]);
        app.routeMetadata = app.routeMetadata.push(route["metadata"] as dict<string, any>);
    }
}

/**
 * Register a factory for a service class with this app's DI
 * container. The factory is called at most once per app; the
 * returned instance is reused for every controller constructor
 * that asks for the type.
 */
export func registerPerRequest(GebwebApp app, any classRef, callable factory): GebwebApp {
    di.registerPerRequest(app.container, classRef, factory);
    return app;
}

export func register(GebwebApp app, any classRef, callable factory): GebwebApp {
    di.register(app.container, classRef, factory);
    return app;
}

/**
 * Register an explicit pre-built instance for a service class.
 * Useful for tests that want to stub out a dependency.
 */
export func registerInstance(GebwebApp app, any classRef, any instance): GebwebApp {
    di.registerInstance(app.container, classRef, instance);
    return app;
}

/**
 * Resolve a class via the app's DI container directly. Mostly
 * useful from tests and from extension code; routes get their
 * controllers via `app(...)` automatically.
 */
export func resolve(GebwebApp app, any classRef): any {
    return di.resolveWith(app.container, classRef, parameterResolverFor(app));
}

/**
 * Register a custom @Assert.<name> validator on the app. The
 * validator is a callable receiving (value, positional args,
 * named args) and returning null on success or an error-message
 * string on failure.
 */
export func registerAssertion(GebwebApp app, string name, callable validator): GebwebApp {
    validation.register(app.assertions, name, validator);
    return app;
}

/**
 * Register an authenticator on the app. `userClass` is the class
 * the framework should inject into handler parameters of that type
 * (so user injection by type works on Geblang's typed parameter
 * list without parameter-level decorators). The authenticator is
 * a callable that takes the request dict and returns either the
 * user value (any user-defined class) or null when authentication
 * fails - the framework converts a null return into a 401 for any
 * handler that carries @Auth or @RequiresRole. Subsequent calls
 * replace the previous authenticator on the same app.
 */
export func useAuthenticator(GebwebApp app, any userClass, callable authenticator): GebwebApp {
    app.auth = authmod.newConfig(userClass, authenticator);
    return app;
}

/**
 * Wire an API-key authenticator on the app. The framework reads
 * the key from the `X-API-Key` header (preferred) or the
 * `Authorization: Bearer <key>` header (fallback). `resolveByKey`
 * is a callable `(string key): ?userClass` that maps a key to a
 * user value (or null when the key isn't valid).
 *
 * The OpenAPI security scheme is set to `apiKey` (in header,
 * named `X-API-Key`) instead of the default bearer/JWT scheme,
 * so the generated spec describes the actual auth flow.
 *
 *   gebweb.useApiKeyAuth(app, ServiceAccount,
 *       func(string key): ?ServiceAccount {
 *           if (!keys.contains(key)) { return null; }
 *           return keys[key] as ServiceAccount;
 *       });
 */
export func useApiKeyAuth(GebwebApp app, any userClass, callable resolveByKey): GebwebApp {
    callable authenticator = func(any request): any {
        let headers = (request["headers"] ?? {}) as dict<string, any>;
        string key = (headers["X-API-Key"] ?? "") as string;
        if (key.isEmpty()) {
            string authz = (headers["Authorization"] ?? "") as string;
            if (authz.startsWith("Bearer ")) {
                key = authz.substring(7, authz.length());
            }
        }
        if (key.isEmpty()) {
            return null;
        }
        return resolveByKey(key);
    };
    let cfg = authmod.newConfig(userClass, authenticator);
    cfg.securitySchemes = {
        "apiKeyAuth": {
            "type": "apiKey",
            "in": "header",
            "name": "X-API-Key",
        },
    };
    cfg.defaultSchemeName = "apiKeyAuth";
    app.auth = cfg;
    return app;
}

/**
 * Override the permission extractor on the app's auth config. The
 * callable receives the authenticated user value and returns
 * `list<string>` - the permissions the user holds. The default
 * extractor reads `user.permissions`; register a custom one when
 * permissions live elsewhere (e.g. resolved from a database
 * lookup by user id).
 */
export func usePermissions(GebwebApp app, callable extractor): GebwebApp {
    if (app.auth != null) {
        let cfg = app.auth as authmod.AuthConfig;
        cfg.permissionExtractor = extractor;
    }
    return app;
}

/**
 * Wire a session-backed authenticator on the app. `store` is any
 * value with a `load(request): dict<string, any>` method - the
 * stdlib provides `web.session.{redisSessionStore, fileSessionStore,
 * databaseSessionStore}`. `userClass` is the class the framework
 * injects into typed handler parameters. `fromSession` is a callable
 * `(dict<string, any> data): ?userClass` that turns the loaded
 * session dict into a user value (or null when the session is
 * present but the data is not a valid user - e.g. tampered).
 *
 * An empty session dict from `store.load` (no `geb_sid` cookie, or
 * an expired entry) maps directly to a 401 without calling
 * `fromSession`. The default OpenAPI security scheme is swapped to
 * a cookie-based `cookieAuth` (apiKey / cookie / `geb_sid`) since
 * the JWT bearer default doesn't describe a session-cookie flow.
 *
 *   import gebweb;
 *   import web.session as session;
 *
 *   class CurrentUser {
 *       string id;
 *       string name;
 *       list<string> roles;
 *   }
 *
 *   let store = session.fileSessionStore("/tmp/app-sessions", 3600);
 *   gebweb.useSessionAuth(app, store, CurrentUser,
 *       func(dict<string, any> data): ?CurrentUser {
 *           if (!data.contains("id")) { return null; }
 *           return CurrentUser(
 *               data["id"] as string,
 *               (data["name"] ?? "") as string,
 *               (data["roles"] ?? []) as list<string>);
 *       });
 *
 * Login/logout flow stays the user's responsibility - call
 * `store.save(response, data, options)` from the login handler and
 * `store.clear(response, request)` from the logout handler.
 */
/**
 * Register a response cache store on the app. `store` is any value
 * with `get(key): any` and `set(key, value): bool` methods - the
 * stdlib provides `web.cache.{redisCacheStore, fileCacheStore,
 * databaseCacheStore}`. Once registered, any handler (or controller
 * class) carrying `@Cache(ttl: N)` or `@Cache(ttl: N, vary: [...])`
 * opts the route into response caching: a cache hit short-circuits
 * binding + handler dispatch, while a miss runs the handler and
 * writes the (2xx) response back. The `ttl` named arg overrides the
 * store's coarser TTL via an inner envelope; `vary` lists header
 * names that augment the cache key (e.g. `Authorization` for
 * per-user caches). Subsequent calls replace the previous store.
 *
 *   import gebweb;
 *   import web.cache as cachemod;
 *
 *   let store = cachemod.fileCacheStore("/tmp/app-cache", 3600);
 *   gebweb.useCacheStore(app, store);
 *
 *   class FeedController {
 *       @Get("/feed")
 *       @Cache(ttl: 60)
 *       func feed(): dict<string, any> { return expensiveLookup(); }
 *   }
 */
/**
 * Set the app-wide request body cap in bytes (default 10 MB). The cap
 * is enforced at the HTTP server (413 before any handler work) and in
 * the dispatcher for in-process clients. 0 disables the cap. A route
 * can lower it further with `@MaxBody(bytes)`.
 */
export func useMaxBodyBytes(GebwebApp app, int maxBytes): GebwebApp {
    app.maxBodyBytes = maxBytes;
    return app;
}

func makeMetricsLookup(GebwebApp app): callable {
    return func(): ?metricsmod.MetricsConfig {
        return app.metricsConfig;
    };
}

/**
 * Mount a Prometheus metrics endpoint (default `/metrics`) fed by
 * per-route request counters, latency totals, and an in-flight gauge.
 * Protect the path at the proxy or with middleware if it should not
 * be public.
 */
export func useMetrics(GebwebApp app, dict<string, any> opts = {}): GebwebApp {
    let cfg = metricsmod.newConfig(opts);
    app.metricsConfig = cfg;
    webrouter.route(app.router, "GET", cfg.path, func(dict<string, any> request): dict<string, any> {
        return {
            "status": 200,
            "headers": {"Content-Type": "text/plain; version=0.0.4"},
            "body": metricsmod.renderPrometheus(cfg),
        };
    });
    return app;
}

/**
 * The production endpoint bundle: health liveness/readiness probes
 * (gebweb.useHealth) plus the Prometheus metrics endpoint
 * (gebweb.useMetrics) in one call.
 */
export func useOps(GebwebApp app, list<any> instances = [], dict<string, any> opts = {}): GebwebApp {
    useHealth(app, instances, opts);
    useMetrics(app, opts);
    return app;
}

/**
 * Wire the request-context convention: every request gets a
 * correlation id (inbound X-Request-Id or generated), readable via
 * `req.requestId()`, echoed on the response, and bindable into a
 * per-request logger with `gebweb.requestLogger(req)`.
 */
/**
 * Hydrate `configClass` from environment variables and the app's
 * parameter store, validating @Assert constraints. Required fields
 * with no value throw at boot, naming the env var to set.
 */
export func bindConfig(GebwebApp app, any configClass, dict<string, any> opts = {}): any {
    let instance = typedconfigmod.bind(configClass, app.parameters, opts);
    let failures = validateInstance(app, instance);
    if (failures.length() > 0) {
        list<string> messages = [];
        for (f in failures) {
            messages = messages.push("${f}");
        }
        throw RuntimeError("config validation failed: " + messages.join("; "));
    }
    return instance;
}

/**
 * Drop every cached response recorded under `tag` (see
 * `@Cache(tags: [...])`). Returns the number of entries removed.
 */
export func cacheInvalidate(GebwebApp app, string tag): int {
    if (app.cache == null) {
        return 0;
    }
    return cachemod.invalidateTag(app.cache as cachemod.CacheConfig, tag);
}

/**
 * Mount a JWKS document (default `/.well-known/jwks.json`) exposing
 * the app's public signing keys. `keys` is a list accepted by
 * `crypt.jwks` (PEM strings, `{pem, kid, alg}` dicts, or ready JWK
 * dicts) or a prebuilt JWKS dict. The document is rendered once at
 * mount time.
 */
export func useJwks(GebwebApp app, any keys, dict<string, any> opts = {}): GebwebApp {
    string path = (opts["path"] ?? "/.well-known/jwks.json") as string;
    let document = keys instanceof dict
        ? keys as dict<string, any>
        : crypt.jwks(keys as list<any>) as dict<string, any>;
    string body = json.stringify(document);
    webrouter.route(app.router, "GET", path, func(dict<string, any> request): dict<string, any> {
        return {
            "status": 200,
            "headers": {"Content-Type": "application/json", "Cache-Control": "public, max-age=300"},
            "body": body,
        };
    });
    return app;
}

export func useRequestContext(GebwebApp app): GebwebApp {
    before(app, mwmod.requestContext());
    use(app, mwmod.requestContextHeader());
    return app;
}

export func useCacheStore(GebwebApp app, any store): GebwebApp {
    app.cache = cachemod.CacheConfig(store);
    return app;
}

export func useIdempotencyStore(GebwebApp app, any store): GebwebApp {
    app.idempotencyStore = store;
    return app;
}

/**
 * Attach a view engine rooted at `dir`. Templates are loaded
 * relative to that directory via `gebweb.view(app, name, ctx)`.
 */
export func useViews(GebwebApp app, string dir = "templates"): GebwebApp {
    app.viewEngine = viewsmod.ViewEngine(dir);
    return app;
}

/** Compile named templates now in production; development remains lazy. */
export func preloadViews(GebwebApp app, list<string> names): GebwebApp {
    if (app.viewEngine == null) {
        throw errors.new("RuntimeError", "gebweb.preloadViews: call gebweb.useViews(app) first");
    }
    (app.viewEngine as viewsmod.ViewEngine).preload(names);
    return app;
}

/** Returns the registered view engine or null. */
export func views(GebwebApp app): ?viewsmod.ViewEngine {
    return app.viewEngine;
}

/**
 * Attach a background-job queue to the app, backed by `conn`.
 * Auto-creates the `gebweb_jobs` table if missing. Options:
 *   - pollIntervalMs (default 1000)
 *   - maxAttempts (default 5)
 *   - backoffMs (default [1s, 5s, 30s, 2m, 10m])
 */
export func useJobs(GebwebApp app, db.Connection conn, dict<string, any> opts): GebwebApp {
    app.jobConfig = jobsmod.newConfig(conn, opts);
    return app;
}

/** Returns the registered job config or null. */
export func jobs(GebwebApp app): ?jobsmod.JobConfig {
    return app.jobConfig;
}

/**
 * Attach a scheduler to the app. Uses the connection from the
 * already-registered job queue (or, when `conn` is provided
 * explicitly, that connection). Options: `tickIntervalMs`,
 * `leaseSec`, `workerId`.
 */
export func useScheduler(GebwebApp app, dict<string, any> opts): GebwebApp {
    any conn = null;
    if (opts.contains("conn")) {
        conn = opts["conn"];
    } else if (app.jobConfig != null) {
        conn = (app.jobConfig as jobsmod.JobConfig).conn;
    } else {
        throw errors.new("RuntimeError", "useScheduler: pass conn in opts or call useJobs first");
    }
    app.schedulerConfig = schedmod.newConfig(conn, opts);
    return app;
}

/** Returns the registered scheduler config or null. */
export func scheduler(GebwebApp app): ?schedmod.ScheduleConfig {
    return app.schedulerConfig;
}

/** Attach the in-process event bus to the app. */
export func useEvents(GebwebApp app): GebwebApp {
    app.eventConfig = eventsmod.newConfig();
    return app;
}

/** Returns the registered event bus or null. */
export func events(GebwebApp app): ?eventsmod.EventConfig {
    return app.eventConfig;
}

/** Lazily attach the broker-messaging registry. Safe to call
 *  multiple times - subsequent calls reuse the existing config. */
export func useMessaging(GebwebApp app): GebwebApp {
    if (app.messagingConfig == null) {
        app.messagingConfig = messagingmod.newConfig();
    }
    return app;
}

/** Returns the registered messaging config or null. */
export func messaging(GebwebApp app): ?messagingmod.MessagingConfig {
    return app.messagingConfig;
}

/** Attach a mailer transport. Also registers the
 *  _gebweb_mailer_deliver job handler when a job queue is
 *  available, so `gebweb.send` can defer delivery. */
export func useMailer(GebwebApp app, mailingmod.MailerContract transport): GebwebApp {
    app.mailerTransport = transport;
    if (app.jobConfig != null) {
        jobsmod.registerHandlers(
            app.jobConfig as jobsmod.JobConfig,
            [mailingmod.MailerJobHandler()]
        );
    }
    return app;
}

/** Returns the registered mailer transport or null. */
export func mailer(GebwebApp app): ?mailingmod.MailerContract {
    return app.mailerTransport;
}

/** Attach an LLM client (any `llm.Client` implementation). The
 *  client is then resolvable through the DI container so handler
 *  constructors can ask for `llm.Client` directly. */
export func useLlm(GebwebApp app, llmmod.Client client): GebwebApp {
    app.llmClient = client;
    di.registerInterfaceInstance(app.container, "llm.Client", client);
    return app;
}

/** Returns the registered LLM client or null. */
export func llm(GebwebApp app): ?llmmod.Client {
    return app.llmClient;
}

/** Resolves a service by its registered string id. Services get
 *  ids via `@Service("id")` on the class (or the bare class name
 *  when the decorator carries no argument). The instance is built
 *  through the normal autowire path. */
export func service(GebwebApp app, string id): any {
    return di.resolveService(app.container, id, parameterResolverFor(app));
}

/** True when a service with this id is registered. */
export func hasService(GebwebApp app, string id): bool {
    return di.hasService(app.container, id);
}

/** All registered service ids. */
export func serviceIds(GebwebApp app): list<string> {
    return di.serviceIds(app.container);
}

/** All registered interface->service-id bindings. */
export func interfaceBindings(GebwebApp app): dict<string, string> {
    return di.interfaceBindings(app.container);
}

/** Resolve every service carrying `tag`, in service-registration
 *  order. Each instance is built through `service(app, id)` so
 *  per-service shared/transient policy still holds. */
export func taggedServices(GebwebApp app, string tag): list<any> {
    list<any> out = [];
    for (id in di.taggedServiceIds(app.container, tag)) {
        out = out.push(service(app, id));
    }
    return out;
}

/** Service ids carrying `tag`, in registration order, without
 *  resolving the instances. Useful when the consumer wants to
 *  inspect the tag set or defer construction. */
export func taggedServiceIds(GebwebApp app, string tag): list<string> {
    return di.taggedServiceIds(app.container, tag);
}

/** Tags attached to a service id, in insertion order. */
export func tagsForService(GebwebApp app, string id): list<string> {
    return di.tagsForService(app.container, id);
}

/** Attach a secrets provider so %secret(...)% markers in YAML
 *  parameters resolve. Built-in: gebweb.encryptedFileSecrets(path);
 *  custom providers implement SecretsProvider. */
export func useSecrets(GebwebApp app, secretsmod.SecretsProvider provider): GebwebApp {
    app.secretsProvider = provider;
    return app;
}

/** Returns the registered secrets provider or null. */
export func secrets(GebwebApp app): ?secretsmod.SecretsProvider {
    return app.secretsProvider;
}

/** Attach a storage backend (memory, local disk, custom). */
export func useStorage(GebwebApp app, storagemod.StorageContract backend): GebwebApp {
    app.storage = backend;
    return app;
}

/** Returns the registered storage backend or null. */
export func storage(GebwebApp app): ?storagemod.StorageContract {
    return app.storage;
}

/**
 * Register a session store. Required for flash messages and
 * form-state rehydration. Any value with `load(request)` and
 * `save(response, data, opts)` methods works (the stdlib provides
 * FileSessionStore / RedisSessionStore / DatabaseSessionStore).
 * useSessionAuth() also calls this internally so you don't need
 * to register twice.
 */
/**
 * Protect /docs and /openapi.json with a guard. The guard is a
 * callable that receives the raw request dict and returns either
 * null (pass-through) or a response dict (deny + short-circuit).
 *
 * Pass any of the framework-provided builders or any custom
 * callable that matches the contract:
 *
 *     gebweb.useDocsAuth(app, gebweb.basicAuthGuard("admin", "s3cret"));
 *     gebweb.useDocsAuth(app, gebweb.bearerTokenGuard("expected"));
 *     gebweb.useDocsAuth(app, gebweb.requireAppAuth(app));
 *     gebweb.useDocsAuth(app, func(dict<string, any> req): ?dict<string, any> {
 *         // custom: check a header, IP allow-list, etc.
 *         return null;
 *     });
 *
 * Set BEFORE the call to gebweb.serve so the guard wraps both
 * docs routes at app-build time.
 */
export func useDocsAuth(GebwebApp app, callable guard): GebwebApp {
    app.docsGuard = guard;
    return app;
}

/**
 * Builds a HTTP Basic-Auth guard. Compares the supplied user +
 * password using constant-time comparison; on mismatch returns a
 * 401 response with the WWW-Authenticate challenge.
 */
export func basicAuthGuard(string user, string password): callable {
    string realm = "Gebweb docs";
    return func(any request): ?dict<string, any> {
        let headers = request["headers"] as dict<string, any>;
        if (!headers.contains("Authorization") && !headers.contains("authorization")) {
            return basicAuthChallenge(realm);
        }
        string header = (headers.contains("Authorization")
            ? headers["Authorization"]
            : headers["authorization"]) as string;
        if (!header.startsWith("Basic ")) {
            return basicAuthChallenge(realm);
        }
        let decoded = crypt.base64Decode(header.substring(6));
        let colon = decoded.indexOf(":");
        if (colon < 0) {
            return basicAuthChallenge(realm);
        }
        string suppliedUser = decoded.substring(0, colon);
        string suppliedPass = decoded.substring(colon + 1);
        if (suppliedUser == user && suppliedPass == password) {
            return null;
        }
        return basicAuthChallenge(realm);
    };
}

func basicAuthChallenge(string realm): dict<string, any> {
    return {
        "status": 401,
        "headers": {
            "Content-Type": "text/plain",
            "WWW-Authenticate": "Basic realm=\"" + realm + "\"",
        },
        "body": "401 Unauthorized",
    };
}

/**
 * Builds a Bearer-token guard with a hard-coded expected token.
 * Useful for sharing a single shared-secret token (read-only API
 * keys, CI access, etc.). For JWT-based protection that ties into
 * the app's existing authenticator, use `requireAppAuth(app)`
 * instead.
 */
export func bearerTokenGuard(string expected): callable {
    return func(any request): ?dict<string, any> {
        let headers = request["headers"] as dict<string, any>;
        string header = headers.contains("Authorization")
            ? (headers["Authorization"] as string)
            : (headers.contains("authorization") ? (headers["authorization"] as string) : "");
        if (!header.startsWith("Bearer ")) {
            return bearerChallenge();
        }
        let supplied = header.substring(7);
        if (supplied == expected) {
            return null;
        }
        return bearerChallenge();
    };
}

func bearerChallenge(): dict<string, any> {
    return {
        "status": 401,
        "headers": {
            "Content-Type": "text/plain",
            "WWW-Authenticate": "Bearer",
        },
        "body": "401 Unauthorized",
    };
}

/**
 * Builds a guard that reuses the app's configured authenticator
 * (whatever `useAuthenticator`, `useJWT`, `useSessionAuth`, etc.
 * registered). Returns 401 when authentication fails; if
 * `requiredRoles` is non-empty, returns 403 when the user has none
 * of the listed roles.
 *
 *     // Any authenticated user
 *     gebweb.useDocsAuth(app, gebweb.requireAppAuth(app));
 *
 *     // Only users with the `api_admin` role
 *     gebweb.useDocsAuth(app, gebweb.requireAppAuth(app, ["api_admin"]));
 *
 *     // Multiple acceptable roles - any one matches
 *     gebweb.useDocsAuth(app, gebweb.requireAppAuth(app, ["api_admin", "owner"]));
 *
 * Throws RuntimeError at registration time if the app has no
 * authenticator configured.
 */
export func requireAppAuth(GebwebApp app, list<string> requiredRoles = []): callable {
    if (app.auth == null) {
        throw errors.new("RuntimeError",
            "requireAppAuth: app has no authenticator. Call useAuthenticator / useJWT / useSessionAuth before useDocsAuth.");
    }
    let cfg = app.auth as authmod.AuthConfig;
    let authenticator = cfg.authenticator;
    let roleExtractor = cfg.roleExtractor;
    return func(any request): ?dict<string, any> {
        let user = authenticator(request);
        if (user == null) {
            return bearerChallenge();
        }
        if (requiredRoles.length() > 0) {
            let roles = roleExtractor(user) as list<string>;
            bool ok = false;
            for (need in requiredRoles) {
                for (have in roles) {
                    if ((have as string) == (need as string)) {
                        ok = true;
                    }
                }
            }
            if (!ok) {
                return {
                    "status": 403,
                    "headers": {"Content-Type": "text/plain"},
                    "body": "403 Forbidden",
                };
            }
        }
        return null;
    };
}

export func useSession(GebwebApp app, any store): GebwebApp {
    app.sessionStore = store;
    /* Register the flash view-context injector. It reads + clears
     * messages so each render sees them at most once. The actual
     * delete happens in the after-middleware below once we have
     * the response in hand. */
    registerViewContext(app, "flashes", func(reqmod.Request request): any {
        let s = app.sessionStore;
        if (s == null) {
            return {};
        }
        let result = flashmod.currentFlashes(s, request.toDict());
        if (result.length() > 0) {
            request["_consumeFlash"] = true;
        }
        return result;
    });
    registerViewContext(app, "old", func(reqmod.Request request): any {
        let s = app.sessionStore;
        if (s == null) {
            return {};
        }
        let result = formsmod.currentOldInput(s, request.toDict());
        if (result.length() > 0) {
            request["_consumeFormState"] = true;
        }
        return result;
    });
    registerViewContext(app, "errors", func(reqmod.Request request): any {
        let s = app.sessionStore;
        if (s == null) {
            return {};
        }
        let result = formsmod.currentErrors(s, request.toDict());
        if (result.length() > 0) {
            request["_consumeFormState"] = true;
        }
        return result;
    });
    /* After-middleware that clears one-shot session state (flash
     * messages + form rehydration) once the response is built so
     * each piece survives exactly one render. */
    after(app, func(any request, any response): any {
        let s = app.sessionStore;
        if (s == null) {
            return response;
        }
        /* flash/forms consume operate on the response + request dicts; convert
         * at this boundary and let the middleware wrapper re-wrap the result. */
        dict<string, any> working = (response as http.Response).toDict();
        dict<string, any> reqDict = (request as reqmod.Request).toDict();
        if (request.contains("_consumeFlash")) {
            working = flashmod.consume(s, working, reqDict, {});
        }
        if (request.contains("_consumeFormState")) {
            working = formsmod.consume(s, working, reqDict);
        }
        return working;
    });
    return app;
}

export func session(GebwebApp app): ?any {
    return app.sessionStore;
}

/**
 * Bound concurrent in-flight requests. When more than
 * `opts.maxConcurrent` are being served, further requests get a 503
 * before any handler runs, so a load spike sheds load instead of
 * exhausting memory. Set `opts.onOverload` to a `(): response`
 * callable to customise the rejection. Wire it only with a value
 * measured against per-request memory under load.
 */
export func useAdmissionControl(GebwebApp app, dict<string, any> opts): GebwebApp {
    int max = opts["maxConcurrent"] as int;
    if (max <= 0) {
        throw errors.new("RuntimeError", "gebweb.useAdmissionControl: opts.maxConcurrent must be a positive integer");
    }
    /* opsStore is shared across request clones so the dispatcher gate sees one counter. */
    app.opsStore.set("admission", {"counter": atomic.AtomicInt(0), "max": max, "opts": opts});
    return app;
}

/* Reserves a slot: returns {admitted, state} when admitted, {admitted:false, response} when shed. */
func admissionAcquire(GebwebApp app): ?dict<string, any> {
    let state = app.opsStore.get("admission");
    if (state == null) { return null; }
    let s = state as dict<string, any>;
    let counter = s["counter"] as atomic.AtomicInt;
    if (counter.add(1) > (s["max"] as int)) {
        counter.add(-1);
        return {"admitted": false, "response": admissionOverload(s["opts"] as dict<string, any>)};
    }
    return {"admitted": true, "counter": counter};
}

func admissionRelease(?dict<string, any> ticket): void {
    if (ticket == null || !((ticket as dict<string, any>)["admitted"] as bool)) { return; }
    ((ticket as dict<string, any>)["counter"] as atomic.AtomicInt).add(-1);
}

func admissionOverload(dict<string, any> opts): any {
    if (opts.contains("onOverload")) {
        return (opts["onOverload"] as callable)();
    }
    return http.response("Service Unavailable", 503)
        .withHeader("Content-Type", "text/plain; charset=utf-8")
        .withHeader("Retry-After", "1");
}

/**
 * Mount a directory of static assets with content-hash fingerprinting.
 * Files served from `dir` are accessible under `opts.urlPrefix`
 * (default `/assets`) with a cache-busting hash in the filename:
 * `app.css` -> `/assets/app-7b2f9c4d.css`. The `asset()` view helper
 * resolves logical names to fingerprinted URLs.
 *
 * Options:
 *   - urlPrefix:    URL prefix for served files (default "/assets")
 *   - cacheControl: response header (default long-cache immutable)
 *   - fingerprint:  set false to skip hashing (default true)
 *   - dev:          set true to recompute hashes per request and
 *                   also accept unhashed names (default false)
 */
export func useStaticAssets(GebwebApp app, string dir, dict<string, any> opts = {}): GebwebApp {
    app.assetConfig = assetsmod.newConfig(dir, opts);
    /* Register `asset()` as a view-engine filter so templates call
     * it inline: `{{ asset("x.css") }}`. Engine filters take the
     * value before-the-pipe as their first arg; with no pipe, the
     * parser supplies the argument directly. */
    let engine = app.viewEngine;
    if (engine != null) {
        installAssetFilter(engine as viewsmod.ViewEngine, app.assetConfig as assetsmod.AssetConfig);
    }
    return app;
}

func installAssetFilter(viewsmod.ViewEngine engine, assetsmod.AssetConfig cfg): void {
    engine.addFilter("asset", func(any logical): string {
        return assetsmod.assetUrl(cfg, logical as string);
    });
}

export func assets(GebwebApp app): ?assetsmod.AssetConfig {
    return app.assetConfig;
}

export func useSessionAuth(GebwebApp app, any store, any userClass, callable fromSession): GebwebApp {
    app.sessionStore = store;
    let authenticator = func(any request): ?any {
        let data = store.load((request as reqmod.Request).toDict()) as dict<string, any>;
        if (data.isEmpty()) {
            return null;
        }
        return fromSession(data);
    };
    app.auth = authmod.newConfig(userClass, authenticator);
    authmod.registerSecurityScheme(app.auth as authmod.AuthConfig, "cookieAuth", {
        "type": "apiKey",
        "in": "cookie",
        "name": "geb_sid",
    }, true);
    return app;
}

/**
 * Override the default role extractor (which reads `.roles` off the
 * user value). The extractor takes the user value and returns the
 * user's roles as `list<string>`. Useful when the user value is a
 * dict, an opaque type, or stores roles under a different field.
 * Must be called AFTER useAuthenticator.
 */
export func useRoleExtractor(GebwebApp app, callable extractor): GebwebApp {
    if (app.auth == null) {
        throw RuntimeError("useRoleExtractor requires a prior useAuthenticator call");
    }
    let cfg = app.auth as authmod.AuthConfig;
    cfg.roleExtractor = extractor;
    return app;
}

/**
 * Register (or replace) an OpenAPI security scheme on the app.
 * The default `useAuthenticator` call already registers a
 * `bearerAuth` scheme (HTTP / bearer / JWT). Call this to declare
 * an additional scheme - e.g. API-key in header, OAuth2 - or to
 * override the default. Pass `setAsDefault: true` to make this the
 * scheme attached to every `@Auth` / `@RequiresRole`-gated
 * operation. Must be called AFTER useAuthenticator.
 *
 *   gebweb.useSecurityScheme(app, "apiKey", {
 *       "type": "apiKey",
 *       "in": "header",
 *       "name": "X-API-Key",
 *   }, true);
 */
export func useSecurityScheme(GebwebApp app, string name, dict<string, any> definition, bool setAsDefault): GebwebApp {
    if (app.auth == null) {
        throw RuntimeError("useSecurityScheme requires a prior useAuthenticator call");
    }
    let cfg = app.auth as authmod.AuthConfig;
    authmod.registerSecurityScheme(cfg, name, definition, setAsDefault);
    return app;
}

/**
 * Register a response-phase middleware. The callable takes
 * `(request, response)` and returns the (possibly transformed)
 * response. Use this for CORS headers, security headers, request
 * logging, response compression, etc.
 */
export func use(GebwebApp app, callable mw): GebwebApp {
    webrouter.use(app.router, wrapAfterMiddleware(mw));
    return app;
}

/**
 * Register a request-phase middleware. The callable takes a rich
 * `Request` and returns either null (continue to the handler) or a
 * `Response` (short-circuit). Use this for auth gates, rate-limit
 * checks, anything that needs to reject a request before it reaches
 * the typed handler.
 */
export func before(GebwebApp app, callable mw): GebwebApp {
    webrouter.before(app.router, wrapBeforeMiddleware(mw));
    return app;
}

/** Alias of `use` for readability when registering response-phase
 *  middleware near other after-handler code. */
export func after(GebwebApp app, callable mw): GebwebApp {
    return use(app, mw);
}

/* Middleware run on the dict-based native router; these wrappers give
 * the user-supplied middleware the rich Request/Response objects and
 * normalize back to dicts at the router boundary. */
func wrapBeforeMiddleware(callable mw): callable {
    return func(dict<string, any> request): any {
        return mw(reqmod.Request(request));
    };
}

func wrapAfterMiddleware(callable mw): callable {
    return func(dict<string, any> request, dict<string, any> response): dict<string, any> {
        let result = mw(reqmod.Request(request), http.response(response));
        dict<string, any> out = result instanceof http.Response ? (result as http.Response).toDict() : (result as dict<string, any>);
        /* Re-attach the marker the Response round-trip drops only when the middleware left status and body untouched; a replacement (deny, error page, negotiated content) wins over the file. */
        if (response.contains("__serveFile") && !out.contains("__serveFile") && !replacedFileResponse(response, out)) {
            out["__serveFile"] = response["__serveFile"];
        }
        return out;
    };
}

func replacedFileResponse(dict<string, any> original, dict<string, any> out): bool {
    int origStatus = original.contains("status") ? (original["status"] as int) : 200;
    int newStatus = out.contains("status") ? (out["status"] as int) : 200;
    if (newStatus != origStatus) {
        return true;
    }
    return out.contains("body") && !emptyResponseBody(out["body"]);
}

func emptyResponseBody(any body): bool {
    if (body == null) {
        return true;
    }
    if (body instanceof string) {
        return (body as string).isEmpty();
    }
    if (body instanceof bytes) {
        return (body as bytes).isEmpty();
    }
    return false;
}

/**
 * Register a plugin on the app. A plugin is any value with an
 * `install(app)` method (typically a class extending
 * `gebweb.Plugin`). The plugin is appended to `app.plugins` and
 * `install` is invoked immediately so the plugin can register
 * middleware, mount routes, configure authenticators, or extend
 * the assertion registry through the existing public API.
 *
 * Plugins are the standard extension point for sibling Geblang
 * packages (e.g. `gebweb-auth-oauth2`) - they keep the core lean
 * while letting opt-in features ship out-of-tree.
 */
export func plugin(GebwebApp app, pluginmod.PluginContract pluginInstance): GebwebApp {
    app.plugins = app.plugins.push(pluginInstance);
    pluginInstance.install(app);
    return app;
}

/**
 * Find a registered plugin by name (matches `plugin.name()`). Returns
 * the first match or null. Useful for plugins that want to look up
 * peer plugins, and for tests that want to inspect installed
 * plugins.
 */
export func findPlugin(GebwebApp app, string name): ?pluginmod.PluginContract {
    for (p in app.plugins) {
        if (p.name() == name) {
            return p;
        }
    }
    return null;
}

/**
 * Run the app's @Assert validators against an instance and return
 * the list of failures (empty when the instance is valid). Called
 * by binding.gb / resource.gb after body deserialization; user code
 * can call it directly to validate values constructed outside the
 * request path.
 */
export func validateInstance(GebwebApp app, any instance): list<validation.ValidationError> {
    return validation.validate(app.assertions, instance);
}

/**
 * Returns the dispatch callable that runs a request through the
 * registered routes. Suitable for handing to http.serve, http.listen,
 * or for direct use by TestClient.
 */
export func dispatcher(GebwebApp app): callable {
    return func(dict<string, any> request): dict<string, any> {
        /* finally releases even when dispatch throws, so no admitted slot leaks. */
        let ticket = admissionAcquire(app);
        if (ticket != null && !((ticket as dict<string, any>)["admitted"] as bool)) {
            return normalizeDispatchResponse((ticket as dict<string, any>)["response"]);
        }
        try {
            return dispatchRequest(app, request);
        } finally {
            admissionRelease(ticket);
        }
    };
}

func dispatchRequest(GebwebApp app, dict<string, any> request): dict<string, any> {
    /* Static assets short-circuit the router; nothing on this path needs request-scoped DI. */
    if (app.assetConfig != null) {
        let cfg = app.assetConfig as assetsmod.AssetConfig;
        string path = request["path"] as string;
        if (path.startsWith(cfg.urlPrefix + "/")) {
            return assetsmod.serveAsset(cfg, request);
        }
    }
    if (app.maxBodyBytes > 0) {
        let rawBody = request["body"] ?? "";
        /* Rune count * 4 bounds the UTF-8 byte length so small bodies skip the byte copy. */
        if (rawBody instanceof string && (rawBody as string).length() * 4 > app.maxBodyBytes) {
            if (((rawBody as string) as bytes).length() > app.maxBodyBytes) {
                return weberrors.problemResponse(weberrors.PayloadTooLargeError("request body exceeds " + (app.maxBodyBytes as string) + " bytes"));
            }
        }
    }
    /* A DI request scope shares per-request bindings; apps with none skip it. */
    if (!di.hasPerRequestBindings(app.container)) {
        return webrouter.handle(app.router, request) as dict<string, any>;
    }
    return di.withRequestScope(app.container, func(): dict<string, any> {
        return webrouter.handle(app.router, request);
    }) as dict<string, any>;
}

/* The overload response is a Response builder or a plain dict; the dispatcher returns a dict. */
func normalizeDispatchResponse(any response): dict<string, any> {
    if (response instanceof http.Response) {
        return (response as http.Response).toDict();
    }
    if (response instanceof dict) {
        return response as dict<string, any>;
    }
    /* A handler or onOverload that returned null or a non-response value must not crash the dispatcher. */
    return {"status": 500, "headers": {"Content-Type": "text/plain"}, "body": "Internal Server Error"};
}

/**
 * Serve the app on the given address. Blocks until the server stops.
 * `opts` is forwarded to `http.serve` and accepts the same shape:
 *
 *   - `{reactor: true}` to use the epoll/kqueue reactor backend
 *     (high-throughput, low memory under many concurrent connections).
 *   - `{maxConns: N}` to cap the goroutine pool when the default
 *     goroutine-per-connection model would push too much memory.
 *   - `{overload: "drop"|"reject"|"queue"}` to choose backpressure
 *     behaviour under reactor mode.
 *
 * Pass `null` (the default) to use the goroutine-per-connection
 * backend with no caps.
 */
export func serve(GebwebApp app, string address, ?dict<string, any> opts = null): void {
    int handle = listen(app, address, opts);
    http.wait(handle);
}

/* Forward the app body cap to the HTTP server unless the caller set
 * their own maxBodyBytes. */
func serverOpts(GebwebApp app, ?dict<string, any> opts): dict<string, any> {
    dict<string, any> merged = {};
    if (opts != null) {
        for (k in (opts as dict<string, any>).keys()) {
            merged[k as string] = (opts as dict<string, any>)[k as string];
        }
    }
    if (!merged.contains("maxBodyBytes") && app.maxBodyBytes > 0) {
        merged["maxBodyBytes"] = app.maxBodyBytes;
    }
    /* Share the dispatcher (and its application graph) across requests rather than deep-cloning it per request; the framework isolates per-request state via per-request DI. */
    if (!merged.contains("shareHandler")) {
        merged["shareHandler"] = true;
    }
    return merged;
}

/**
 * Start the app on the given address in the background, returning a
 * handle (int64) suitable for passing to `http.shutdown` or
 * `http.close`. `opts` accepts the same shape as `serve` for
 * reactor / concurrency tuning.
 */
export func listen(GebwebApp app, string address, ?dict<string, any> opts = null): int {
    int handle = http.listen(address, dispatcher(app), serverOpts(app, opts));
    trackServerHandle(app, handle);
    return handle;
}

/**
 * Record a listener handle so `gebweb.shutdown` drains it. `listen`
 * calls this itself; register auxiliary listeners (HTTP-to-HTTPS
 * redirects, extra ports) here too.
 */
export func trackServerHandle(GebwebApp app, int handle): void {
    list<any> handles = [];
    let existing = app.opsStore.get("serverHandles");
    if (existing != null && existing instanceof list) {
        handles = existing as list<any>;
    }
    handles = handles.push(handle);
    app.opsStore.set("serverHandles", handles);
}

/**
 * Gracefully drain and stop the app's server: readiness flips to 503
 * (rolling deploys stop sending traffic), in-flight requests finish
 * within `opts.timeoutMs` (default 10000), then the listener closes
 * and any `gebweb.serve` / `http.wait` callers return. Safe to call
 * from a signal handler.
 */
export func shutdown(GebwebApp app, dict<string, any> opts = {}): void {
    int timeoutMs = (opts["timeoutMs"] ?? 10000) as int;
    app.opsStore.set("draining", true);
    let handles = app.opsStore.get("serverHandles");
    if (handles != null && handles instanceof list) {
        for (handle in handles as list<any>) {
            http.shutdown(handle as int, timeoutMs);
        }
    }
}

/** True once gebweb.shutdown has started. Long-running loops (job
 *  workers, scheduler ticks) should exit when this flips. */
export func isDraining(GebwebApp app): bool {
    return (app.opsStore.get("draining") ?? false) as bool;
}

/** Exposes the underlying stdlib/web router for power users. */
export func router(GebwebApp app): dict<string, any> {
    return app.router;
}

/** Returns the registered route table for introspection. */
export func routes(GebwebApp app): list<dict<string, any>> {
    return app.routeMetadata;
}
