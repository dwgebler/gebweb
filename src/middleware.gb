module gebweb.middleware;

/**
 * Middleware framework for Gebweb. Sits on top of `stdlib/web/router`'s
 * before / after hooks but exposes an options-dict API that better
 * matches the rest of Gebweb's surface.
 *
 *   import gebweb;
 *   import gebweb.middleware as mw;
 *
 *   let app = gebweb.app([HelloController()]);
 *   gebweb.use(app, mw.securityHeaders({}));
 *   gebweb.use(app, mw.cors({"origin": "https://example.com"}));
 *   gebweb.use(app, mw.requestLog({}));
 *   gebweb.serve(app, "127.0.0.1:8080");
 *
 * Three middleware phases:
 *
 *   - `use(app, mw)` registers a response-phase middleware: the
 *     callable takes `(request, response)` and returns the
 *     (possibly transformed) response.
 *
 *   - `before(app, mw)` registers a request-phase middleware: the
 *     callable takes `request` and returns either null (continue
 *     to the next phase / handler) or a response dict (short-
 *     circuit with that response). Auth gates plug in here.
 *
 *   - `after(app, mw)` is an alias of `use` for readability.
 *
 * Middleware factories return ready-to-register callables.
 */

import compress as compressmod;
import crypt;
import http;
import json;
import log;
import secrets;
import store;
import time;
import gebweb.response as respmod;

/**
 * CORS middleware. `opts`:
 *   - "origin" (string): allowed origin. Defaults to "*".
 *   - "methods" (string or list): comma-joined list. Defaults to "GET,POST,PUT,PATCH,DELETE,OPTIONS".
 *   - "headers" (string or list): comma-joined list. Defaults to "Content-Type,Authorization".
 *   - "credentials" (bool): include `Access-Control-Allow-Credentials: true`. Defaults false.
 */
export func cors(dict<string, any> opts): callable {
    string origin = "*";
    string methods = "GET,POST,PUT,PATCH,DELETE,OPTIONS";
    string headers = "Content-Type,Authorization";
    bool credentials = false;

    if (opts.contains("origin")) {
        origin = opts["origin"] as string;
    }
    if (opts.contains("methods")) {
        methods = joinStrings(opts["methods"], ",");
    }
    if (opts.contains("headers")) {
        headers = joinStrings(opts["headers"], ",");
    }
    if (opts.contains("credentials")) {
        credentials = opts["credentials"] as bool;
    }

    return func(any request, any response): any {
        let resp = response
            .withHeader("Access-Control-Allow-Origin", origin)
            .withHeader("Access-Control-Allow-Methods", methods)
            .withHeader("Access-Control-Allow-Headers", headers);
        if (credentials) {
            resp = resp.withHeader("Access-Control-Allow-Credentials", "true");
        }
        return resp;
    };
}

/**
 * A conservative set of browser security headers (X-Content-Type-
 * Options, X-Frame-Options, Referrer-Policy). `opts` accepts an
 * `extra` dict of additional headers to merge in:
 *
 *   gebweb.use(app, mw.securityHeaders({
 *       "extra": {"Strict-Transport-Security": "max-age=31536000"}
 *   }));
 */
export func securityHeaders(dict<string, any> opts): callable {
    dict<string, any> base = {
        "X-Content-Type-Options": "nosniff",
        "X-Frame-Options": "DENY",
        "Referrer-Policy": "strict-origin-when-cross-origin",
    };
    if (opts.contains("extra")) {
        let extra = opts["extra"] as dict<string, any>;
        for (k in extra.keys()) {
            base[k as string] = extra[k as string];
        }
    }
    return func(any request, any response): any {
        let resp = response;
        for (k in base.keys()) {
            resp = resp.withHeader(k as string, base[k as string] as string);
        }
        return resp;
    };
}

/**
 * Request-ID propagation: sets `X-Request-ID` on outgoing
 * responses (or copies it from the request when present).
 */
export func requestId(): callable {
    return func(any request, any response): any {
        string id = (request.header("X-Request-ID") ?? "") as string;
        if (id.isEmpty()) {
            id = secrets.randomHex(16);
        }
        return response.withHeader("X-Request-ID", id);
    };
}

/**
 * Request-phase half of the request-context convention: ensures every
 * request carries a correlation id (inbound X-Request-Id or a fresh
 * one) readable as `req.requestId()`. Wired by
 * `gebweb.useRequestContext(app)` together with the response header.
 */
export func requestContext(): callable {
    return func(any request): any {
        string id = (request.header("X-Request-Id") ?? "") as string;
        if (id.isEmpty()) {
            id = secrets.randomHex(16);
        }
        request["_requestId"] = id;
        return null;
    };
}

/** Response-phase half: echo the correlation id on the response. */
export func requestContextHeader(): callable {
    return func(any request, any response): any {
        string id = (request["_requestId"] ?? "") as string;
        if (id.isEmpty()) {
            return response;
        }
        return response.withHeader("X-Request-Id", id);
    };
}

/**
 * A logger bound to one request's correlation id: every entry carries
 * `requestId` alongside the call's own fields.
 */
export class RequestLogger {
    any logger;
    string requestId;

    func RequestLogger(any logger, string requestId) {
        this.logger = logger;
        this.requestId = requestId;
    }

    func withId(dict<string, any> fields): dict<string, any> {
        dict<string, any> merged = {"requestId": this.requestId};
        for (k in fields.keys()) {
            merged[k as string] = fields[k as string];
        }
        return merged;
    }

    func info(string message, dict<string, any> fields = {}): void {
        log.info(this.logger, message, this.withId(fields));
    }

    func warn(string message, dict<string, any> fields = {}): void {
        log.warn(this.logger, message, this.withId(fields));
    }

    func error(string message, dict<string, any> fields = {}): void {
        log.error(this.logger, message, this.withId(fields));
    }

    func debug(string message, dict<string, any> fields = {}): void {
        log.debug(this.logger, message, this.withId(fields));
    }
}

/** Build a RequestLogger for the given request (see useRequestContext). */
export func requestLogger(any request, any logger = null): RequestLogger {
    string id = "";
    if (request instanceof dict) {
        id = ((request as dict<string, any>)["_requestId"] ?? "") as string;
    } else {
        id = (request["_requestId"] ?? "") as string;
    }
    return RequestLogger(logger, id);
}

/**
 * Request access log: logs method + path + status after each
 * response. Pass `{"logger": <handle>}` to use a custom log
 * handle, otherwise stdout.
 */
export func requestLog(dict<string, any> opts): callable {
    any logger = opts.contains("logger") ? opts["logger"] : null;
    return func(any request, any response): any {
        log.info(logger, "http request", {
            "method": request.method(),
            "path": request.path(),
            "status": response.status()
        });
        return response;
    };
}

/**
 * Gzip response middleware. When the request's `Accept-Encoding`
 * header includes `gzip`, the response body is compressed and a
 * `Content-Encoding: gzip` header is added. Bodies whose
 * Content-Type is already a compressed format (image/*, audio/*,
 * video/*, application/zip, etc.) or smaller than the configured
 * `minBytes` threshold are passed through unchanged.
 *
 * Options:
 *  - "minBytes" (int): skip compression for bodies smaller than
 *    this size in bytes. Defaults to 1024.
 *  - "skipContentTypes" (list<string>): additional Content-Type
 *    prefixes to skip. The built-in skips
 *    image/, audio/, video/, application/zip,
 *    application/gzip, application/octet-stream.
 */
/**
 * Conditional-GET middleware: tags 200 GET/HEAD responses with a weak
 * ETag (content hash) and answers If-None-Match revalidations with an
 * empty 304, cutting repeat-view bandwidth. Register response-phase:
 * `gebweb.use(app, gebweb.etag())`.
 */
export func etag(dict<string, any> opts = {}): callable {
    return func(any request, any response): any {
        string method = (request.method() ?? "GET") as string;
        if (method != "GET" && method != "HEAD") {
            return response;
        }
        if ((response.status() as int) != 200) {
            return response;
        }
        if (response.header("ETag") != null) {
            return response;
        }
        # A streamed file response has no in-memory body; let writeHTTPServeFile derive the size+mtime ETag rather than stamping the empty-body hash.
        if (respmod.isServeFileMarker(response.body())) {
            return response;
        }
        bytes raw = response.bytes() as bytes;
        string tag = "W/\"" + crypt.sha256(raw).slice(0, 32) + "\"";
        string ifNoneMatch = (request.header("If-None-Match") ?? "") as string;
        if (ifNoneMatch == tag) {
            return response.withStatus(304).withBody("").withHeader("ETag", tag);
        }
        return response.withHeader("ETag", tag);
    };
}

export func compress(dict<string, any> opts): callable {
    int minBytes = 1024;
    if (opts.contains("minBytes")) {
        minBytes = opts["minBytes"] as int;
    }
    list<string> skipPrefixes = [
        "image/", "audio/", "video/",
        "application/zip", "application/gzip",
        "application/octet-stream",
    ];
    if (opts.contains("skipContentTypes")) {
        for (entry in opts["skipContentTypes"] as list<any>) {
            if (entry instanceof string) {
                skipPrefixes = skipPrefixes.push(entry as string);
            }
        }
    }
    return func(any request, any response): any {
        string accept = (request.header("Accept-Encoding") ?? "") as string;
        if (accept.indexOf("gzip") < 0) {
            return response;
        }
        string contentType = (response.header("Content-Type") ?? "") as string;
        for (prefix in skipPrefixes) {
            if (contentType.startsWith(prefix)) {
                return response;
            }
        }
        bytes raw = response.bytes() as bytes;
        # An empty body (a streamed serveFile response, 204, a redirect) has nothing to compress; never stamp Content-Encoding on it.
        if (raw.length == 0 || raw.length < minBytes) {
            return response;
        }
        let gzipped = compressmod.gzip(raw);
        return response
            .withBody(gzipped)
            .withHeader("Content-Encoding", "gzip")
            .withHeader("Vary", "Accept-Encoding");
    };
}

/**
 * Token-bucket rate limiter middleware. Tracks one bucket per
 * client key (default: remote address). When the bucket is
 * exhausted the middleware short-circuits with a 429 Too Many
 * Requests response.
 *
 * Options:
 *  - "perSecond" (int): tokens added per second. Defaults to 10.
 *  - "burst" (int): bucket capacity. Defaults to `perSecond * 2`.
 *  - "keyFn" (callable): receives the request, returns the string
 *    key. Defaults to the engine-resolved client IP, which only
 *    honours X-Forwarded-For from peers listed in the server's
 *    trustedProxies option - a direct client cannot spoof its key.
 *  - "message" (string): response body for rejected requests.
 *    Defaults to "rate limit exceeded".
 *
 * Buckets live in process memory, so this is single-instance;
 * production deployments behind a load balancer should use an
 * external limiter (Redis bucket, gateway feature). The
 * implementation deliberately stays in pure Geblang to keep the
 * framework portable.
 */
export func rateLimit(dict<string, any> opts): callable {
    int perSecond = 10;
    if (opts.contains("perSecond")) {
        perSecond = opts["perSecond"] as int;
    }
    int burst = perSecond * 2;
    if (opts.contains("burst")) {
        burst = opts["burst"] as int;
    }
    string message = "rate limit exceeded";
    if (opts.contains("message")) {
        message = opts["message"] as string;
    }
    callable keyFn = func(any request): string {
        string ip = request.clientIp();
        if (!ip.isEmpty()) {
            return ip;
        }
        return "anon";
    };
    if (opts.contains("keyFn")) {
        keyFn = opts["keyFn"] as callable;
    }
    /* Each bucket is a 2-tuple {tokens, lastRefill}. A thread-safe Store
     * holds them so concurrent requests cannot race the shared state, and
     * the refill+consume is one atomic update so two requests cannot both
     * spend the last token. */
    let buckets = store.Store();
    /* A bucket idle long enough to refill fully is indistinguishable
     * from a fresh one, so dropping it is lossless. Sweep lazily every
     * sweepEvery requests to keep memory bounded under key churn. */
    /* perSecond == 0 never refills, so idle buckets stay meaningful
     * and must not be swept. */
    int staleAfterMs = perSecond > 0 ? ((burst // perSecond) + 2) * 1000 : 0;
    int sweepEvery = 1024;
    let sweepCounter = store.Store();
    return func(any request): ?http.Response {
        string key = keyFn(request);
        int now = time.now();
        if (staleAfterMs > 0 && sweepCounter.incr("n") % sweepEvery == 0) {
            sweepStaleBuckets(buckets, now, staleAfterMs);
        }
        /* `time.now()` returns Unix milliseconds; refill = elapsed
         * seconds * perSecond. */
        dict<string, any> result = buckets.update(key, func(any old): any {
            dict<string, any> b = (old == null)
                ? {"tokens": burst, "lastRefill": now}
                : (old as dict<string, any>);
            int last = b["lastRefill"] as int;
            int tokens = b["tokens"] as int;
            int elapsedMs = now - last;
            int refilled = (elapsedMs * perSecond) // 1000;
            if (refilled > 0) {
                tokens = tokens + refilled;
                if (tokens > burst) {
                    tokens = burst;
                }
                last = now;
            }
            bool allowed = tokens > 0;
            if (allowed) {
                tokens = tokens - 1;
            }
            return {"tokens": tokens, "lastRefill": last, "allowed": allowed};
        }) as dict<string, any>;
        if (!(result["allowed"] as bool)) {
            return http.jsonResponse({
                "type": "https://gebweb.dev/errors/rate-limit",
                "title": "Too Many Requests",
                "status": 429,
                "detail": message,
            }, 429)
                .withHeader("Content-Type", "application/problem+json")
                .withHeader("Retry-After", "1");
        }
        return null;
    };
}

/**
 * Wraps a route adapter with a per-route body cap (`@MaxBody(bytes)`).
 * Oversize bodies answer 413 Problem Details without invoking the
 * handler. The app-level cap still applies; a route cap can only
 * tighten it.
 */
export func wrapRouteMaxBody(callable adapter, int maxBytes): callable {
    return func(dict<string, any> request): dict<string, any> {
        let rawBody = request["body"] ?? "";
        if (rawBody instanceof string && (rawBody as string).length() * 4 > maxBytes
                && ((rawBody as string) as bytes).length() > maxBytes) {
            return {
                "status": 413,
                "headers": {"Content-Type": "application/problem+json"},
                "body": json.stringify({
                    "type": "https://gebweb.dev/errors/payload-too-large",
                    "title": "Payload Too Large",
                    "status": 413,
                    "detail": "request body exceeds " + (maxBytes as string) + " bytes",
                }),
            };
        }
        return adapter(request) as dict<string, any>;
    };
}

/**
 * Drops token buckets idle past staleAfterMs. A bucket that idle has
 * fully refilled, so removing it is lossless; this bounds limiter
 * memory under client-key churn.
 */
export func sweepStaleBuckets(store.Store buckets, int now, int staleAfterMs): void {
    for (k in buckets.keys()) {
        let b = buckets.get(k);
        if (b != null && now - ((b as dict<string, any>)["lastRefill"] as int) > staleAfterMs) {
            buckets.delete(k);
        }
    }
}

/**
 * Automatic abuse / bot guard. Detects credential-scanner and exploit probes -
 * requests for paths like `/root/.aws/credentials`, `.git-credentials`,
 * `/wp-admin` - and bans the offending client IP for a TTL, short-circuiting all
 * further requests from it with 403 before they reach routing. Register with
 * `gebweb.before` so banned traffic costs almost nothing.
 *
 * opts:
 *  - "banSeconds" (int, default 3600): how long a banned IP stays blocked.
 *  - "threshold" (int, default 1): probes from an IP before it is banned.
 *  - "badPaths" (list<string>): extra case-insensitive path substrings treated
 *    as probes, merged with the built-in credential/exploit list.
 *  - "allowIps" (list<string>): keys (IPs) that are never banned.
 *  - "message" (string): the 403 detail text.
 *  - "onBan" (callable): called with the key string when a ban is applied.
 *  - "keyFn" (callable): receives the request, returns the identity key to ban
 *    on; default is the client IP. An empty key is never banned.
 *
 * The client IP honours the server's trustedProxies setting, same as rateLimit,
 * so a direct client cannot spoof it.
 */
export func abuseGuard(dict<string, any> opts): callable {
    int banSeconds = opts.contains("banSeconds") ? (opts["banSeconds"] as int) : 3600;
    int threshold = opts.contains("threshold") ? (opts["threshold"] as int) : 1;
    string message = opts.contains("message") ? (opts["message"] as string) : "forbidden";
    any onBan = opts.contains("onBan") ? opts["onBan"] : null;
    callable keyFn = func(any req): string { return req.clientIp(); };
    if (opts.contains("keyFn")) { keyFn = opts["keyFn"] as callable; }

    list<string> badPaths = defaultAbusePaths();
    if (opts.contains("badPaths")) {
        for (p in opts["badPaths"] as list<any>) { badPaths.push((p as string).lower()); }
    }
    let allow = {};
    if (opts.contains("allowIps")) {
        for (ip in opts["allowIps"] as list<any>) { allow[ip as string] = true; }
    }

    let state = store.Store();
    let sweepCounter = store.Store();
    int sweepEvery = 1024;

    return func(any request): ?http.Response {
        string key = keyFn(request);
        if (key.isEmpty() || allow.contains(key)) { return null; }
        int now = time.now();
        if (sweepCounter.incr("n") % sweepEvery == 0) { sweepExpiredAbuse(state, now); }

        let cur = state.get(key);
        if (cur != null && ((cur as dict<string, any>)["banUntil"] as int) > now) {
            return abuseForbidden(message);
        }

        string path = request.path().lower();
        bool probe = false;
        for (pat in badPaths) {
            if (path.contains(pat)) { probe = true; break; }
        }
        if (!probe) { return null; }

        dict<string, any> updated = state.update(key, func(any old): any {
            dict<string, any> s = (old == null) ? {"score": 0, "banUntil": 0} : (old as dict<string, any>);
            int score = (s["score"] as int) + 1;
            int banUntil = s["banUntil"] as int;
            if (score >= threshold) { banUntil = now + banSeconds * 1000; }
            return {"score": score, "banUntil": banUntil};
        }) as dict<string, any>;

        if ((updated["banUntil"] as int) > now) {
            if (onBan != null) { (onBan as callable)(key); }
            return abuseForbidden(message);
        }
        return null;
    };
}

/** Built-in credential-file and exploit-probe path substrings (lowercase). */
func defaultAbusePaths(): list<string> {
    return [
        ".aws/credentials", ".git-credentials", ".s3cfg", ".netrc", ".boto",
        ".npmrc", ".dockercfg", ".pgpass", "id_rsa", "/.ssh/", "/.git/",
        "/.svn/", "/.env", "wp-config.php", "/wp-admin", "/wp-login",
        "/phpmyadmin", "/pma/", "/server-status", "/actuator/", "/cgi-bin/",
        "/etc/passwd", "/proc/self", "/manager/html", "../", "..%2f", "%2e%2e",
    ];
}

/** Drops abuse records whose ban has lapsed, bounding memory under IP churn. */
func sweepExpiredAbuse(store.Store state, int now): void {
    for (k in state.keys()) {
        let s = state.get(k);
        if (s != null && ((s as dict<string, any>)["banUntil"] as int) <= now) {
            state.delete(k);
        }
    }
}

func abuseForbidden(string message): http.Response {
    return http.jsonResponse({
        "type": "https://gebweb.dev/errors/forbidden",
        "title": "Forbidden",
        "status": 403,
        "detail": message,
    }, 403).withHeader("Content-Type", "application/problem+json");
}

func joinStrings(any value, string sep): string {
    if (value instanceof string) {
        return value as string;
    }
    if (value instanceof list) {
        list<any> items = value as list<any>;
        string out = "";
        for (i in 0..<items.length()) {
            if (i > 0) {
                out = out + sep;
            }
            out = out + (items[i] as string);
        }
        return out;
    }
    return "";
}

/**
 * Wraps a route adapter with route-scoped rate limiting. Used by
 * the framework when a handler carries `@RateLimit(perSecond,
 * burst?)`. The state lives in the closure so all requests to the
 * route share one bucket per client key.
 */
export func wrapRouteRateLimit(callable adapter, int perSecond, int burst): callable {
    return wrapRouteRateLimitWithClock(adapter, perSecond, burst, func(): int { return time.now(); });
}

export func wrapRouteRateLimitWithClock(callable adapter, int perSecond, int burst, callable clock): callable {
    int effectiveBurst = burst;
    if (effectiveBurst <= 0) {
        effectiveBurst = perSecond * 2;
    }
    let buckets = store.Store();
    int staleAfterMs = perSecond > 0 ? ((effectiveBurst / perSecond) + 2) * 1000 : 0;
    int sweepEvery = 1024;
    let sweepCounter = store.Store();
    return func(dict<string, any> request): dict<string, any> {
        /* Key on the engine-resolved client IP: it only honours
         * X-Forwarded-For from peers listed in trustedProxies, so a
         * direct client cannot rotate the header to dodge the limit. */
        string key = (request["clientIp"] ?? (request["remoteAddr"] ?? "anon")) as string;
        if (key.isEmpty()) {
            key = "anon";
        }
        int now = clock() as int;
        if (staleAfterMs > 0 && sweepCounter.incr("n") % sweepEvery == 0) {
            sweepStaleBuckets(buckets, now, staleAfterMs);
        }
        /* Refill + consume atomically so concurrent requests to one route
         * cannot both spend the last token. */
        dict<string, any> result = buckets.update(key, func(any old): any {
            dict<string, any> b = (old == null)
                ? {"tokens": effectiveBurst, "lastRefill": now}
                : (old as dict<string, any>);
            int last = b["lastRefill"] as int;
            int tokens = b["tokens"] as int;
            int elapsedMs = now - last;
            int refilled = (elapsedMs * perSecond) // 1000;
            if (refilled > 0) {
                tokens = tokens + refilled;
                if (tokens > effectiveBurst) {
                    tokens = effectiveBurst;
                }
                last = now;
            }
            bool allowed = tokens > 0;
            if (allowed) {
                tokens = tokens - 1;
            }
            return {"tokens": tokens, "lastRefill": last, "allowed": allowed};
        }) as dict<string, any>;
        if (!(result["allowed"] as bool)) {
            return {
                "status": 429,
                "headers": {
                    "Content-Type": "application/problem+json",
                    "Retry-After": "1",
                },
                "body": json.stringify({
                    "type": "https://gebweb.dev/errors/rate-limit",
                    "title": "Too Many Requests",
                    "status": 429,
                    "detail": "rate limit exceeded for this route",
                }),
            };
        }
        return adapter(request) as dict<string, any>;
    };
}

/**
 * Wraps a route adapter with route-scoped CORS. Used by the
 * framework when a handler carries `@Cors({...})`. Adds the
 * standard Access-Control headers to the response and short-
 * circuits preflight OPTIONS requests with 204.
 *
 * The options dict matches the app-level `cors()` middleware:
 * `origin`, `methods`, `headers`, `credentials`.
 */
export func wrapRouteCors(callable adapter, dict<string, any> opts): callable {
    string origin = "*";
    string methods = "GET,POST,PUT,PATCH,DELETE,OPTIONS";
    string allowHeaders = "Content-Type,Authorization";
    bool credentials = false;
    if (opts.contains("origin")) { origin = opts["origin"] as string; }
    if (opts.contains("methods")) { methods = joinStrings(opts["methods"], ","); }
    if (opts.contains("headers")) { allowHeaders = joinStrings(opts["headers"], ","); }
    if (opts.contains("credentials")) { credentials = opts["credentials"] as bool; }
    let addHeaders = func(dict<string, any> headers): dict<string, any> {
        headers["Access-Control-Allow-Origin"] = origin;
        headers["Access-Control-Allow-Methods"] = methods;
        headers["Access-Control-Allow-Headers"] = allowHeaders;
        if (credentials) {
            headers["Access-Control-Allow-Credentials"] = "true";
        }
        return headers;
    };
    return func(dict<string, any> request): dict<string, any> {
        if ((request["method"] as string) == "OPTIONS") {
            return {"status": 204, "headers": addHeaders({} as dict<string, any>), "body": ""};
        }
        let response = adapter(request) as dict<string, any>;
        let existing = (response["headers"] ?? {}) as dict<string, any>;
        response["headers"] = addHeaders(existing);
        return response;
    };
}

/**
 * Wraps a route adapter to mark it deprecated: every response carries a
 * `Deprecation: true` header (RFC 8594), plus a `Sunset: <sunset>` header
 * when a sunset date is given. Used by the framework for routes (or
 * controllers) carrying `@Deprecated`.
 */
export func wrapRouteDeprecation(callable adapter, string sunset): callable {
    return func(dict<string, any> request): dict<string, any> {
        let response = adapter(request) as dict<string, any>;
        dict<string, any> headers = (response["headers"] ?? {}) as dict<string, any>;
        headers["Deprecation"] = "true";
        if (!sunset.isEmpty()) {
            headers["Sunset"] = sunset;
        }
        response["headers"] = headers;
        return response;
    };
}
