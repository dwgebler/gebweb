/**
 * @title Event bus
 * @summary `gebweb.events`: synchronous in-process pub/sub with
 * `@On("name")` subscribers and `gebweb.publish(app, name, payload)`.
 */
import test;
import errors;
import gebweb;
import gebweb.events as evmod;

dict<string, any> _scratch = {"calls": [], "raises": false};

class UserListener {
    @On("user.created")
    func welcome(gebweb.Event ev): void {
        (_scratch["calls"] as list<any>).push(0);
        _scratch["calls"] = (_scratch["calls"] as list<any>).push(("welcome:" + (ev.payload["email"] as string)));
    }

    @On("user.created")
    func audit(gebweb.Event ev): void {
        _scratch["calls"] = (_scratch["calls"] as list<any>).push("audit:" + (ev.payload["email"] as string));
    }

    @On("user.deleted")
    func purge(gebweb.Event ev): void {
        _scratch["calls"] = (_scratch["calls"] as list<any>).push("purge:" + (ev.payload["id"] as string));
    }
}

class FlakyListener {
    @On("user.created")
    func boom(gebweb.Event ev): void {
        if (_scratch["raises"] as bool) {
            throw errors.new("RuntimeError", "boom");
        }
        _scratch["calls"] = (_scratch["calls"] as list<any>).push("flaky-ok");
    }
}

class EventsTest extends test.Test {
    func newApp(): gebweb.GebwebApp {
        _scratch["calls"] = [];
        _scratch["raises"] = false;
        let app = gebweb.app([]);
        gebweb.useEvents(app);
        return app;
    }

    @test
    func registerDiscoversTwoSubscriptions(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener()]);
        let cfg = app.eventConfig as evmod.EventConfig;
        this.assertEquals(2, evmod.subscriberCount(cfg, "user.created"));
        this.assertEquals(1, evmod.subscriberCount(cfg, "user.deleted"));
    }

    @test
    func publishFiresAllSubscribersInOrder(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener()]);
        gebweb.publish(app, "user.created", {"email": "ada@example.com"});
        let calls = _scratch["calls"] as list<any>;
        /* Two subscribers fire (one of them pushes a placeholder
         * before the welcome string). Verify the welcome + audit
         * payloads are both there. */
        this.assertTrue(listContains(calls, "welcome:ada@example.com"));
        this.assertTrue(listContains(calls, "audit:ada@example.com"));
    }

    @test
    func unknownEventIsNoop(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener()]);
        gebweb.publish(app, "no.subscribers", {"x": 1});
        this.assertEquals(0, (_scratch["calls"] as list<any>).length());
    }

    @test
    func multiEventDispatch(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener()]);
        gebweb.publish(app, "user.deleted", {"id": "42"});
        let calls = _scratch["calls"] as list<any>;
        this.assertTrue(listContains(calls, "purge:42"));
    }

    @test
    func subscriberExceptionAggregated(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener(), FlakyListener()]);
        _scratch["raises"] = true;
        this.assertThrows(func(): void {
            gebweb.publish(app, "user.created", {"email": "ada@example.com"});
        });
        /* UserListener.welcome + audit still ran despite Flaky
         * throwing - the failure aggregates and re-throws after
         * the full dispatch. */
        let calls = _scratch["calls"] as list<any>;
        this.assertTrue(listContains(calls, "welcome:ada@example.com"));
        this.assertTrue(listContains(calls, "audit:ada@example.com"));
    }

    @test
    func eventReceivesAppForFollowOnDispatch(): void {
        let app = this.newApp();
        gebweb.registerEventSubscribers(app, [UserListener()]);
        gebweb.publish(app, "user.created", {"email": "x"});
        /* Just verify dispatch completed without error - the
         * app reference is available through Event.app for
         * subscribers that need it. */
        this.assertTrue((_scratch["calls"] as list<any>).length() > 0);
    }
}

func listContains(list<any> items, any needle): bool {
    for (item in items) {
        if (item == needle) { return true; }
    }
    return false;
}
