/**
 * @title @Assert presence/boolean/type/sign/comparison/count/length/date/time/ip/json constraints
 * @summary Tests for notNull, isNull, blank, isTrue, isFalse, type,
 * positive, negative, positiveOrZero, negativeOrZero, greaterThan,
 * greaterThanOrEqual, lessThan, lessThanOrEqual, equalTo, notEqualTo,
 * count, length, date, datetime, time, ip, and json validators.
 */
import test;
import gebweb.validation as validation;

/* ---- test model classes ---- */

class NotNullModel {
    @Assert.notNull
    ?string value;
}

class IsNullModel {
    @Assert.isNull
    ?string value;
}

class BlankModel {
    @Assert.blank
    ?string value;
}

class IsTrueModel {
    @Assert.isTrue
    ?bool value;
}

class IsFalseModel {
    @Assert.isFalse
    ?bool value;
}

class TypeIntModel {
    @Assert.type("int")
    any value;
}

class TypeStringModel {
    @Assert.type("string")
    any value;
}

class TypeListModel {
    @Assert.type("list")
    any value;
}

class TypeDictModel {
    @Assert.type("dict")
    any value;
}

class TypeFloatModel {
    @Assert.type("float")
    any value;
}

class TypeBoolModel {
    @Assert.type("bool")
    any value;
}

class TypeUnknownModel {
    @Assert.type("frobble")
    any value;
}

class PositiveModel {
    @Assert.positive
    ?int value;
}

class NegativeModel {
    @Assert.negative
    ?int value;
}

class PositiveOrZeroModel {
    @Assert.positiveOrZero
    ?int value;
}

class NegativeOrZeroModel {
    @Assert.negativeOrZero
    ?int value;
}

class PositiveDecimalModel {
    @Assert.positive
    ?decimal value;
}

class PositiveStringModel {
    @Assert.positive
    ?string value;
}

class NegativeStringModel {
    @Assert.negative
    ?string value;
}

class GreaterThanModel {
    @Assert.greaterThan(18)
    ?int value;
}

class GreaterThanFloatArgModel {
    @Assert.greaterThan(18.0)
    ?int value;
}

class GreaterThanOrEqualModel {
    @Assert.greaterThanOrEqual(18)
    ?int value;
}

class LessThanModel {
    @Assert.lessThan(100)
    ?int value;
}

class LessThanOrEqualModel {
    @Assert.lessThanOrEqual(100)
    ?int value;
}

class EqualToModel {
    @Assert.equalTo("yes")
    ?string value;
}

class NotEqualToModel {
    @Assert.notEqualTo(0)
    ?int value;
}

class CountModel {
    @Assert.count(1, 3)
    any value;
}

class LengthModel {
    @Assert.length(2, 5)
    ?string value;
}

class DateModel {
    @Assert.date
    ?string value;
}

class DatetimeModel {
    @Assert.datetime
    ?string value;
}

class TimeModel {
    @Assert.time
    ?string value;
}

class IpModel {
    @Assert.ip
    ?string value;
}

class JsonModel {
    @Assert.json
    ?string value;
}

class AnyDateModel {
    @Assert.date
    any value;
}

class AnyJsonModel {
    @Assert.json
    any value;
}

class AnyIpModel {
    @Assert.ip
    any value;
}

class GreaterThanStringModel {
    @Assert.greaterThan(18)
    ?string value;
}

class GreaterThanOrEqualStringModel {
    @Assert.greaterThanOrEqual(18)
    ?string value;
}

class LessThanStringModel {
    @Assert.lessThan(100)
    ?string value;
}

class LessThanOrEqualStringModel {
    @Assert.lessThanOrEqual(100)
    ?string value;
}

class ChoiceModel {
    @Assert.choice(["a", "b", "c"])
    ?string value;
}

class ChoiceVarargsModel {
    @Assert.choice("x", "y", "z")
    ?string value;
}

/* ---- test suite ---- */

class ConstraintsTest extends test.Test {
    validation.AssertionRegistry reg;

    func setUp(): void {
        this.reg = validation.newRegistry();
    }

    /* --- notNull --- */

    @test
    func notNullPassesOnValue(): void {
        let m = NotNullModel();
        m.value = "hello";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func notNullFailsOnNull(): void {
        let m = NotNullModel();
        m.value = null;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("notNull", failures[0].code);
    }

    /* --- isNull --- */

    @test
    func isNullPassesOnNull(): void {
        let m = IsNullModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func isNullFailsOnValue(): void {
        let m = IsNullModel();
        m.value = "something";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("isNull", failures[0].code);
    }

    /* --- blank --- */

    @test
    func blankPassesOnNull(): void {
        let m = BlankModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func blankPassesOnEmptyString(): void {
        let m = BlankModel();
        m.value = "";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func blankPassesOnWhitespace(): void {
        let m = BlankModel();
        m.value = "   ";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func blankFailsOnNonEmpty(): void {
        let m = BlankModel();
        m.value = "hello";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("blank", failures[0].code);
    }

    /* --- isTrue --- */

    @test
    func isTruePassesOnTrue(): void {
        let m = IsTrueModel();
        m.value = true;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func isTrueSkipsNull(): void {
        let m = IsTrueModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func isTrueFailsOnFalse(): void {
        let m = IsTrueModel();
        m.value = false;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("isTrue", failures[0].code);
    }

    /* --- isFalse --- */

    @test
    func isFalsePassesOnFalse(): void {
        let m = IsFalseModel();
        m.value = false;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func isFalseSkipsNull(): void {
        let m = IsFalseModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func isFalseFailsOnTrue(): void {
        let m = IsFalseModel();
        m.value = true;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("isFalse", failures[0].code);
    }

    /* --- type --- */

    @test
    func typeIntPassesOnInt(): void {
        let m = TypeIntModel();
        m.value = 42;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeIntFailsOnString(): void {
        let m = TypeIntModel();
        m.value = "42";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeStringPassesOnString(): void {
        let m = TypeStringModel();
        m.value = "hello";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeStringFailsOnInt(): void {
        let m = TypeStringModel();
        m.value = 1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeListPassesOnList(): void {
        let m = TypeListModel();
        m.value = [1, 2, 3];
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeListFailsOnDict(): void {
        let m = TypeListModel();
        m.value = {"a": 1};
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeDictPassesOnDict(): void {
        let m = TypeDictModel();
        m.value = {"x": 1};
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeDictFailsOnList(): void {
        let m = TypeDictModel();
        m.value = [1];
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeSkipsNull(): void {
        let m = TypeIntModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeFloatPassesOnFloat(): void {
        let m = TypeFloatModel();
        m.value = 3.14f;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeFloatFailsOnInt(): void {
        let m = TypeFloatModel();
        m.value = 42;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeBoolPassesOnBool(): void {
        let m = TypeBoolModel();
        m.value = true;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func typeBoolFailsOnInt(): void {
        let m = TypeBoolModel();
        m.value = 1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
    }

    @test
    func typeUnknownNameErrors(): void {
        let m = TypeUnknownModel();
        m.value = "anything";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("type", failures[0].code);
        this.assertEquals("unknown type name 'frobble' in @Assert.type", failures[0].message);
    }

    /* --- positive --- */

    @test
    func positivePassesOnPositive(): void {
        let m = PositiveModel();
        m.value = 1;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func positiveFailsOnZero(): void {
        let m = PositiveModel();
        m.value = 0;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("positive", failures[0].code);
    }

    @test
    func positiveFailsOnNegative(): void {
        let m = PositiveModel();
        m.value = -1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("positive", failures[0].code);
    }

    @test
    func positiveSkipsNull(): void {
        let m = PositiveModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func positiveWorksOnDecimal(): void {
        let m = PositiveDecimalModel();
        m.value = 0.5;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func positiveFailsOnNonNumeric(): void {
        let m = PositiveStringModel();
        m.value = "hello";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("positive", failures[0].code);
    }

    /* --- negative --- */

    @test
    func negativePassesOnNegative(): void {
        let m = NegativeModel();
        m.value = -1;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func negativeFailsOnZero(): void {
        let m = NegativeModel();
        m.value = 0;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("negative", failures[0].code);
    }

    @test
    func negativeFailsOnPositive(): void {
        let m = NegativeModel();
        m.value = 1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("negative", failures[0].code);
    }

    @test
    func negativeSkipsNull(): void {
        let m = NegativeModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func negativeFailsOnNonNumeric(): void {
        let m = NegativeStringModel();
        m.value = "world";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("negative", failures[0].code);
    }

    /* --- positiveOrZero --- */

    @test
    func positiveOrZeroPassesOnZero(): void {
        let m = PositiveOrZeroModel();
        m.value = 0;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func positiveOrZeroPassesOnPositive(): void {
        let m = PositiveOrZeroModel();
        m.value = 5;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func positiveOrZeroFailsOnNegative(): void {
        let m = PositiveOrZeroModel();
        m.value = -1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("positiveOrZero", failures[0].code);
    }

    @test
    func positiveOrZeroSkipsNull(): void {
        let m = PositiveOrZeroModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    /* --- negativeOrZero --- */

    @test
    func negativeOrZeroPassesOnZero(): void {
        let m = NegativeOrZeroModel();
        m.value = 0;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func negativeOrZeroPassesOnNegative(): void {
        let m = NegativeOrZeroModel();
        m.value = -5;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func negativeOrZeroFailsOnPositive(): void {
        let m = NegativeOrZeroModel();
        m.value = 1;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
