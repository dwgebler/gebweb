    /* --- greaterThan --- */

    @test
    func greaterThanPassesAboveBound(): void {
        let m = GreaterThanModel();
        m.value = 19;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func greaterThanFailsAtBound(): void {
        let m = GreaterThanModel();
        m.value = 18;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("greaterThan", failures[0].code);
    }

    @test
    func greaterThanFailsBelowBound(): void {
        let m = GreaterThanModel();
        m.value = 17;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("greaterThan", failures[0].code);
    }

    @test
    func greaterThanFailsOnNonNumeric(): void {
        let m = GreaterThanStringModel();
        m.value = "hello";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("greaterThan", failures[0].code);
    }

    @test
    func greaterThanSkipsNull(): void {
        let m = GreaterThanModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func greaterThanFloatArgPassesAboveBound(): void {
        let m = GreaterThanFloatArgModel();
        m.value = 19;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func greaterThanFloatArgFailsAtBound(): void {
        let m = GreaterThanFloatArgModel();
        m.value = 18;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("greaterThan", failures[0].code);
    }

