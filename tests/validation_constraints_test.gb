    /* --- lessThan --- */

    @test
    func lessThanPassesBelowBound(): void {
        let m = LessThanModel();
        m.value = 99;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func lessThanFailsAtBound(): void {
        let m = LessThanModel();
        m.value = 100;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("lessThan", failures[0].code);
    }

