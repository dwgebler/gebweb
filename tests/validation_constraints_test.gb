    func equalToSkipsNull(): void {
        let m = EqualToModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    /* --- notEqualTo --- */

    @test
    func notEqualToPassesOnDifferent(): void {
        let m = NotEqualToModel();
        m.value = 1;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func notEqualToFailsOnMatch(): void {
        let m = NotEqualToModel();
        m.value = 0;
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("notEqualTo", failures[0].code);
    }

