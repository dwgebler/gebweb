    /* --- choice --- */

    @test
    func choicePassesOnValidValue(): void {
        let m = ChoiceModel();
        m.value = "b";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func choiceFailsOnInvalidValue(): void {
        let m = ChoiceModel();
        m.value = "z";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("choice", failures[0].code);
        this.assertEquals("must be one of the allowed values", failures[0].message);
    }

    @test
    func choiceSkipsNull(): void {
        let m = ChoiceModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func choiceVarargsWorks(): void {
        let m = ChoiceVarargsModel();
        m.value = "x";
        this.assertEquals(0, validation.validate(this.reg, m).length());
        m.value = "w";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("choice", failures[0].code);
    }
}
