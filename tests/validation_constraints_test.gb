    @test
    func greaterThanOrEqualPassesAtBound(): void {
        let m = GreaterThanOrEqualModel();
        m.value = 18;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func greaterThanOrEqualPassesAboveBound(): void {
        let m = GreaterThanOrEqualModel();
        m.value = 19;
