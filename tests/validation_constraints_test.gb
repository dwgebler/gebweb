    /* --- equalTo --- */

    @test
    func equalToPassesOnMatch(): void {
        let m = EqualToModel();
        m.value = "yes";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func equalToFailsOnMismatch(): void {
        let m = EqualToModel();
        m.value = "no";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("equalTo", failures[0].code);
    }

