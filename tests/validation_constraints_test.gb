    func notEqualToSkipsNull(): void {
        let m = NotEqualToModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    /* --- count --- */

    @test
    func countPassesWithinRange(): void {
        let m = CountModel();
        m.value = [1, 2];
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func countFailsOnEmpty(): void {
        let m = CountModel();
        m.value = [];
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("count", failures[0].code);
    }

    @test
    func countFailsOverMax(): void {
        let m = CountModel();
        m.value = [1, 2, 3, 4];
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("count", failures[0].code);
    }

    @test
    func countFailsOnNonCollection(): void {
        let m = CountModel();
        m.value = "not a list";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("count", failures[0].code);
    }

    @test
    func countSkipsNull(): void {
        let m = CountModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func countPassesOnDict(): void {
        let m = CountModel();
        m.value = {"a": 1, "b": 2};
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func countPassesAtMinBoundary(): void {
        let m = CountModel();
        m.value = [1];
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func countPassesAtMaxBoundary(): void {
        let m = CountModel();
        m.value = [1, 2, 3];
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    /* --- length --- */

    @test
    func lengthPassesWithinRange(): void {
        let m = LengthModel();
        m.value = "abc";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func lengthFailsTooShort(): void {
        let m = LengthModel();
        m.value = "a";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("length", failures[0].code);
    }

    @test
    func lengthFailsTooLong(): void {
        let m = LengthModel();
        m.value = "toolong";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("length", failures[0].code);
    }

    @test
    func lengthSkipsNull(): void {
        let m = LengthModel();
        m.value = null;
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func lengthPassesAtMinBoundary(): void {
        let m = LengthModel();
        m.value = "ab";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func lengthPassesAtMaxBoundary(): void {
        let m = LengthModel();
        m.value = "abcde";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    /* --- date --- */

    @test
    func datePassesOnValidDate(): void {
        let m = DateModel();
        m.value = "2026-06-25";
        this.assertEquals(0, validation.validate(this.reg, m).length());
    }

    @test
    func dateFailsOnBadCalendarDate(): void {
        let m = DateModel();
        m.value = "2026-13-45";
        let failures = validation.validate(this.reg, m);
        this.assertEquals(1, failures.length());
        this.assertEquals("value", failures[0].field);
        this.assertEquals("date", failures[0].code);
    }

