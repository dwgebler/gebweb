/**
 * @title Cache tags + invalidation
 * @summary `@Cache(tags: ["user:{id}"])` records each cached
 * response under its resolved tags; `gebweb.cacheInvalidate(app,
 * "user:42")` drops every entry carrying the tag.
 */
import test;
import gebweb;
import io;
import web.cache as cachemod;
import gebweb.cache as gwcache;
import async.tasks as tasks;

class UserController {
    int calls;

    func UserController() {
        this.calls = 0;
    }

    @Get("/users/{id}")
    @Cache(ttl: 300, tags: ["user:{id}", "users"])
    func show(@PathParam("id") string id): dict<string, any> {
        this.calls = this.calls + 1;
        return {"id": id, "calls": this.calls};
    }
}

class CacheTagsTest extends test.Test {
    string cacheDir;
    UserController controller;
    gebweb.GebwebApp app;
    gebweb.TestClient client;

    func setUp(): void {
        this.cacheDir = io.tempDir("gebweb-tags-*");
        this.controller = UserController();
        this.app = gebweb.app([this.controller]);
        gebweb.useCacheStore(this.app, cachemod.fileCacheStore(this.cacheDir, 3600));
        this.client = gebweb.TestClient(this.app);
    }

    func tearDown(): void {
        if (this.cacheDir != null && (this.cacheDir as string).length() > 0) {
            for (name in io.listDir(this.cacheDir)) {
                io.remove(this.cacheDir + "/" + (name as string));
            }
            io.remove(this.cacheDir);
        }
    }

    @test
    func invalidatingATagDropsOnlyItsEntries(): void {
        this.client.get("/users/1");
        this.client.get("/users/2");
        this.assertEquals(2, this.controller.calls);
        /* Both now served from cache. */
        this.client.get("/users/1");
        this.client.get("/users/2");
        this.assertEquals(2, this.controller.calls);
        int dropped = gebweb.cacheInvalidate(this.app, "user:1");
        this.assertEquals(1, dropped);
        /* User 1 re-runs the handler; user 2 still cached. */
        this.client.get("/users/1");
        this.assertEquals(3, this.controller.calls);
        this.client.get("/users/2");
        this.assertEquals(3, this.controller.calls);
    }

    @test
    func sharedTagDropsAllEntries(): void {
        this.client.get("/users/1");
        this.client.get("/users/2");
        int dropped = gebweb.cacheInvalidate(this.app, "users");
        this.assertEquals(2, dropped);
        this.client.get("/users/1");
        this.client.get("/users/2");
        this.assertEquals(4, this.controller.calls);
    }

    @test
    func unknownTagIsANoOp(): void {
        this.assertEquals(0, gebweb.cacheInvalidate(this.app, "nope"));
    }

    /* Concurrent cold misses under one tag must not drop index entries: the tag index set-add is atomic. */
    @test
    func concurrentTagIndexingKeepsEveryEntry(): void {
        let cfg = gwcache.CacheConfig(cachemod.memoryCacheStore(300));
        let keys = [];
        for (int i = 0; i < 50; i++) { keys = keys.push("k" + (i as string)); }
        tasks.map(keys, func(string k): bool {
            gwcache.indexTags(cfg, ["site"], k);
            return true;
        }, {"concurrency": 8});
        let indexed = cfg.tagIndex.get("gebweb-tag|site") as list<any>;
        this.assertEquals(50, indexed.length());
    }

    /* invalidateTag swaps the index atomically: it drops exactly the tagged entries and leaves a clean, re-indexable state. */
    @test
    func invalidateClearsAtomicallyAndReindexes(): void {
        let cfg = gwcache.CacheConfig(cachemod.memoryCacheStore(300));
        cfg.store.set("a", {"v": 1});
        cfg.store.set("b", {"v": 2});
        gwcache.indexTags(cfg, ["site"], "a");
        gwcache.indexTags(cfg, ["site"], "b");
        this.assertEquals(2, gwcache.invalidateTag(cfg, "site"));
        this.assertFalse(cfg.store.has("a"));
        this.assertFalse(cfg.store.has("b"));
        cfg.store.set("c", {"v": 3});
        gwcache.indexTags(cfg, ["site"], "c");
        let idx = cfg.tagIndex.get("gebweb-tag|site") as list<any>;
        this.assertEquals(1, idx.length());
        this.assertEquals(1, gwcache.invalidateTag(cfg, "site"));
    }

    /* Concurrent indexTags interleaved with invalidateTag never orphans an entry: anything still in the store remains reachable via its tag index (the previous get-then-delete could wipe a freshly-added pointer). */
    @test
    func concurrentInvalidateLeavesNoOrphan(): void {
        let cfg = gwcache.CacheConfig(cachemod.memoryCacheStore(300));
        let ops = [];
        for (int i = 0; i < 60; i++) {
            if (i % 12 == 5) { ops = ops.push("inv"); }
            else { ops = ops.push("add:" + (i as string)); }
        }
        tasks.map(ops, func(string op): bool {
            if (op == "inv") {
                gwcache.invalidateTag(cfg, "site");
            } else {
                cfg.store.set(op, {"v": 1});
                gwcache.indexTags(cfg, ["site"], op);
            }
            return true;
        }, {"concurrency": 8});
        let idx = cfg.tagIndex.get("gebweb-tag|site");
        let indexed = (idx != null && idx instanceof list) ? (idx as list<any>) : [];
        let indexedSet = {};
        for (k in indexed) { indexedSet[k as string] = true; }
        for (int i = 0; i < 60; i++) {
            if (i % 12 == 5) { continue; }
            string k = "add:" + (i as string);
            if (cfg.store.has(k)) {
                this.assertTrue((indexedSet[k] ?? false) as bool);
            }
        }
    }
}
