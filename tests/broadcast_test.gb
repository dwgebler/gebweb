/**
 * @title Broadcast Hub
 * @summary Pins gebweb.broadcast.Hub: join/leave/broadcast/
 * broadcastExcept/size against a fake connection class. Exercises
 * the same Hub API the chat demo uses.
 */
import test;
import gebweb.broadcast as bcast;
import async;
import async.sync as sync;

class FakeConn {
    string label;
    list<string> received;
    func FakeConn(string label) {
        this.label = label;
        this.received = [];
    }
    func sendText(string msg): void {
        this.received = this.received.push(msg);
    }
}

class BroadcastHubTest extends test.Test {
    @test
    func broadcastReachesEveryJoinedConnection(): void {
        let hub = bcast.newHub();
        let a = FakeConn("a");
        let b = FakeConn("b");
        hub.join(a);
        hub.join(b);
        let sent = hub.broadcast("hello");
        this.assertEquals(2, sent);
        this.assertEquals(1, a.received.length());
        this.assertEquals("hello", a.received[0]);
        this.assertEquals("hello", b.received[0]);
    }

    @test
    func broadcastExceptSkipsExcludedSubscriber(): void {
        let hub = bcast.newHub();
        let a = FakeConn("a");
        let b = FakeConn("b");
        let c = FakeConn("c");
        let subA = hub.join(a);
        hub.join(b);
        hub.join(c);
        let sent = hub.broadcastExcept("private", subA);
        this.assertEquals(2, sent);
        this.assertEquals(0, a.received.length());
        this.assertEquals("private", b.received[0]);
        this.assertEquals("private", c.received[0]);
    }

    @test
    func leaveRemovesSubscriberFromFutureBroadcasts(): void {
        let hub = bcast.newHub();
        let a = FakeConn("a");
        let b = FakeConn("b");
        let subA = hub.join(a);
        hub.join(b);
        hub.broadcast("first");
        hub.leave(subA);
        this.assertEquals(1, hub.size());
        hub.broadcast("second");
        this.assertEquals(1, a.received.length());
        this.assertEquals(2, b.received.length());
        this.assertEquals("second", b.received[1]);
    }

    @test
    func sizeTracksSubscriberCount(): void {
        let hub = bcast.newHub();
        this.assertEquals(0, hub.size());
        let subA = hub.join(FakeConn("a"));
        let subB = hub.join(FakeConn("b"));
        this.assertEquals(2, hub.size());
        hub.leave(subA);
        this.assertEquals(1, hub.size());
        hub.leave(subB);
        this.assertEquals(0, hub.size());
    }

    @test
    func concurrentMembershipIsRaceFree(): void {
        /* Many handlers join, query size, and leave at once. The hub's
         * mutex serialises these so the shared subscriber set stays
         * consistent and the interpreter never trips a field-access race. */
        let hub = bcast.newHub();
        let wg = sync.WaitGroup();
        for (let int i = 0; i < 30; i++) {
            wg.add(1);
            async.run(func(): void {
                let sub = hub.join(FakeConn("c"));
                let n = hub.size();
                hub.leave(sub);
                wg.done();
            });
        }
        wg.wait();
        this.assertEquals(0, hub.size());
    }
}
