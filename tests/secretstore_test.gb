/**
 * @title Gebweb secrets: SecretsProvider + EncryptedFileSecretsProvider
 * @summary useSecrets registers a provider. %secret(...)% markers in
 * YAML parameters resolve through it. The built-in encrypted-file
 * provider round-trips through encryptSecrets, the file format is
 * PEM-style ASCII (base64, 80-col chunked), the key is read from
 * GEBWEB_SECRETS_KEY or config/secrets.key, and tampering throws.
 */
import test;
import io;
import path;
import sys;
import crypt;
import bytes;
import secrets;
import gebweb;
import gebweb.secretstore as secrets_mod;

func newKey(): bytes {
    return secrets.randomBytes(32);
}

func writeYaml(string dir, string name, string content): string {
    let p = path.join(dir, name);
    io.writeText(p, content);
    return p;
}

class InMemoryProvider implements gebweb.SecretsProvider {
    dict<string, string> values;

    func InMemoryProvider(dict<string, string> values) {
        this.values = values;
    }

    func getSecret(string name): string {
        if (!this.values.contains(name)) {
            throw RuntimeError("missing secret: " + name);
        }
        return this.values[name];
    }

    func hasSecret(string name): bool {
        return this.values.contains(name);
    }
}

class SecretStoreTest extends test.Test {
    @test
    func encryptedFileRoundTrip(): void {
        let key = newKey();
        let dir = io.tempDir("gebweb-sec-");
        let body = gebweb.encryptSecrets({"api.key": "abc-123"}, key);
        let secretsFile = path.join(dir, "secrets.enc");
        io.writeText(secretsFile, body);

        let provider = secrets_mod.EncryptedFileSecretsProvider(secretsFile, key);
        this.assertEquals("abc-123", provider.getSecret("api.key"));
        this.assertTrue(provider.hasSecret("api.key"));
        this.assertFalse(provider.hasSecret("missing"));
    }

    @test
    func bodyIsPemStyleAsciiChunkedAt80(): void {
        let key = newKey();
        let body = gebweb.encryptSecrets({"a": "x", "b": "y"}, key);
        this.assertTrue(body.startsWith("-----BEGIN GEBWEB SECRETS-----\n"));
        this.assertTrue(body.contains("-----END GEBWEB SECRETS-----"));
        for (line in body.split("\n")) {
            this.assertTrue(line.length() <= 80);
        }
    }

    @test
    func unknownSecretThrowsOnRead(): void {
        let key = newKey();
        let dir = io.tempDir("gebweb-sec-");
        let body = gebweb.encryptSecrets({"present": "yes"}, key);
        let secretsFile = path.join(dir, "secrets.enc");
        io.writeText(secretsFile, body);
        let provider = secrets_mod.EncryptedFileSecretsProvider(secretsFile, key);
        bool threw = false;
        try {
            provider.getSecret("absent");
        } catch (RuntimeError e) {
            threw = true;
            this.assertTrue((e.message as string).indexOf("absent") >= 0);
        }
        this.assertTrue(threw);
    }

    @test
    func wrongKeyFailsAuthentication(): void {
        let key = newKey();
        let wrongKey = newKey();
        let dir = io.tempDir("gebweb-sec-");
        let body = gebweb.encryptSecrets({"x": "y"}, key);
        let secretsFile = path.join(dir, "secrets.enc");
        io.writeText(secretsFile, body);
        let provider = secrets_mod.EncryptedFileSecretsProvider(secretsFile, wrongKey);
        bool threw = false;
        try {
            provider.getSecret("x");
        } catch (RuntimeError e) { threw = true; }
        this.assertTrue(threw);
    }

    @test
    func tamperedCiphertextFailsAuthentication(): void {
        let key = newKey();
        let dir = io.tempDir("gebweb-sec-");
        let body = gebweb.encryptSecrets({"x": "y"}, key);
        /* Flip a byte inside the base64 payload (find a non-marker
         * line and mutate one character of it). */
        let lines = body.split("\n");
        list<string> mutated = [];
        bool patched = false;
        for (line in lines) {
            if (!patched && !line.startsWith("-----") && line.length() > 2) {
                let head = line.substring(0, 1);
                let flipped = head == "A" ? "B" : "A";
                mutated = mutated.push(flipped + line.substring(1, line.length()));
                patched = true;
            } else {
                mutated = mutated.push(line);
            }
        }
        let tampered = mutated.join("\n");
        let secretsFile = path.join(dir, "secrets.enc");
        io.writeText(secretsFile, tampered);
        let provider = secrets_mod.EncryptedFileSecretsProvider(secretsFile, key);
        bool threw = false;
        try {
            provider.getSecret("x");
        } catch (RuntimeError e) { threw = true; }
        this.assertTrue(threw);
    }

    @test
    func missingFileThrowsClearly(): void {
        let key = newKey();
        let provider = secrets_mod.EncryptedFileSecretsProvider("/nonexistent/secrets.enc", key);
        bool threw = false;
        try {
            provider.getSecret("x");
        } catch (RuntimeError e) {
            threw = true;
            this.assertTrue((e.message as string).indexOf("not found") >= 0);
        }
        this.assertTrue(threw);
    }

    @test
    func wrongKeyLengthRejected(): void {
        bool threw = false;
        string msg = "";
        try {
            secrets_mod.EncryptedFileSecretsProvider("dummy.enc", secrets.randomBytes(16));
        } catch (RuntimeError e) {
            threw = true;
            msg = e.message as string;
        }
        this.assertTrue(threw);
        this.assertTrue(msg.indexOf("32") >= 0);
    }

    @test
    func loadKeyPrefersEnvVar(): void {
        let key = newKey();
        let encoded = bytes.toBase64(key);
        sys.setenv("GEBWEB_SECRETS_KEY", encoded);
        let loaded = secrets_mod.loadKey("");
        this.assertEquals(encoded, bytes.toBase64(loaded));
        sys.setenv("GEBWEB_SECRETS_KEY", "");
    }

    @test
    func loadKeyFallsBackToFile(): void {
        let key = newKey();
        let dir = io.tempDir("gebweb-sec-");
        let keyFile = path.join(dir, "secrets.key");
        io.writeText(keyFile, bytes.toBase64(key));
        sys.setenv("GEBWEB_SECRETS_KEY", "");
        let loaded = secrets_mod.loadKey(keyFile);
        this.assertEquals(bytes.toBase64(key), bytes.toBase64(loaded));
    }

    @test
    func loadKeyMissingThrows(): void {
        sys.setenv("GEBWEB_SECRETS_KEY", "");
        bool threw = false;
        try {
            secrets_mod.loadKey("/nonexistent/secrets.key");
        } catch (RuntimeError e) {
            threw = true;
            this.assertTrue((e.message as string).indexOf("GEBWEB_SECRETS_KEY") >= 0);
        }
        this.assertTrue(threw);
    }

    @test
    func useSecretsRegistersProvider(): void {
        let app = gebweb.app([]);
        let p = InMemoryProvider({"stripe.key": "sk_test_xyz"});
        gebweb.useSecrets(app, p);
        let resolved = gebweb.secrets(app);
        this.assertNotNull(resolved);
        this.assertEquals("sk_test_xyz", (resolved as gebweb.SecretsProvider).getSecret("stripe.key"));
    }

    @test
    func yamlSecretMarkerResolvesThroughProvider(): void {
        let dir = io.tempDir("gebweb-sec-");
        let yamlPath = writeYaml(dir, "services.yaml",
            "parameters:\n" +
            "  api.key: \"%secret(stripe.key)%\"\n" +
            "  greeting: \"key is %secret(stripe.key)% today\"\n");
        let app = gebweb.app([]);
        gebweb.useSecrets(app, InMemoryProvider({"stripe.key": "sk_test_123"}));
        gebweb.loadConfig(app, yamlPath);
        this.assertEquals("sk_test_123", gebweb.getParameter(app, "api.key") as string);
        this.assertEquals("key is sk_test_123 today", gebweb.getParameter(app, "greeting") as string);
    }

    @test
    func yamlSecretMarkerThrowsWhenProviderMissing(): void {
        let dir = io.tempDir("gebweb-sec-");
        let yamlPath = writeYaml(dir, "services.yaml",
            "parameters:\n" +
            "  api.key: \"%secret(stripe.key)%\"\n");
        let app = gebweb.app([]);
        gebweb.loadConfig(app, yamlPath);
        bool threw = false;
        try {
            gebweb.getParameter(app, "api.key");
        } catch (RuntimeError e) {
            threw = true;
            this.assertTrue((e.message as string).indexOf("useSecrets") >= 0);
        }
        this.assertTrue(threw);
    }
}
