/**
 * @title Gebweb CSRF protection
 * @summary useCsrf(app, opts) + @CsrfExempt + token cookie round-trip.
 */
import test;
import gebweb;

class FormController {
    @Get("/form")
    func form(): dict<string, any> {
        return {"status": 200, "body": "form", "headers": {"Content-Type": "text/html"}};
    }

    @Post("/form")
    func submit(): dict<string, any> {
        return {"status": 200, "body": "submitted"};
    }

    @Post("/webhook")
    @CsrfExempt
    func webhook(): dict<string, any> {
        return {"status": 200, "body": "webhook"};
    }
}

class CsrfTest extends test.Test {
    func makeApp(): any {
        let app = gebweb.app([FormController()]);
        return gebweb.useCsrf(app, {"secret": "test-secret-32bytes-AAAAAAAAAA"});
    }

    @test
    func getSetsTokenCookie(): void {
        let app = this.makeApp();
        let client = gebweb.TestClient(app);
        let r = client.get("/form");
        r.assertStatus(200);
        let setCookie = r.headers.contains("Set-Cookie") ? r.headers["Set-Cookie"] : null;
        this.assertTrue(setCookie != null);
    }

    @test
    func postWithoutTokenIsRejected(): void {
        let app = this.makeApp();
        let client = gebweb.TestClient(app);
        let r = client.post("/form", "");
        r.assertStatus(403);
    }

    @test
    func csrfExemptRouteAcceptsPostWithoutToken(): void {
        let app = this.makeApp();
        let client = gebweb.TestClient(app);
        let r = client.post("/webhook", "");
        r.assertStatus(200);
    }

    @test
    func postWithMatchingTokenSucceeds(): void {
        let app = this.makeApp();
        let client = gebweb.TestClient(app);
        let r1 = client.get("/form");
        let setCookie = r1.headers["Set-Cookie"];
        string cookieHeader = "";
        if (setCookie instanceof list) {
            for (entry in setCookie as list<any>) {
                let parts = (entry as string).split(";");
                if (parts[0].startsWith("geb_csrf=")) {
                    cookieHeader = parts[0] as string;
                }
            }
        } else {
            let raw = setCookie as string;
            let firstSemi = raw.indexOf(";");
            cookieHeader = firstSemi >= 0 ? raw.substring(0, firstSemi) : raw;
        }
        let token = cookieHeader.substring("geb_csrf=".length());

        let r2 = client.request("POST", "/form", "", {
            "Cookie": "geb_csrf=" + token,
            "X-CSRF-Token": token
        });
        r2.assertStatus(200);
    }

    @test
    func unenabledAppPassesPostThrough(): void {
        /* useCsrf NOT called - default behaviour is unchanged. */
        let app = gebweb.app([FormController()]);
        let client = gebweb.TestClient(app);
        let r = client.post("/form", "");
        r.assertStatus(200);
    }

    @test
    func customCookieNameRoundTrip(): void {
        /* Regression guard: a custom cookieName must be honoured by
           validation too. Before the fix verifyCsrf hardcoded
           "geb_csrf", so a custom name made every unsafe request 403. */
        let app = gebweb.app([FormController()]);
        app = gebweb.useCsrf(app, {
            "secret": "test-secret-32bytes-AAAAAAAAAA",
            "cookieName": "my_csrf"
        });
        let client = gebweb.TestClient(app);
        let r1 = client.get("/form");
        let setCookie = r1.headers["Set-Cookie"];
        string cookieHeader = "";
        if (setCookie instanceof list) {
            for (entry in setCookie as list<any>) {
                let parts = (entry as string).split(";");
                if (parts[0].startsWith("my_csrf=")) {
                    cookieHeader = parts[0] as string;
                }
            }
        } else {
            let raw = setCookie as string;
            let firstSemi = raw.indexOf(";");
            cookieHeader = firstSemi >= 0 ? raw.substring(0, firstSemi) : raw;
        }
        let token = cookieHeader.substring("my_csrf=".length());
        let r2 = client.request("POST", "/form", "", {
            "Cookie": "my_csrf=" + token,
            "X-CSRF-Token": token
        });
        r2.assertStatus(200);
    }

    func tokenFrom(any setCookie, string name): string {
        let entries = setCookie instanceof list ? setCookie as list<any> : [setCookie];
        for (entry in entries) {
            let first = (entry as string).split(";")[0] as string;
            if (first.startsWith(name + "=")) {
                return first.substring(name.length() + 1);
            }
        }
        return "";
    }

    @test
    func existingTokenIsReusedAcrossRequests(): void {
        /* Regression guard: the wrapper read request["cookies"], which is never populated, so
           every request minted a new token and a page's token went stale after one more request. */
        let app = this.makeApp();
        let client = gebweb.TestClient(app);
        let token = this.tokenFrom(client.get("/form").headers["Set-Cookie"], "geb_csrf");
        this.assertNotEmpty(token);
        let again = client.request("GET", "/form", "", {"Cookie": "geb_csrf=" + token});
        again.assertStatus(200);
        this.assertFalse(again.headers.contains("Set-Cookie"));
        let post = client.request("POST", "/form", "", {
            "Cookie": "other=1; geb_csrf=" + token,
            "X-CSRF-Token": token
        });
        post.assertStatus(200);
    }
}
