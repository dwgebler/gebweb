/**
 * @title Cursor pagination
 * @summary `Cursor` + `CursorPage<T>` + `encodeCursor` /
 * `decodeCursor` give repositories a keyset-pagination shape
 * alongside the existing offset-based `Page<T>`. Cursors are
 * opaque base64-encoded strings.
 */
import test;
import gebweb.repository as repo;
import gebweb.errors as errs;

class CursorPaginationTest extends test.Test {
    @test
    func roundTripCursor(): void {
        let token = repo.encodeCursor("user:42");
        this.assertEquals("user:42", repo.decodeCursor(token));
    }

    @test
    func decodeEmptyCursorReturnsEmpty(): void {
        this.assertEquals("", repo.decodeCursor(""));
    }

    @test
    func cursorFromQueryParsesValues(): void {
        let c = repo.cursorFromQuery({"after": "abc", "limit": "50", "sort": "id"});
        this.assertEquals("abc", c.after);
        this.assertEquals(50, c.size);
        this.assertEquals("id", c.sort);
    }

    @test
    func cursorFromQueryUsesDefaults(): void {
        let c = repo.cursorFromQuery({} as dict<string, string>);
        this.assertEquals("", c.after);
        this.assertEquals(25, c.size);
    }

    @test
    func cursorPageCarriesItemsAndNext(): void {
        let page = repo.CursorPage<string>(["a", "b", "c"], repo.encodeCursor("c"));
        this.assertEquals(3, page.items.length());
        this.assertNotNull(page.nextCursor);
        let last = repo.CursorPage<string>([] as list<string>, null);
        this.assertNull(last.nextCursor);
    }

    func assertBadRequest(callable parse, string detail): void {
        try {
            parse();
            this.fail("expected BadRequestError");
        } catch (errs.BadRequestError e) {
            this.assertEquals(400, e.status);
            this.assertEquals(detail, e.detail);
        }
    }

    @test
    func limitMustBeWithinOneAndMaxPageSize(): void {
        this.assertEquals(100, repo.MAX_PAGE_SIZE);
        this.assertEquals(1, repo.cursorFromQuery({"limit": "1"}).size);
        this.assertEquals(100, repo.cursorFromQuery({"limit": "100"}).size);
        this.assertEquals(100, repo.pageFromQuery({"limit": "100"}).size);
        let tooLarge = "Query parameter 'limit' must be between 1 and 100";
        this.assertBadRequest(func(): void { repo.cursorFromQuery({"limit": "101"}); }, tooLarge);
        this.assertBadRequest(func(): void { repo.cursorFromQuery({"limit": "0"}); }, tooLarge);
        this.assertBadRequest(func(): void { repo.pageFromQuery({"limit": "-5"}); }, tooLarge);
        this.assertBadRequest(func(): void { repo.pageFromQuery({"limit": "1000000"}); }, tooLarge);
    }

    @test
    func offsetMustNotBeNegative(): void {
        this.assertEquals(0, repo.pageFromQuery({"offset": "0"}).offset);
        this.assertBadRequest(
            func(): void { repo.pageFromQuery({"offset": "-1"}); },
            "Query parameter 'offset' must not be negative"
        );
    }
}
