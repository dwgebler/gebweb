/**
 * @title Gebweb asset pipeline
 * @summary useStaticAssets + asset() view helper + content-hash URLs.
 */
import test;
import gebweb;
import gebweb.assets as assets;

any gebwebApp;

class StaticController {
    @Get("/page")
    func page(dict<string, any> request): dict<string, any> {
        return gebweb.htmlView(gebwebApp, request, "asset.html", {});
    }
}

class AssetsTest extends test.Test {
    gebweb.TestClient client;

    func setUp(): void {
        let app = gebweb.app([StaticController()]);
        gebweb.useViews(app, "tests/fixtures/views");
        gebweb.useStaticAssets(app, "tests/fixtures/assets", {});
        gebwebApp = app;
        this.client = gebweb.TestClient(app);
    }

    @test
    func assetUrlHasContentHash(): void {
        let r = this.client.get("/page");
        r.assertStatus(200);
        let body = r.text() as string;
        /* `app-XXXXXXXX.css` - eight-char hash. */
        this.assertTrue(body.contains("/assets/app-"));
        this.assertTrue(body.contains(".css"));
    }

    @test
    func assetRejectsNonGetWithMethodNotAllowed(): void {
        let cfg = assets.AssetConfig("tests/fixtures/assets", {"dev": true});
        let r = assets.serveAsset(cfg, {"method": "POST", "path": "/assets/app.css"});
        this.assertEquals(405, r["status"] as int);
    }

    @test
    func devAssetUrlIsLogicalNotFingerprinted(): void {
        let cfg = assets.AssetConfig("tests/fixtures/assets", {"dev": true});
        this.assertEquals("/assets/app.css", assets.assetUrl(cfg, "app.css"));
    }

    @test
    func devServingRejectsTraversal(): void {
        let cfg = assets.AssetConfig("tests/fixtures/assets", {"dev": true});
        let r = assets.serveAsset(cfg, {"method": "GET", "path": "/assets/../site_config.gb"});
        this.assertEquals(404, r["status"] as int);
    }

    @test
    func unfingerprintedProdServesLogicalName(): void {
        let cfg = assets.newConfig("tests/fixtures/assets", {"fingerprint": false});
        this.assertEquals("/assets/app.css", assets.assetUrl(cfg, "app.css"));
        let r = assets.serveAsset(cfg, {"method": "GET", "path": "/assets/app.css"});
        this.assertEquals(200, r["status"] as int);
    }

    @test
    func unfingerprintedProdRejectsTraversal(): void {
        let cfg = assets.newConfig("tests/fixtures/assets", {"fingerprint": false});
        let r = assets.serveAsset(cfg, {"method": "GET", "path": "/assets/../site_config.gb"});
        this.assertEquals(404, r["status"] as int);
    }

    @test
    func subdirAssetWorks(): void {
        let r = this.client.get("/page");
        let body = r.text() as string;
        this.assertTrue(body.contains("/assets/img/logo-"));
        this.assertTrue(body.contains(".svg"));
    }

    @test
    func servesFingerprintedFile(): void {
        let r1 = this.client.get("/page");
        let body = r1.text() as string;
        let start = body.indexOf("/assets/app-");
        let tail = body.substring(start);
        let end = start + tail.indexOf("\"");
        let url = body.substring(start, end);
        let r2 = this.client.get(url);
        r2.assertStatus(200);
        this.assertEquals("text/css", r2.headers["Content-Type"]);
        this.assertTrue((r2.text() as string).contains("navy"));
    }

    @test
    func unknownAssetIs404(): void {
        let r = this.client.get("/assets/missing.css");
        r.assertStatus(404);
    }

    /* Prod manifest is fingerprinted eagerly at setup, before any assetUrl/render, so it is read-only during serving. */
    @test
    func manifestBuiltEagerlyAtSetup(): void {
        let cfg = assets.newConfig("tests/fixtures/assets", {});
        this.assertTrue(cfg.manifest.contains("app.css"));
        this.assertTrue(cfg.manifest.contains("img/logo.svg"));
    }

    /* Dev mode stays lazy: the manifest is empty until the first lookup. */
    @test
    func devManifestStaysLazy(): void {
        let cfg = assets.newConfig("tests/fixtures/assets", {"dev": true});
        this.assertEquals(0, cfg.manifest.length());
    }

    @test
    func longCacheHeaderEmitted(): void {
        let r1 = this.client.get("/page");
        let body = r1.text() as string;
        let start = body.indexOf("/assets/app-");
        let tail = body.substring(start);
        let end = start + tail.indexOf("\"");
        let url = body.substring(start, end);
        let r2 = this.client.get(url);
        let cc = r2.headers["Cache-Control"] as string;
        this.assertTrue(cc.contains("immutable"));
        this.assertTrue(cc.contains("max-age"));
    }
}
